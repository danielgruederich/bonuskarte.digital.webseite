---
import BaseLayout from '../layouts/BaseLayout.astro'
---
<BaseLayout title="Seite nicht gefunden | bonuskarte.digital" description="Diese Seite existiert nicht.">
  <div class="min-h-screen bg-paper flex items-center justify-center px-5">
    <div class="text-center">
      <p class="text-amber text-[10px] tracking-[0.4em] uppercase mb-6">404</p>
      <h1 class="text-4xl font-normal text-ink mb-2">Seite nicht</h1>
      <h1 class="text-4xl font-bold text-ink mb-6">gefunden.</h1>
      <p class="text-ink/55 text-sm mb-10 tracking-wide">Aber deine digitale Stempelkarte bald!</p>
      <a href="/" class="inline-flex items-center gap-3 bg-amber hover:bg-amber-dark text-black px-8 py-4 text-xs font-bold tracking-[0.2em] uppercase transition-all">
        Zur Startseite
      </a>
    </div>
  </div>
</BaseLayout>
