---
import BaseLayout from '../layouts/BaseLayout.astro'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'
import EbookSection from '../components/EbookSection.astro'
---

<BaseLayout
  title="Gratis E-Book: Mehr Stammkunden für Kölner Cafés | bonuskarte.digital"
  description="Kostenloser Leitfaden für Café-Betreiber: 8 digitale Kartentypen, mit denen du Stammkunden bindest – ohne großes Marketingbudget. Jetzt gratis als PDF herunterladen."
  ogImage="/images/leitfaden-cover.png"
>
  <Navbar ctaHref="#leitfaden" ctaLabel="Gratis-Leitfaden" />

  <!-- ── HERO ─────────────────────────────────────────────────── -->
  <section class="relative bg-paper overflow-hidden pt-32 pb-12 px-5 sm:px-8">
    <div class="absolute inset-0 bg-grid-ink"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[400px] bg-amber rounded-full blur-[200px] opacity-5 pointer-events-none"></div>

    <div class="relative max-w-3xl mx-auto text-center">
      <div class="inline-flex items-center gap-3 border border-amber/50 px-4 py-2 mb-8">
        <span class="w-1 h-1 bg-amber animate-pulse-slow"></span>
        <span class="text-amber text-xs font-normal tracking-[0.3em] uppercase">Gratis E-Book</span>
      </div>

      <h1 class="text-4xl sm:text-5xl leading-[1.12] tracking-tight mb-6">
        <span class="font-normal text-ink block mb-2">Mehr Stammkunden,</span>
        <span class="font-bold text-amber block">mehr Umsatz.</span>
      </h1>

      <p class="text-ink text-base font-normal leading-relaxed max-w-xl mx-auto mb-4">
        7 Kartentypen, klare Zahlen, sofort umsetzbar — von der Stempelkarte bis zum VIP-Club.
        Speziell für Kölner Cafés, ganz ohne großes Marketingbudget.
      </p>

      <a href="#leitfaden" class="inline-flex items-center gap-2 text-ink/60 hover:text-amber text-xs tracking-widest uppercase transition-colors">
        Direkt zum Download
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </a>
    </div>
  </section>

  <!-- ── DOWNLOAD-BEREICH ──────────────────────────────────────── -->
  <EbookSection id="leitfaden" />

  <!-- ── TERMIN-CTA ────────────────────────────────────────────── -->
  <section class="bg-ink py-14 sm:py-16 border-t border-paper/10">
    <div class="max-w-3xl mx-auto px-5 sm:px-8">
      <div class="flex flex-col sm:flex-row sm:items-center gap-6 sm:gap-10">
        <div class="flex-1">
          <p class="text-xs tracking-[0.25em] uppercase text-amber mb-2">Für Kölner Cafés</p>
          <h2 class="text-2xl sm:text-3xl font-bold text-paper leading-tight">
            Lieber direkt persönlich?
          </h2>
          <p class="text-paper/50 text-sm mt-2 leading-relaxed">
            15 Minuten reichen — danach weißt du genau, welche Karte zu deinem Café passt.
          </p>
        </div>
        <a
          href="https://termin.bonuskarte.digital/barista"
          target="_blank"
          rel="noopener noreferrer"
          class="flex-shrink-0 inline-flex items-center justify-center gap-2 bg-amber hover:bg-amber-dark text-black font-bold text-xs tracking-widest uppercase px-8 py-4 transition-colors"
        >
          Termin buchen
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
