---
import { getCollection } from 'astro:content'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import Navbar from '../../../components/Navbar.astro'
import Footer from '../../../components/Footer.astro'

export async function getStaticPaths() {
  const now = new Date()
  const posts = await getCollection('blog')
  return posts
    .filter(p => p.data.city === 'berlin' && p.data.pubDate <= now)
    .map(post => ({
      params: { slug: post.slug },
      props: { post },
    }))
}

const { post } = Astro.props
const { Content } = await post.render()
const bookingUrl = ['cafe', 'eiscafe'].includes(post.data.niche)
  ? 'https://termin.bonuskarte.digital/barista'
  : ['restaurant', 'gastro', 'doener', 'pizza'].includes(post.data.niche)
  ? 'https://termin.bonuskarte.digital/gastro'
  : 'https://termin.bonuskarte.digital/15min'

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('de-DE', { day: 'numeric', month: 'long', year: 'numeric' }).format(date)
}

const categoryColors: Record<string, string> = {
  'Ratgeber':  'bg-amber/20 text-amber border border-amber/50',
  'Strategie': 'bg-blue-900/30 text-blue-300 border border-blue-700/30',
  'How-to':    'bg-emerald-900/30 text-emerald-300 border border-emerald-700/30',
  'News':      'bg-ink/10 text-ink/60 border border-ink/10',
}

const allPosts = await getCollection('blog')
const related = allPosts
  .filter(p => p.data.city === 'berlin' && p.slug !== post.slug)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3)
---

<BaseLayout
  title={`${post.data.title} – bonuskarte.digital Berlin`}
  description={post.data.description}
  ogImage={post.data.heroImage}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": post.data.title,
    "description": post.data.description,
    "image": post.data.heroImage,
    "datePublished": post.data.pubDate.toISOString(),
    "dateModified": (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    "author": { "@type": "Person", "name": "Daniel Grüderich", "jobTitle": "Gründer", "url": "https://www.linkedin.com/in/dgruederich/", "worksFor": { "@type": "Organization", "name": "bonuskarte.digital", "url": "https://bonuskarte.digital" } },
    "publisher": { "@type": "Organization", "name": "bonuskarte.digital", "logo": { "@type": "ImageObject", "url": "https://bonuskarte.digital/favicon.svg" } },
    "mainEntityOfPage": { "@type": "WebPage", "@id": `https://bonuskarte.digital/berlin/blog/${post.slug}` }
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://bonuskarte.digital"},
    {"@type": "ListItem", "position": 2, "name": "Berlin", "item": "https://bonuskarte.digital/berlin"},
    {"@type": "ListItem", "position": 3, "name": "Blog", "item": "https://bonuskarte.digital/berlin/blog"},
    {"@type": "ListItem", "position": 4, "name": post.data.title, "item": `https://bonuskarte.digital/berlin/blog/${post.slug}`}
  ]
})} />
  <Navbar ctaHref="/#demo" />

  <div class="fixed top-0 left-0 right-0 z-[100] h-0.5 bg-transparent">
    <div id="progress-bar" class="h-full bg-amber transition-none" style="width:0%"></div>
  </div>

  <header class="bg-ink pt-24 pb-10 sm:pb-14">
    <div class="max-w-2xl mx-auto px-5 sm:px-8">
      <nav class="flex items-center flex-wrap gap-1.5 text-xs text-paper/55 mb-7 tracking-wide">
        <a href="/" class="hover:text-paper/60 transition-colors">Home</a>
        <span>›</span>
        <a href="/berlin" class="hover:text-paper/60 transition-colors">Berlin</a>
        <span>›</span>
        <a href="/berlin/blog" class="hover:text-paper/60 transition-colors">Blog</a>
        <span>›</span>
        <span class="text-paper/50">{post.data.category}</span>
      </nav>

      <div class="flex flex-wrap items-center gap-2.5 mb-5">
        <span class={`text-xs font-semibold tracking-wide uppercase px-2.5 py-1 ${categoryColors[post.data.category]}`}>{post.data.category}</span>
        <span class="text-paper/50 text-xs">{post.data.readingTime} Min. Lesezeit</span>
        <span class="text-paper/50">·</span>
        <span class="text-paper/55 text-xs">📍 Berlin</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-black text-paper leading-tight tracking-tight mb-5">{post.data.title}</h1>
      <p class="text-paper/55 text-base sm:text-lg leading-relaxed mb-7">{post.data.description}</p>

      <div class="flex items-center gap-3 pt-5 border-t border-paper/8">
        <img src="/images/daniel-gruederich.png" alt="Daniel Grüderich" class="w-9 h-9 rounded-full object-cover object-top flex-shrink-0" />
        <div>
          <div class="text-paper text-sm font-semibold leading-none mb-1">Daniel Grüderich</div>
          <div class="text-paper/60 text-xs">Gründer bonuskarte.digital · {formatDate(post.data.pubDate)}</div>
        </div>
      </div>
    </div>
  </header>

  <div class="bg-ink border-t border-ink/30">
    <div class="max-w-2xl mx-auto px-5 sm:px-8 py-8 sm:py-10">
      <div class="flex items-center justify-center bg-ink-900 min-h-[200px] sm:min-h-[320px] p-6 sm:p-10">
        <img src={post.data.heroImage} alt={post.data.title} class="max-h-[200px] sm:max-h-[300px] w-auto max-w-full object-contain drop-shadow-2xl" loading="eager" />
      </div>
    </div>
  </div>

  <main class="bg-white">
    <div class="max-w-2xl mx-auto px-5 sm:px-8 py-12 sm:py-16">
      <article id="article-body" class="article-body">
        <Content />
      </article>
    </div>
  </main>

  <!-- ── Author Bio ───────────────────────────── -->
  <section class="bg-paper-dark py-10 sm:py-12 border-t border-ink/10">
    <div class="max-w-2xl mx-auto px-5 sm:px-8">
      <div class="flex items-start gap-5">
        <img src="/images/daniel-gruederich.png" alt="Daniel Grüderich" class="w-16 h-16 rounded-full object-cover object-top flex-shrink-0" />
        <div>
          <div class="text-xs font-bold tracking-[0.2em] uppercase text-ink/40 mb-1">Über den Autor</div>
          <div class="text-ink font-semibold text-sm mb-0.5">Daniel Grüderich</div>
          <div class="text-amber text-xs font-medium mb-2">Gründer bonuskarte.digital</div>
          <p class="text-ink/70 text-sm leading-relaxed">Daniel Grüderich ist Gründer von bonuskarte.digital und hilft lokalen Betrieben dabei, Papier-Stempelkarten durch digitale Kundenbindung zu ersetzen. Seit Jahren arbeitet er mit Gastronomen, Cafés und lokalen Händlern zusammen und weiß, was Stammkunden wirklich brauchen.</p>
          <a href="https://www.linkedin.com/in/dgruederich/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 mt-3 text-xs text-ink/50 hover:text-ink transition-colors">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
            LinkedIn
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-ink py-14 sm:py-20 border-t border-ink/30">
    <div class="max-w-2xl mx-auto px-5 sm:px-8">
      <div class="flex flex-col sm:flex-row sm:items-center gap-6 sm:gap-10">
        <div class="flex-1">
          <div class="text-amber text-xs font-bold tracking-[0.25em] uppercase mb-2">Für Berliner Betriebe</div>
          <h2 class="text-2xl sm:text-3xl font-black text-paper leading-tight">Jetzt 90 Tage kostenlos starten</h2>
          <p class="text-paper/45 text-sm mt-2 leading-relaxed">Keine Kreditkarte. Keine App. Läuft auf jedem Smartphone in Ihrem Kiez.</p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 flex-shrink-0">
          <a href="/berlin/mitte/cafes" class="inline-flex items-center justify-center gap-2 bg-amber hover:bg-amber-dark text-black font-bold text-xs tracking-widest uppercase px-7 py-4 transition-colors group">
            Gratis starten
            <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
          <a href={bookingUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 border border-paper/30 hover:border-paper/60 text-paper font-bold text-xs tracking-widest uppercase px-7 py-4 transition-colors">
            Termin buchen
          </a>
        </div>
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="bg-white py-14 sm:py-16 border-t border-gray-100">
      <div class="max-w-2xl mx-auto px-5 sm:px-8">
        <div class="flex items-center justify-between mb-8">
          <h2 class="text-xs font-bold tracking-[0.25em] uppercase text-black/40">Weitere Artikel</h2>
          <a href="/berlin/blog" class="text-xs text-amber hover:text-amber tracking-widest uppercase transition-colors font-medium">Alle →</a>
        </div>
        <div class="grid sm:grid-cols-3 gap-px bg-gray-100">
          {related.map(p => (
            <a href={`/berlin/blog/${p.slug}`} class="group bg-white hover:bg-gray-50 transition-colors p-5 flex flex-col gap-3">
              <div class="bg-gray-50 flex items-center justify-center aspect-video overflow-hidden">
                <img src={p.data.heroImage} alt={p.data.title} class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-500" loading="lazy" />
              </div>
              <span class="text-amber text-xs font-semibold tracking-wide uppercase">{p.data.category}</span>
              <h3 class="text-sm font-bold text-black leading-snug group-hover:text-amber transition-colors">{p.data.title}</h3>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <Footer />
</BaseLayout>

<script>
  const bar = document.getElementById('progress-bar')
  const article = document.getElementById('article-body')
  if (bar && article) {
    window.addEventListener('scroll', () => {
      const articleTop = article.getBoundingClientRect().top + window.scrollY
      const articleH   = article.offsetHeight
      const winH       = window.innerHeight
      const scrolled   = window.scrollY - articleTop
      const total      = articleH - winH
      const pct        = total > 0 ? Math.min(100, Math.max(0, (scrolled / total) * 100)) : 0
      bar.style.width  = pct + '%'
    }, { passive: true })
  }
</script>

<style is:global>
.article-body { font-size: 1.0625rem; line-height: 1.85; color: #374151; }
.article-body h2 { font-size: 1.4375rem; font-weight: 800; color: #000; margin-top: 3.25rem; margin-bottom: 1rem; line-height: 1.25; letter-spacing: -0.02em; padding-left: 1rem; border-left: 3px solid #F25C24; }
.article-body h3 { font-size: 1.125rem; font-weight: 700; color: #111; margin-top: 2.25rem; margin-bottom: 0.75rem; line-height: 1.4; }
.article-body p { margin-bottom: 1.375rem; }
.article-body strong { font-weight: 700; color: #111; }
.article-body a { color: #F25C24; text-decoration: none; border-bottom: 1px solid rgba(139,115,0,0.35); transition: border-color 0.15s; }
.article-body a:hover { border-bottom-color: #F25C24; }
.article-body ul { list-style: none; padding: 0; margin: 0 0 1.5rem; }
.article-body ul li { position: relative; padding-left: 1.625rem; margin-bottom: 0.625rem; line-height: 1.75; }
.article-body ul li::before { content: '→'; color: #F25C24; font-weight: 700; position: absolute; left: 0; top: 0.05em; }
.article-body ol { list-style: none; padding: 0; margin: 0 0 1.5rem; counter-reset: ol-counter; }
.article-body ol li { position: relative; padding-left: 2.25rem; margin-bottom: 0.75rem; line-height: 1.75; counter-increment: ol-counter; }
.article-body ol li::before { content: counter(ol-counter); position: absolute; left: 0; top: 0.1em; width: 1.5rem; height: 1.5rem; background: #000; color: #fff; font-size: 0.6875rem; font-weight: 800; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.article-body blockquote { background: #0d0d0d; border: none; border-left: 3px solid #F25C24; padding: 1.375rem 1.5rem; margin: 2rem 0; font-style: normal; }
.article-body blockquote p { color: rgba(255,255,255,0.8); margin-bottom: 0; font-size: 1rem; line-height: 1.75; }
</style>
