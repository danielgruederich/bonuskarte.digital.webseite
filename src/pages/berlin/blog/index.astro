---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import Navbar from '../../../components/Navbar.astro'
import Footer from '../../../components/Footer.astro'
import { getCollection } from 'astro:content'

const now = new Date()
const allPosts = await getCollection('blog')
const posts = allPosts
  .filter(p => p.data.city === 'berlin' && p.data.pubDate <= now && p.data.approved !== false)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())

const featured = posts.find(p => p.data.featured) ?? posts[0]
const rest = posts.filter(p => p.slug !== featured?.slug)

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('de-DE', { day: 'numeric', month: 'long', year: 'numeric' }).format(date)
}

const categoryColors: Record<string, string> = {
  'Ratgeber':  'bg-amber/20 text-amber border border-amber/50',
  'Strategie': 'bg-blue-900/30 text-blue-300 border border-blue-700/30',
  'How-to':    'bg-emerald-900/30 text-emerald-300 border border-emerald-700/30',
  'News':      'bg-ink/10 text-ink/60 border border-ink/10',
}
---

<BaseLayout
  title="Blog Berlin – bonuskarte.digital | Kundenbindung für Berliner Betriebe"
  description="Tipps, Anleitungen und Strategien zur digitalen Kundenbindung speziell für Cafés, Restaurants und Dönerläden in Berlin – Mitte, Prenzlauer Berg, Kreuzberg und mehr."
>
  <Navbar ctaHref="/#demo" />

  <section class="relative bg-paper overflow-hidden pt-32 pb-20">
    <div class="absolute inset-0 bg-grid-ink opacity-100 pointer-events-none"></div>
    <div class="relative max-w-6xl mx-auto px-5 sm:px-8">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 text-amber text-xs font-bold tracking-[0.3em] uppercase mb-6">
          <span class="w-8 h-px bg-amber"></span>
          Berlin · FUERTE.DIGITAL
        </div>
        <h1 class="text-5xl sm:text-6xl font-black text-ink tracking-tight leading-none mb-5">
          BLOG<br/><span class="text-amber">BERLIN</span>
        </h1>
        <p class="text-lg text-ink/50 leading-relaxed max-w-lg">
          Wissen für Berliner Unternehmer. Kundenbindung für Mitte, Prenzlauer Berg, Kreuzberg und alle Berliner Kieze.
        </p>
        <nav class="flex items-center gap-2 text-xs text-ink/55 mt-8 tracking-wide">
          <a href="/" class="hover:text-ink/60 transition-colors">Home</a>
          <span>›</span>
          <a href="/berlin" class="hover:text-ink/60 transition-colors">Berlin</a>
          <span>›</span>
          <span class="text-ink/50">Blog</span>
        </nav>
      </div>
    </div>
  </section>

  {featured && (
    <section class="bg-ink">
      <div class="max-w-6xl mx-auto px-5 sm:px-8">
        <a href={`/berlin/blog/${featured.slug}`} class="group block">
          <div class="grid md:grid-cols-2 gap-0 border border-ink/10 hover:border-amber/40 transition-colors duration-300 overflow-hidden">
            <div class="relative overflow-hidden aspect-[4/3] md:aspect-auto min-h-[280px]">
              <img src={featured.data.heroImage} alt={featured.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="eager" />
              <div class="absolute inset-0 bg-ink/20 group-hover:bg-ink/10 transition-colors duration-300"></div>
              <div class="absolute top-4 left-4">
                <span class="inline-block bg-amber text-black text-xs font-bold tracking-widest uppercase px-3 py-1.5">Featured</span>
              </div>
            </div>
            <div class="bg-ink-900 p-8 sm:p-10 flex flex-col justify-center">
              <div class="flex items-center gap-3 mb-5">
                <span class={`text-xs font-semibold tracking-wide uppercase px-2.5 py-1 rounded-sm ${categoryColors[featured.data.category]}`}>{featured.data.category}</span>
                <span class="text-paper/55 text-xs">{featured.data.readingTime} Min. Lesezeit</span>
              </div>
              <h2 class="text-2xl sm:text-3xl font-bold text-paper leading-snug mb-4 group-hover:text-amber transition-colors">{featured.data.title}</h2>
              <p class="text-paper/50 leading-relaxed text-sm mb-6 line-clamp-3">{featured.data.description}</p>
              <div class="flex items-center justify-between">
                <span class="text-paper/55 text-xs">{formatDate(featured.data.pubDate)}</span>
                <span class="inline-flex items-center gap-2 text-amber text-xs font-bold tracking-widest uppercase group-hover:gap-3 transition-all">
                  Weiterlesen
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                </span>
              </div>
            </div>
          </div>
        </a>
      </div>
    </section>
  )}

  {rest.length > 0 && (
    <section class="bg-ink py-16">
      <div class="max-w-6xl mx-auto px-5 sm:px-8">
        <div class="flex items-center gap-4 mb-10">
          <h2 class="text-xs font-bold tracking-[0.3em] uppercase text-ink/40">Alle Berliner Artikel</h2>
          <div class="flex-1 h-px bg-ink/20"></div>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-px bg-ink/20">
          {rest.map(post => (
            <a href={`/berlin/blog/${post.slug}`} class="group bg-paper hover:bg-ink-900 transition-colors duration-200 p-7 flex flex-col">
              <div class="relative overflow-hidden aspect-video mb-6">
                <img src={post.data.heroImage} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
              </div>
              <div class="flex items-center gap-2 mb-3">
                <span class={`text-xs font-semibold tracking-wide uppercase px-2 py-0.5 rounded-sm ${categoryColors[post.data.category]}`}>{post.data.category}</span>
                <span class="text-ink/50 text-xs">{post.data.readingTime} Min.</span>
              </div>
              <h3 class="text-base font-bold text-ink leading-snug mb-3 group-hover:text-amber transition-colors flex-1">{post.data.title}</h3>
              <p class="text-ink/40 text-sm leading-relaxed line-clamp-2 mb-5">{post.data.description}</p>
              <div class="flex items-center justify-between mt-auto pt-4 border-t border-ink/30">
                <span class="text-ink/50 text-xs">{formatDate(post.data.pubDate)}</span>
                <svg class="w-4 h-4 text-ink/50 group-hover:text-amber group-hover:translate-x-1 transition-all duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="bg-ink border-t border-ink/30 py-20">
    <div class="max-w-3xl mx-auto px-5 sm:px-8 text-center">
      <div class="text-xs font-bold tracking-[0.3em] uppercase text-amber mb-4">Für Berliner Betriebe</div>
      <h2 class="text-3xl sm:text-4xl font-black text-paper mb-5 leading-tight">
        Bereit für Ihre eigene<br/>digitale Kundenkarte in Berlin?
      </h2>
      <p class="text-ink/50 mb-8 text-base leading-relaxed">90 Tage kostenlos. Keine Kreditkarte. Läuft auf jedem Smartphone in Ihrem Kiez.</p>
      <a href="/berlin/mitte/cafes" class="inline-flex items-center gap-3 bg-amber hover:bg-amber-dark text-black font-bold text-xs tracking-widest uppercase px-8 py-4 transition-colors group">
        Jetzt gratis starten
        <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
  </section>

  <Footer />
</BaseLayout>
