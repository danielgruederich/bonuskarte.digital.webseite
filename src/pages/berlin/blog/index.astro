---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import Navbar from '../../../components/Navbar.astro'
import Footer from '../../../components/Footer.astro'
import BlogPageHero from '../../../components/blog/BlogPageHero.astro'
import BlogFeature from '../../../components/blog/BlogFeature.astro'
import BlogCard from '../../../components/blog/BlogCard.astro'
import BlogCta from '../../../components/blog/BlogCta.astro'
import { getCollection } from 'astro:content'

const now = new Date()
const allPosts = await getCollection('blog')
const posts = allPosts
  .filter(p => p.data.city === 'berlin' && p.data.pubDate <= now && p.data.approved !== false)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())

const featured = posts.find(p => p.data.featured) ?? posts[0]
const rest = posts.filter(p => p.slug !== featured?.slug)
---

<BaseLayout
  title="Blog Berlin – bonuskarte.digital | Kundenbindung für Berliner Betriebe"
  description="Tipps, Anleitungen und Strategien zur digitalen Kundenbindung speziell für Cafés, Restaurants und Dönerläden in Berlin – Mitte, Prenzlauer Berg, Kreuzberg und mehr."
>
  <Navbar ctaHref="/#demo" />

  <BlogPageHero
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Berlin', href: '/berlin/' }, { label: 'Blog' }]}
    kicker="Berlin · FUERTE.DIGITAL"
    lead="Wissen für Berliner Unternehmer. Kundenbindung für Mitte, Prenzlauer Berg, Kreuzberg und alle Berliner Kieze."
  >
    Blog <span class="text-amber-text">Berlin</span>
  </BlogPageHero>

  <main class="bg-paper">
    <div class="max-w-6xl mx-auto px-5 sm:px-8 pb-20">
      {featured && <BlogFeature post={featured} href={`/berlin/blog/${featured.slug}/`} />}
      {rest.length > 0 && (
        <>
          <div class="flex items-baseline justify-between gap-4 mb-6">
            <h2 class="text-2xl sm:text-3xl font-extrabold text-ink tracking-tight">Alle Berliner Artikel</h2>
            <p class="text-ink-500 text-[15px]">{rest.length} Artikel</p>
          </div>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {rest.map(post => <BlogCard post={post} href={`/berlin/blog/${post.slug}/`} />)}
          </div>
        </>
      )}
    </div>
  </main>

  <BlogCta
    title="Bereit für Ihre eigene digitale Kundenkarte in Berlin?"
          text="90 Tage kostenlos. Keine Kreditkarte. Läuft auf jedem Smartphone in Ihrem Kiez."
    button="Jetzt gratis starten"
    href="/berlin/mitte/cafes/"
  />

  <Footer />
</BaseLayout>
