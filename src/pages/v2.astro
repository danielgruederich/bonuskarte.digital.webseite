    <!-- ======================= STICKY MOBILE CTA ======================= -->
    <div id="bk-sticky" class="bk-sticky" style="position:fixed;left:0;right:0;bottom:0;z-index:70;background:rgba(246,241,232,0.94);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-top:1px solid var(--border);padding:12px 16px;align-items:center;gap:14px;box-shadow:0 -6px 20px rgba(26,20,16,0.10)">
      <div style="flex:1;line-height:1.2">
        <div style="font-weight:600;font-size:14px">90 Tage kostenlos</div>
        <div style="font-size:12px;color:var(--ink-56)">keine Kreditkarte · live in 24 h</div>
      </div>
      <button type="button" class="bk-btn bk-btn--md" data-scroll-to-form>Demo-Karte erstellen</button>
    </div>

  </div>

  <script>
    import { analytics } from '../lib/analytics'

    const TOTAL = 12

    // ── Interaktive Demo-Karte (tippen = stempeln) ─────────────────────────
    let demoFilled = 7
    const demoCard = document.getElementById('demo-card')
    const demoStamps = document.querySelectorAll('#demo-stamps .bk-stamp')
    const demoNotif = document.getElementById('demo-notif')
    const demoHint = document.getElementById('demo-hint')
    const demoDone = document.getElementById('demo-done')
    const demoTapsLeft = document.getElementById('demo-taps-left')
    const demoLeftLabel = document.getElementById('demo-left-label')

    function renderDemo() {
      demoStamps.forEach((el, i) => el.classList.toggle('is-filled', i < demoFilled))
      const complete = demoFilled >= TOTAL
      if (demoNotif) demoNotif.hidden = !complete
      if (demoHint) demoHint.style.display = complete ? 'none' : ''
      if (demoDone) demoDone.hidden = !complete
      if (demoTapsLeft) demoTapsLeft.textContent = String(Math.max(0, TOTAL - demoFilled))
      if (demoLeftLabel) demoLeftLabel.textContent = complete ? 'Geschenk frei' : `${TOTAL - demoFilled} Stempel`
    }
    function addStamp() {
      demoFilled = demoFilled >= TOTAL ? 7 : demoFilled + 1
      renderDemo()
    }
    if (demoCard) {
      demoCard.addEventListener('click', addStamp)
      demoCard.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); addStamp() }
      })
    }

    // ── Scroll-Stempel-Sektion (füllt sich beim Reinscrollen) ──────────────
    let scrollFilled = 5
    let stampStarted = false
    const scrollPass = document.getElementById('scroll-pass')
    const scrollStamps = document.querySelectorAll('#scroll-stamps .bk-stamp')
    const scrollLeftLabel = document.getElementById('scroll-left-label')

    function renderScroll() {
      scrollStamps.forEach((el, i) => el.classList.toggle('is-filled', i < scrollFilled))
      if (scrollLeftLabel) scrollLeftLabel.textContent = scrollFilled >= TOTAL ? 'Geschenk frei' : `${TOTAL - scrollFilled} Stempel`
    }
    function runStamps() {
      const step = () => {
        scrollFilled = Math.min(scrollFilled + 1, TOTAL)
        renderScroll()
        if (scrollFilled < TOTAL) setTimeout(step, 320)
      }
      setTimeout(step, 400)
    }
    if (scrollPass && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting && !stampStarted) {
            stampStarted = true
            runStamps()
            io.disconnect()
          }
        })
      }, { threshold: 0.35 })
      io.observe(scrollPass)
    } else {
      scrollFilled = TOTAL
      renderScroll()
    }

    // ── "Kostenlos testen" → zum Bestellzettel scrollen ─────────────────────
    document.querySelectorAll('[data-scroll-to-form]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const el = document.getElementById('lead')
        if (!el) return
        const y = el.getBoundingClientRect().top + window.scrollY - 80
        window.scrollTo({ top: y, behavior: 'smooth' })
      })
    })

    // ── Formulare → /api/submit.php (Salesflare + Boomerang + Telegram …) ──
    const params = new URLSearchParams(window.location.search)
    const utm: Record<string, string> = {
      utm_source: params.get('utm_source') || 'bonuskarte.digital',
      utm_medium: params.get('utm_medium') || 'landing-page',
      utm_campaign: params.get('utm_campaign') || 'v2',
    }
    if (params.get('utm_content')) utm.utm_content = params.get('utm_content')!
    if (params.get('utm_term')) utm.utm_term = params.get('utm_term')!

    document.querySelectorAll<HTMLFormElement>('form[data-bk-form]').forEach((form) => {
      const key = form.dataset.bkForm!
      const successEl = document.querySelector<HTMLElement>(`[data-bk-success="${key}"]`)
      const errorEl = form.querySelector<HTMLElement>('.bk-form-error')
      const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]')
      let started = false
      let nicheTracked = false

      form.addEventListener('focusin', () => {
        if (started) return
        started = true
        analytics.signupFormStart('', '', 'v2')
      })
      form.querySelector('select[name="branche"]')?.addEventListener('change', (e) => {
        const v = (e.target as HTMLSelectElement).value
        if (!v || nicheTracked) return
        nicheTracked = true
        analytics.nicheSelected(v, '', 'v2')
      })

      form.addEventListener('submit', async (e) => {
        e.preventDefault()
        errorEl?.classList.remove('is-visible')

        const business = (form.elements.namedItem('betrieb') as HTMLInputElement).value.trim()
        const niche = (form.elements.namedItem('branche') as HTMLSelectElement).value
        const kontakt = (form.elements.namedItem('kontakt') as HTMLInputElement).value.trim()
        if (!business || !niche || !kontakt) {
          form.reportValidity()
          return
        }

        analytics.signupSubmitAttempt(niche, '', 'v2')
        form.classList.add('bk-submitting')
        if (submitBtn) submitBtn.textContent = 'Einen Moment …'

        try {
          const res = await fetch('/api/submit.php', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ business, niche, kontakt, utm, mode: 'standard', source: `v2-form-${key}` }),
          })
          const json = await res.json().catch(() => ({}))
          if (res.ok && json.success) {
            analytics.demoCardCreated(niche, '')
            analytics.signupSubmit(niche, '', 'v2')
            form.hidden = true
            if (successEl) successEl.hidden = false
            if (key === 'a') document.getElementById('bk-sticky')?.classList.add('is-hidden')
          } else {
            throw new Error(json.error || 'api_error')
          }
        } catch (err) {
          analytics.signupSubmitError(niche, '', err instanceof TypeError ? 'network_error' : 'api_error', 'v2')
          errorEl?.classList.add('is-visible')
        } finally {
          form.classList.remove('bk-submitting')
          if (submitBtn) submitBtn.textContent = 'Meine Stammkunden-Karte erstellen'
        }
      })
    })
  </script>
</BaseLayout>
