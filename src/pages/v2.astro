<style is:global>
  .v2 {
    --v2-accent: #F25C24;
    --v2-accent-hover: #E2531F;
    --v2-amber-tint: #FBE4D8;
    --v2-ink: #1A1410;
    --v2-paper: #F6F1E8;
    --v2-white: #FFFFFF;
    --v2-sunken: #EFE8DB;
    --v2-ink-72: rgba(26,20,16,0.72);
    --v2-ink-56: rgba(26,20,16,0.56);
    --v2-ink-40: rgba(26,20,16,0.40);
    --v2-ink-24: rgba(26,20,16,0.24);
    --v2-ink-14: rgba(26,20,16,0.14);
    --v2-border: rgba(26,20,16,0.14);
    --v2-border-strong: rgba(26,20,16,0.24);
    --v2-shadow-sm: 0 2px 6px rgba(26,20,16,0.07);
    --v2-shadow-md: 0 6px 18px rgba(26,20,16,0.09);
    --v2-shadow-lg: 0 14px 40px rgba(26,20,16,0.13);
    font-family: 'Geist', ui-sans-serif, system-ui, sans-serif;
    background: var(--v2-paper);
    color: var(--v2-ink);
    overflow-x: hidden;
    position: relative;
    -webkit-font-smoothing: antialiased;
  }
  .v2 ::selection { background: var(--v2-amber-tint); }
  .v2 .v2-mono, .v2 .v2-mono * { font-family: 'Geist Mono', ui-monospace, 'SFMono-Regular', monospace; }
  .v2 .v2-mono .v2-sans { font-family: 'Geist', ui-sans-serif, system-ui, sans-serif; }

  @keyframes bk-thunk { 0% { transform: scale(0.55) rotate(-8deg); opacity: 0; } 60% { opacity: 1; } 100% { transform: scale(1) rotate(0); opacity: 1; } }
  @keyframes bk-rise { from { transform: translateY(14px); opacity: 0; } to { transform: none; opacity: 1; } }
  @keyframes bk-nudge { 0%,100% { transform: translateX(0); } 50% { transform: translateX(5px); } }

  /* Header */
  .v2-header { position: sticky; top: 0; z-index: 60; background: rgba(246,241,232,0.82); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid var(--v2-border); }
  .v2-header-inner { max-width: 1200px; margin: 0 auto; padding: 14px 24px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .v2-navlink { font-size: 15px; font-weight: 500; color: var(--v2-ink-72); text-decoration: none; }
  .v2-navlink:hover { color: var(--v2-ink); }
  .v2-navlinks { display: flex; align-items: center; gap: 26px; }
  @media (max-width: 819px) { .v2-navlinks { display: none; } }

  /* Typo helpers */
  .v2-kicker { font-family: 'Geist Mono', ui-monospace, monospace; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--v2-accent); font-weight: 500; margin: 0 0 16px; }
  .v2-h2 { font-family: 'Zilla Slab', Georgia, serif; font-weight: 600; font-size: clamp(28px,4vw,42px); line-height: 1.06; letter-spacing: -0.01em; margin: 0 0 16px; }
  .v2-trustrow { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 18px; font-family: 'Geist Mono', ui-monospace, monospace; font-size: 12.5px; letter-spacing: 0.04em; color: var(--v2-ink-56); }
  .v2-subhead { font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--v2-ink-40); font-weight: 500; margin: 0 0 16px; }

  /* Buttons */
  .v2-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; background: var(--v2-accent); color: var(--v2-paper); border: none; border-radius: 14px; font-family: inherit; font-weight: 600; font-size: 15px; cursor: pointer; text-decoration: none; padding: 0 22px; height: 44px; transition: background 0.15s ease; }
  .v2-btn:hover { background: var(--v2-accent-hover); }
  .v2-btn:disabled { opacity: 0.6; cursor: wait; }
  .v2-btn-sm { height: 36px; padding: 0 16px; font-size: 14px; }
  .v2-btn-lg { height: 54px; font-size: 16px; border-radius: 14px; }
  .v2-ghostbtn { display: inline-flex; align-items: center; gap: 8px; height: 44px; padding: 0 20px; border-radius: 14px; border: 1px solid var(--v2-border-strong); color: var(--v2-ink); text-decoration: none; font-weight: 600; font-size: 15px; }
  .v2-ghostbtn:hover { background: rgba(26,20,16,0.04); }

  /* Formular */
  .v2-perf { width: 6px; height: 6px; border-radius: 50%; background: var(--v2-sunken); }
  .v2-label { display: block; font-size: 13px; font-weight: 600; color: var(--v2-ink); margin-bottom: 2px; }
  .v2-input { width: 100%; box-sizing: border-box; border: none; border-bottom: 1.5px solid var(--v2-ink-24); border-radius: 0; background: transparent; padding: 8px 2px; font-family: inherit; font-size: 16px; color: var(--v2-ink); outline: none; }
  .v2-input:focus { border-bottom-color: var(--v2-accent); }
  .v2-select { appearance: none; -webkit-appearance: none; cursor: pointer; background-image: url('data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%2214%22 height=%2214%22 fill=%22none%22 stroke=%22%231A1410%22 stroke-width=%222.4%22 stroke-linecap=%22round%22%3E%3Cpath d=%22m6 9 6 6 6-6%22/%3E%3C/svg%3E'); background-repeat: no-repeat; background-position: right 2px center; }
  .v2-formerror { font-size: 13.5px; color: #B23A2B; background: #F4E2DE; border-radius: 10px; padding: 10px 14px; margin: 0 0 16px; line-height: 1.5; }
  .v2-success { animation: bk-rise 0.4s ease-out both; }

  /* Demo-Stempel */
  .v2-stamp { display: inline-flex; align-items: center; justify-content: center; aspect-ratio: 1; border-radius: 50%; border: 1.5px dashed var(--v2-ink-24); background: transparent; transition: background 0.15s ease, border-color 0.15s ease; }
  .v2-stamp svg { opacity: 0; transform: scale(0.55) rotate(-8deg); transition: none; }
  .v2-stamp.is-filled { background: var(--v2-accent); border-color: var(--v2-accent); border-style: solid; }
  .v2-stamp.is-filled svg { opacity: 1; transform: scale(1) rotate(0); animation: bk-thunk 0.3s ease-out both; }
  #demo-reward { animation: bk-rise 0.35s ease-out both; }

  /* Wallet-Pass */
  .v2-pass { flex: 0 0 auto; width: 290px; border-radius: 22px; padding: 20px 20px 0; box-shadow: var(--v2-shadow-lg); text-align: left; overflow: hidden; }
  .v2-pass-light { background: var(--v2-white); border: 1px solid var(--v2-border); color: var(--v2-ink); }
  .v2-pass-dark { background: #241D17; border: 1px solid #322A22; color: var(--v2-paper); width: 320px; }
  .v2-pass-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; }
  .v2-pass-sub { font-size: 10.5px; letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.5; }
  .v2-pass-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; margin-bottom: 16px; }
  .v2-pass-stamp { display: inline-flex; align-items: center; justify-content: center; aspect-ratio: 1; border-radius: 50%; border: 1.5px dashed rgba(128,118,108,0.45); }
  .v2-pass-stamp svg { opacity: 0; }
  .v2-pass-stamp-filled, .v2-pass-stamp.is-filled { background: var(--v2-accent); border-color: var(--v2-accent); border-style: solid; }
  .v2-pass-stamp-filled svg { opacity: 1; }
  .v2-pass-stamp.is-filled svg { opacity: 1; animation: bk-thunk 0.3s ease-out both; }
  .v2-pass-foot { display: flex; align-items: center; justify-content: space-between; padding-bottom: 14px; }
  .v2-pass-barcode { height: 42px; margin: 0 -20px; background: repeating-linear-gradient(90deg, currentColor 0 2px, transparent 2px 5px, currentColor 5px 6px, transparent 6px 10px); opacity: 0.65; }
  .v2-pass-light .v2-pass-barcode { background-color: transparent; color: var(--v2-ink); }
  .v2-pass-dark .v2-pass-barcode { color: var(--v2-paper); }

  /* Chips */
  .v2-chip-dashed { display: inline-flex; align-items: center; height: 42px; padding: 0 20px; border-radius: 999px; border: 1.5px dashed var(--v2-ink-24); color: var(--v2-ink); text-decoration: none; font-weight: 500; font-size: 15px; }
  .v2-chip-dashed:hover { border-color: var(--v2-accent); color: var(--v2-accent); }
  .v2-chip-city { display: inline-flex; align-items: center; height: 38px; padding: 0 16px; border-radius: 999px; background: var(--v2-white); border: 1px solid var(--v2-border); color: var(--v2-ink); text-decoration: none; font-size: 14px; }
  .v2-chip-city:hover { border-color: var(--v2-accent); color: var(--v2-accent); }

  /* FAQ */
  .v2-faq { border-bottom: 1px solid var(--v2-border); padding: 6px 0; }
  .v2-faq summary { cursor: pointer; list-style: none; padding: 16px 0; font-weight: 600; font-size: 18px; display: flex; justify-content: space-between; gap: 16px; align-items: center; }
  .v2-faq summary::-webkit-details-marker { display: none; }
  .v2-faq summary span { color: var(--v2-accent); font-weight: 400; font-size: 22px; transition: transform 0.2s ease; }
  .v2-faq[open] summary span { transform: rotate(45deg); }
  .v2-faq p { font-size: 16px; line-height: 1.65; color: var(--v2-ink-72); margin: 0 0 16px; }

  /* Footer */
  .v2-foothead { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(246,241,232,0.56); font-weight: 500; margin: 0 0 16px; }
  .v2-footlink { color: rgba(246,241,232,0.72); text-decoration: none; font-size: 14px; }
  .v2-footlink:hover { color: var(--v2-paper); }

  @media (min-width: 820px) { #v2-sticky { display: none !important; } }
</style>

<script>
  import { analytics } from '../lib/analytics'

  const SOURCE = 'v2'
  const CITY = ''

  // ── Header/Sticky CTA → zum Hero-Formular scrollen ──
  const lead = document.getElementById('lead')
  document.querySelectorAll('[data-scroll-to-form]').forEach(btn => {
    btn.addEventListener('click', () => {
      if (!lead) return
      const y = lead.getBoundingClientRect().top + window.scrollY - 80
      window.scrollTo({ top: y, behavior: 'smooth' })
      lead.querySelector<HTMLInputElement>('input[name="betrieb"]')?.focus({ preventScroll: true })
    })
  })

  // ── Demo-Stempelkarte (5 Tipps → Belohnung) ──
  const demoCard = document.getElementById('demo-card')
  const demoStamps = Array.from(document.querySelectorAll('#demo-stamps .v2-stamp'))
  const demoReward = document.getElementById('demo-reward')
  const demoHint = document.getElementById('demo-hint')
  const demoLeft = document.getElementById('demo-left')
  let filled = 0
  function renderDemo() {
    demoStamps.forEach((s, i) => s.classList.toggle('is-filled', i < filled))
    const done = filled >= 5
    if (demoReward) demoReward.hidden = !done
    if (demoHint) demoHint.style.display = done ? 'none' : ''
    if (demoLeft) demoLeft.textContent = String(5 - filled)
  }
  function tap() { filled = filled >= 5 ? 0 : filled + 1; renderDemo() }
  demoCard?.addEventListener('click', tap)
  demoCard?.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter' || (e as KeyboardEvent).key === ' ') { e.preventDefault(); tap() } })

  // ── Scroll-Stempel im dunklen Wallet-Pass (füllt bis 7/10) ──
  const scrollPass = document.getElementById('scroll-pass')
  const scrollStamps = Array.from(document.querySelectorAll('#scroll-stamps .v2-pass-stamp'))
  let scrollStarted = false
  function runScrollStamps() {
    let n = 0
    const step = () => {
      if (n < 7) { scrollStamps[n]?.classList.add('is-filled'); n++; setTimeout(step, 320) }
    }
    setTimeout(step, 400)
  }
  if (scrollPass && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting && !scrollStarted) { scrollStarted = true; runScrollStamps(); io.disconnect() }
      })
    }, { threshold: 0.35 })
    io.observe(scrollPass)
  } else {
    scrollStamps.slice(0, 7).forEach(s => s.classList.add('is-filled'))
  }

  // ── Sticky Mobile CTA: zeigen, sobald Hero-Formular aus dem Bild ist ──
  const sticky = document.getElementById('v2-sticky')
  let submitted = false
  if (sticky && lead && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => { sticky.hidden = e.isIntersecting || submitted })
    }, { threshold: 0.1 })
    io.observe(lead)
  }

  // ── Lead-Formulare → /api/submit.php (source: v2) ──
  function getUtmParams(): Record<string, string> {
    const params = new URLSearchParams(window.location.search)
    const utm: Record<string, string> = {
      utm_source: params.get('utm_source') || 'bonuskarte.digital',
      utm_medium: params.get('utm_medium') || 'landing-page',
      utm_campaign: params.get('utm_campaign') || 'v2',
    }
    for (const k of ['utm_content', 'utm_term', 'fbclid']) {
      const v = params.get(k)
      if (v) utm[k] = v
    }
    return utm
  }

  document.querySelectorAll<HTMLFormElement>('.v2-leadform').forEach(form => {
    const container = form.parentElement!
    const success = container.querySelector<HTMLElement>('.v2-success')
    const errorEl = form.querySelector<HTMLElement>('.v2-formerror')
    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]')
    let started = false

    form.addEventListener('focusin', () => {
      if (!started) { started = true; analytics.signupFormStart('unbekannt', CITY, SOURCE) }
    })

    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      const data = Object.fromEntries(new FormData(form)) as Record<string, string>
      const niche = (data.branche || 'cafe').toLowerCase()
      if (errorEl) errorEl.hidden = true
      if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Karte wird erstellt …' }
      analytics.signupSubmitAttempt(niche, CITY, SOURCE)

      try {
        const res = await fetch('/api/submit.php', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            ladenname: data.betrieb,
            kontakt: data.kontakt,
            niche,
            city: CITY,
            mode: 'standard',
            source: SOURCE,
            utm: getUtmParams(),
          }),
        })
        const json = await res.json()
        if (res.ok && json.success) {
          analytics.demoCardCreated(niche, CITY)
          analytics.signupSubmit(niche, CITY, SOURCE)
          const link = json.directInstallLink?.universal ?? json.installLink
          if (success) {
            const installEl = success.querySelector<HTMLAnchorElement>('.v2-installlink')
            if (installEl && link) { installEl.href = link; installEl.hidden = false }
            form.hidden = true
            success.hidden = false
          }
          submitted = true
          if (sticky) sticky.hidden = true
        } else {
          analytics.signupSubmitError(niche, CITY, 'api_error', SOURCE)
          if (errorEl) errorEl.hidden = false
        }
      } catch {
        analytics.signupSubmitError(niche, CITY, 'network_error', SOURCE)
        if (errorEl) errorEl.hidden = false
      } finally {
        if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Kostenlos starten' }
      }
    })
  })
</script>
