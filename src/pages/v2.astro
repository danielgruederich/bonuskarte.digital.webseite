---
// A/B-Test-Variante der Startseite ("Bestellzettel"-Design).
// Canonical zeigt auf / — diese Seite konsolidiert alle SEO-Signale aufs Original
// und ist aus der Sitemap ausgeschlossen (astro.config.mjs).
import BaseLayout from '../layouts/BaseLayout.astro'

const whatsappUrl = 'https://wa.me/491705594140'

const branchen = [
  { label: 'Café', value: 'cafe' },
  { label: 'Bäckerei', value: 'baeckerei' },
  { label: 'Döner / Imbiss', value: 'doener' },
  { label: 'Pizzeria', value: 'pizza' },
  { label: 'Restaurant', value: 'restaurant' },
  { label: 'Eiscafé', value: 'eiscafe' },
  { label: 'Friseur / Salon', value: 'friseur' },
  { label: 'Fitness / Gym', value: 'fitnessstudio' },
  { label: 'Yoga-Studio', value: 'yoga' },
  { label: 'Anderes', value: 'cafe' },
]

const brancheChips = [
  { label: 'Cafés', href: '/koeln/innenstadt/cafes', rot: -1 },
  { label: 'Döner & Imbiss', href: '/koeln/innenstadt/doener', rot: 0 },
  { label: 'Pizza & Restaurant', href: '/koeln/innenstadt/pizza', rot: 1 },
  { label: 'Eiscafés', href: '/koeln/innenstadt/eiscafe', rot: 0 },
  { label: 'Bäckereien', href: '/koeln/innenstadt/baeckerei', rot: -1 },
  { label: 'Friseur & Salon', href: '/koeln/innenstadt/friseur', rot: 0 },
  { label: 'Fitness & Gym', href: '/koeln/innenstadt/fitnessstudio', rot: 0.8 },
  { label: 'Yoga-Studios', href: '/koeln/innenstadt/yoga', rot: 0 },
]

const staedte = [
  ['Köln', '/koeln'], ['Berlin', '/berlin'], ['Hamburg', '/hamburg'], ['München', '/muenchen'],
  ['Frankfurt', '/frankfurt'], ['Düsseldorf', '/duesseldorf'], ['Stuttgart', '/stuttgart'], ['Leipzig', '/leipzig'],
  ['Bonn', '/bonn'], ['Dortmund', '/dortmund'], ['Essen', '/essen'], ['Hannover', '/hannover'],
]

const faqs = [
  { q: 'Brauchen meine Kund:innen eine App?', a: 'Nein. Die digitale Stempelkarte liegt direkt in Apple Wallet oder Google Wallet – ein Tipp, gespeichert. Kein App-Download, kein Konto, kein Plastik.' },
  { q: 'Wie schnell bin ich startklar?', a: 'In der Regel innerhalb von 24 Stunden. Du schickst uns Name, Branche und Kontakt – wir bauen deine Kundenkarte mit deinem Logo und deiner Belohnung und melden uns.' },
  { q: 'Was kostet bonuskarte.digital?', a: 'Ab 29 € im Monat. Die ersten 90 Tage sind kostenlos, ganz ohne Kreditkarte. Keine Einrichtungsgebühr, monatlich kündbar.' },
  { q: 'Wie geben meine Kund:innen Stempel ab?', a: 'Du oder dein Team vergebt Stempel mit einem Tipp im Dashboard oder per Code-Scan an der Theke. Die Treuekarte in der Wallet aktualisiert sich sofort.' },
  { q: 'Ist das DSGVO-konform?', a: 'Ja. Hosting in Deutschland, Datenverarbeitung nach DSGVO. Wir sind keine Marketing-Plattform – wir sammeln keine Daten, die du nicht brauchst.' },
  { q: 'Kann ich mein eigenes Logo und Design nutzen?', a: 'Ja. Deine Karte, dein Logo, deine Farben, deine Belohnung. Die Bonuskarte sieht aus wie dein Laden – nicht wie eine Software.' },
]

const steps = [
  { t: '1 · Du meldest dich', d: 'Drei Felder ausfüllen. Das war dein Teil.', z: '2 Min' },
  { t: '2 · Wir bauen deine Karte', d: 'Logo, Farben, Belohnung – fertig eingerichtet.', z: '24 h' },
  { t: '3 · Gäste speichern sie', d: 'Ein Tipp – ab in Apple oder Google Wallet.', z: '1 Tipp' },
  { t: '4 · Stempeln & wiederkommen', d: 'Du vergibst Stempel, sie kommen zurück.', z: '∞' },
]
---

<BaseLayout
  title="Digitale Stempelkarte für Cafés & lokale Geschäfte · bonuskarte.digital"
  description="Die digitale Stempelkarte für lokale Geschäfte: Bonuskarte & Kundenkarte direkt in Apple Wallet und Google Wallet – kein App-Download, kein Plastik. Mehr Stammkunden, live in 24 h. 90 Tage kostenlos, ab 29 €/Monat, DSGVO-konform."
  canonical="https://bonuskarte.digital/"
  showStickyCta={false}
>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Zilla+Slab:wght@400;500;600;700&family=Caveat:wght@500;600;700&display=swap" />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({
      "@type": "Question", "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  })} />

  <div class="v2">

    <!-- ═══ HEADER ═══ -->
    <header class="v2-header">
      <div class="v2-header-inner">
        <a href="/" aria-label="bonuskarte.digital – Startseite" style="display:flex;align-items:center;flex-shrink:0">
          <img src="/brand/lockup-horizontal-primary.svg" alt="bonuskarte.digital" width="192" height="30" style="height:30px;width:auto;display:block" />
        </a>
        <nav aria-label="Hauptnavigation" style="display:flex;align-items:center;gap:26px">
          <span class="v2-navlinks">
            <a href="#ausprobieren" class="v2-navlink">Ausprobieren</a>
            <a href="#so-laeufts" class="v2-navlink">So läuft's</a>
            <a href="#preis" class="v2-navlink">Preis</a>
            <a href="#branchen" class="v2-navlink">Branchen</a>
            <a href="#faq" class="v2-navlink">FAQ</a>
          </span>
          <button type="button" class="v2-btn v2-btn-sm" data-scroll-to-form>Kostenlos testen</button>
        </nav>
      </div>
    </header>

    <main>
      <!-- ═══ HERO ═══ -->
      <section style="position:relative;padding:clamp(40px,7vw,84px) 24px clamp(56px,8vw,96px)">
        <div aria-hidden="true" style="position:absolute;top:8%;right:6%;width:190px;height:190px;border-radius:50%;border:6px solid rgba(242,92,36,0.10);pointer-events:none"></div>
        <div aria-hidden="true" style="position:absolute;bottom:10%;left:4%;width:120px;height:120px;border-radius:50%;border:2px dashed var(--v2-ink-14);pointer-events:none"></div>

        <div style="max-width:1200px;margin:0 auto;display:flex;flex-wrap:wrap;gap:clamp(32px,5vw,72px);align-items:flex-start">
          <div style="flex:1 1 440px;min-width:300px;padding-top:clamp(8px,3vw,40px)">
            <p class="v2-kicker">Apple Wallet · Google Wallet</p>
            <h1 style="font-family:'Zilla Slab',Georgia,serif;font-weight:600;font-size:clamp(38px,6.2vw,72px);line-height:1.02;letter-spacing:-0.02em;margin:0;color:var(--v2-ink);text-wrap:balance">Die digitale Stempelkarte für <span style="color:var(--v2-accent);white-space:nowrap">deinen Laden</span>.</h1>
            <p style="font-size:clamp(17px,2.2vw,21px);line-height:1.5;color:var(--v2-ink-72);margin:22px 0 0;max-width:30ch">Mehr Stammkund:innen, kein Papier, keine App. Deine Gäste sammeln Stempel direkt in ihrer Wallet – du gewinnst Wiederkommer.</p>

            <div class="v2-trustrow" style="margin-top:26px">
              <span>90 Tage kostenlos</span><span aria-hidden="true" style="color:var(--v2-accent)">·</span>
              <span>keine Kreditkarte</span><span aria-hidden="true" style="color:var(--v2-accent)">·</span>
              <span>live in 24 h</span><span aria-hidden="true" style="color:var(--v2-accent)">·</span>
              <span>DSGVO</span>
            </div>

            <div style="margin-top:34px;display:flex;align-items:flex-start;gap:14px;max-width:380px">
              <span style="font-family:'Caveat',cursive;font-size:22px;color:var(--v2-accent);line-height:1.1;transform:rotate(-4deg);flex-shrink:0;padding-top:2px">3 Felder,<br />2 Minuten →</span>
              <p style="font-size:14px;color:var(--v2-ink-56);line-height:1.5;margin:0">Sag uns kurz, wer du bist. Den Rest – Karte bauen, Logo einsetzen, in die Wallet bringen – machen wir.</p>
            </div>
          </div>

          <!-- Bestellzettel (Formular A) -->
          <div style="flex:1 1 380px;min-width:300px;max-width:460px" id="lead">
            <div style="position:relative;transform:rotate(-1.1deg)">
              <div aria-hidden="true" style="position:absolute;top:-11px;left:50%;transform:translateX(-50%);width:22px;height:22px;border-radius:50%;background:var(--v2-accent);box-shadow:var(--v2-shadow-md);z-index:2"></div>
              <div style="background:var(--v2-white);border:1px solid var(--v2-border);border-radius:20px;box-shadow:var(--v2-shadow-lg);padding:28px clamp(22px,4vw,34px) 30px;overflow:hidden">
                <div aria-hidden="true" style="display:flex;justify-content:center;gap:9px;margin:-6px 0 18px">
                  <span class="v2-perf"></span><span class="v2-perf"></span><span class="v2-perf"></span><span class="v2-perf"></span><span class="v2-perf"></span>
                </div>

                <form class="v2-leadform" data-form-id="hero" style="display:flex;flex-direction:column">
                  <div style="display:flex;align-items:baseline;justify-content:space-between;border-bottom:1.5px dashed var(--v2-ink-24);padding-bottom:12px;margin-bottom:20px">
                    <h2 style="font-family:'Zilla Slab',Georgia,serif;font-size:22px;font-weight:600;margin:0;letter-spacing:-0.01em">Bestellzettel</h2>
                    <span class="v2-mono" style="font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:var(--v2-ink-40)">Nr. 24H</span>
                  </div>
                  <p style="font-family:'Caveat',cursive;font-size:20px;color:var(--v2-ink-72);margin:-8px 0 20px">3 Felder, 2 Minuten – wir machen den Rest.</p>

                  <label style="display:block;margin-bottom:18px">
                    <span class="v2-label">Name des Betriebs</span>
                    <input class="v2-input" type="text" name="betrieb" required autocomplete="organization" placeholder="z. B. Café Hügel" />
                  </label>
                  <label style="display:block;margin-bottom:18px">
                    <span class="v2-label">Branche</span>
                    <select class="v2-input v2-select" name="branche" required>
                      <option value="">Bitte wählen …</option>
                      {branchen.map(b => <option value={b.value}>{b.label}</option>)}
                    </select>
                  </label>
                  <label style="display:block;margin-bottom:24px">
                    <span class="v2-label">Handynummer oder E-Mail</span>
                    <input class="v2-input" type="text" name="kontakt" required autocomplete="tel" placeholder="0176 … oder du@laden.de" />
                  </label>

                  <p class="v2-formerror" hidden>Etwas ist schiefgelaufen. Bitte versuche es erneut – oder schreib uns direkt auf WhatsApp.</p>
                  <button type="submit" class="v2-btn v2-btn-lg" style="width:100%">Kostenlos starten</button>
                  <p style="text-align:center;font-size:12.5px;color:var(--v2-ink-56);margin:14px 0 0;line-height:1.5">Keine Kreditkarte. Wir melden uns innerhalb von 24 h.</p>
                </form>

                <div class="v2-success" hidden style="text-align:center;padding:14px 0 6px">
                  <div style="width:64px;height:64px;border-radius:50%;background:var(--v2-accent);display:inline-flex;align-items:center;justify-content:center;margin-bottom:18px;box-shadow:var(--v2-shadow-md)">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#F6F1E8" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                  </div>
                  <h2 style="font-family:'Zilla Slab',Georgia,serif;font-size:24px;font-weight:600;margin:0 0 8px;letter-spacing:-0.01em">Angekommen.</h2>
                  <p style="font-size:15px;color:var(--v2-ink-72);line-height:1.55;margin:0 auto 18px;max-width:32ch">Danke! Wir melden uns innerhalb von 24 Stunden – meist schneller. Lade dir schon mal deine Demo-Karte ins Wallet:</p>
                  <a class="v2-btn v2-btn-lg v2-installlink" href="#" target="_blank" rel="noopener noreferrer" hidden style="width:100%;box-sizing:border-box;margin-bottom:14px">Demo-Karte ins Wallet laden</a>
                  <p style="font-size:13px;color:var(--v2-ink-56);margin:0 0 10px">Lieber sofort quatschen?</p>
                  <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="v2-ghostbtn">Auf WhatsApp schreiben</a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ═══ INTERAKTIVE DEMO ═══ -->
      <section id="ausprobieren" style="padding:clamp(56px,8vw,104px) 24px;border-top:1px solid var(--v2-border)">
        <div style="max-width:1200px;margin:0 auto;display:flex;flex-wrap:wrap;gap:clamp(32px,5vw,64px);align-items:center">
          <div style="flex:1 1 320px;min-width:280px;position:relative">
            <div aria-hidden="true" style="position:absolute;top:-16px;left:-10px;width:150px;height:150px;border-radius:50%;border:5px solid rgba(242,92,36,0.10)"></div>
            <img src="/images/mockup-coffee.png" alt="Digitale Stempelkarte in Apple Wallet auf einem iPhone" loading="lazy"
              style="display:block;width:100%;max-width:420px;margin:0 auto;border-radius:24px;transform:rotate(1.2deg)" />
          </div>

          <div style="flex:1 1 360px;min-width:300px">
            <p class="v2-kicker">Zum Ausprobieren</p>
            <h2 class="v2-h2">Tipp drauf. So fühlt sich Sammeln an.</h2>
            <p style="font-size:17px;line-height:1.6;color:var(--v2-ink-72);margin:0 0 26px;max-width:42ch">Genau das erleben deine Stammkund:innen – nur echt, in ihrer Wallet. Fünfmal tippen, und die Belohnung ist frei.</p>

            <div role="button" tabindex="0" aria-label="Stempel hinzufügen" id="demo-card"
              style="position:relative;cursor:pointer;background:var(--v2-white);border:1px solid var(--v2-border);border-radius:28px;box-shadow:var(--v2-shadow-md);padding:28px;user-select:none">
              <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:22px">
                <div>
                  <div style="font-weight:600;font-size:17px">Café Hügel</div>
                  <div class="v2-mono" style="font-size:11px;letter-spacing:0.06em;text-transform:uppercase;color:var(--v2-ink-40)">Stempelkarte</div>
                </div>
                <span aria-hidden="true" style="display:inline-flex"><span style="width:16px;height:16px;border-radius:50%;border:2px solid var(--v2-ink-40);box-sizing:border-box"></span><span style="width:16px;height:16px;border-radius:50%;background:var(--v2-accent);margin-left:-6px"></span></span>
              </div>

              <div id="demo-stamps" style="display:grid;grid-template-columns:repeat(5,1fr);gap:12px;max-width:360px">
                {[0,1,2,3,4].map(() => (
                  <span class="v2-stamp" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#F6F1E8" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                  </span>
                ))}
              </div>

              <div id="demo-reward" hidden style="margin-top:22px;display:flex;align-items:center;gap:12px;background:var(--v2-amber-tint);border-radius:14px;padding:14px 16px">
                <span style="width:34px;height:34px;border-radius:50%;background:var(--v2-accent);display:inline-flex;align-items:center;justify-content:center;flex-shrink:0"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F6F1E8" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
                <div><div style="font-weight:600;font-size:15px;color:var(--v2-ink)">Gratis Kaffee – freigeschaltet.</div><div style="font-size:12.5px;color:var(--v2-ink-56)">Nochmal tippen für einen neuen Durchlauf.</div></div>
              </div>
              <p id="demo-hint" style="font-family:'Caveat',cursive;font-size:20px;color:var(--v2-accent);margin:20px 0 0;text-align:center;animation:bk-nudge 2s ease-in-out infinite">↑ noch <span id="demo-left">5</span>× tippen</p>
            </div>
          </div>
        </div>
      </section>

      <!-- ═══ VORHER / NACHHER ═══ -->
      <section style="padding:clamp(56px,8vw,104px) 24px;background:var(--v2-sunken)">
        <div style="max-width:920px;margin:0 auto;text-align:center">
          <p class="v2-kicker">Vom Papier in die Hosentasche</p>
          <h2 style="font-family:'Zilla Slab',Georgia,serif;font-weight:600;font-size:clamp(26px,3.6vw,40px);line-height:1.2;letter-spacing:-0.01em;margin:0 auto 40px;max-width:24ch;text-wrap:balance">Die Papierkarte lag im Portemonnaie, bis sie durchweichte. Die neue wohnt im Handy.</h2>

          <div style="display:flex;flex-wrap:wrap;gap:clamp(28px,5vw,56px);align-items:center;justify-content:center">
            <div aria-hidden="true" style="flex:0 0 auto;position:relative;transform:rotate(-3deg)">
              <div style="width:230px;background:#EFE7D6;border:1px solid var(--v2-ink-14);border-radius:8px;padding:18px 18px 16px;box-shadow:var(--v2-shadow-sm);opacity:0.85">
                <div style="font-family:'Caveat',cursive;font-size:19px;color:var(--v2-ink-72);margin-bottom:12px;text-align:left">Stammkarte</div>
                <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:8px">
                  {[...Array(10)].map((_, i) => (
                    <span style={`aspect-ratio:1;border-radius:50%;border:1.5px ${i < 2 ? 'solid var(--v2-ink-40);background:rgba(242,92,36,0.5)' : 'dashed var(--v2-ink-24)'}`}></span>
                  ))}
                </div>
              </div>
              <div style="position:absolute;bottom:-8px;right:-8px;width:60px;height:60px;border-radius:50%;border:3px solid rgba(26,20,16,0.12)"></div>
            </div>

            <span aria-hidden="true" style="font-family:'Caveat',cursive;font-size:26px;color:var(--v2-accent);transform:rotate(-4deg)">wird zu →</span>

            <!-- Wallet-Pass (hell) -->
            <div class="v2-pass v2-pass-light" style="transform:rotate(2deg)">
              <div class="v2-pass-head">
                <div>
                  <div style="font-weight:600;font-size:16px">Café Hügel</div>
                  <div class="v2-mono v2-pass-sub">Treuekarte</div>
                </div>
                <span aria-hidden="true" style="display:inline-flex"><span style="width:14px;height:14px;border-radius:50%;border:2px solid currentColor;opacity:0.4;box-sizing:border-box"></span><span style="width:14px;height:14px;border-radius:50%;background:var(--v2-accent);margin-left:-5px"></span></span>
              </div>
              <div class="v2-pass-grid">
                {[...Array(10)].map(() => <span class="v2-pass-stamp v2-pass-stamp-filled"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#F6F1E8" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>)}
              </div>
              <div class="v2-pass-foot">
                <span style="font-weight:600;font-size:13.5px;color:var(--v2-accent)">Gratis Kaffee</span>
                <span class="v2-mono" style="font-size:10.5px;letter-spacing:0.08em;opacity:0.5">BK-7F2A-9X</span>
              </div>
              <div class="v2-pass-barcode" aria-hidden="true"></div>
            </div>
          </div>

          <p style="font-size:17px;line-height:1.65;color:var(--v2-ink-72);margin:44px auto 0;max-width:56ch;text-wrap:pretty">Kein Verlieren, kein Nachdrucken, kein „Ich hatte die Karte gerade nicht dabei". Die Treuekarte ist immer da – und du siehst, wer wiederkommt.</p>
        </div>
      </section>

      <!-- ═══ DUNKLE WALLET-SEKTION (Scroll-Stempel) ═══ -->
      <section style="background:var(--v2-ink);color:var(--v2-paper);padding:clamp(64px,9vw,120px) 24px;position:relative;overflow:hidden">
        <div aria-hidden="true" style="position:absolute;top:-40px;right:-40px;width:260px;height:260px;border-radius:50%;border:2px solid rgba(246,241,232,0.10)"></div>
        <div style="max-width:1200px;margin:0 auto;display:flex;flex-wrap:wrap;gap:clamp(36px,6vw,80px);align-items:center">
          <div style="flex:1 1 380px;min-width:300px">
            <p class="v2-kicker">In der Wallet, wo alle schon sind</p>
            <h2 style="font-family:'Zilla Slab',Georgia,serif;font-weight:600;font-size:clamp(34px,5.5vw,60px);line-height:1.02;letter-spacing:-0.02em;margin:0 0 22px;color:var(--v2-paper)">Sammeln.<br />Belohnen.<br />Im Handy.</h2>
            <p style="font-size:18px;line-height:1.6;color:rgba(246,241,232,0.72);margin:0 0 12px;max-width:44ch">Die Karte liegt neben Bordkarte und Bankkarte – dort, wo dein Gast jeden Tag ohnehin hinschaut. Jeder Stempel landet automatisch drin, jede volle Karte wird zur Einladung, wiederzukommen.</p>
            <p style="font-family:'Caveat',cursive;font-size:22px;color:var(--v2-accent);margin:22px 0 0">↓ scroll weiter – wir stempeln mit</p>
          </div>
          <div style="flex:0 0 auto;margin:0 auto" id="scroll-pass">
            <div class="v2-pass v2-pass-dark">
              <div class="v2-pass-head">
                <div>
                  <div style="font-weight:600;font-size:16px">Café Hügel</div>
                  <div class="v2-mono v2-pass-sub">Treuekarte</div>
                </div>
                <span aria-hidden="true" style="display:inline-flex"><span style="width:14px;height:14px;border-radius:50%;border:2px solid currentColor;opacity:0.4;box-sizing:border-box"></span><span style="width:14px;height:14px;border-radius:50%;background:var(--v2-accent);margin-left:-5px"></span></span>
              </div>
              <div class="v2-pass-grid" id="scroll-stamps">
                {[...Array(10)].map(() => <span class="v2-pass-stamp"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#F6F1E8" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>)}
              </div>
              <div class="v2-pass-foot">
                <span style="font-weight:600;font-size:13.5px;color:var(--v2-accent)">Gratis Kaffee</span>
                <span class="v2-mono" style="font-size:10.5px;letter-spacing:0.08em;opacity:0.5">BK-7F2A-9X</span>
