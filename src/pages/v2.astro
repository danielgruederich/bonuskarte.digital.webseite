---
// A/B-Test-Variante der Startseite — Redesign "Bestellzettel + Wallet-Demo" (Juli 2026).
// Portiert aus dem Design-Export (Homepage.dc.html); Formulare laufen über /api/submit.php
// (Salesflare + Boomerang + Telegram + Sheets + MailerCloud).
// Canonical zeigt auf / — diese Seite konsolidiert alle SEO-Signale aufs Original
// und ist aus der Sitemap ausgeschlossen (astro.config.mjs).
import BaseLayout from '../layouts/BaseLayout.astro'
import StampGridV2 from '../components/StampGridV2.astro'

const whatsappUrl = 'https://wa.me/491705594140?text=Hallo%2C%20ich%20interessiere%20mich%20f%C3%BCr%20bonuskarte.digital'

// Anzeige-Label → Template-Key für submit.php (TEMPLATE_IDS)
const branchen = [
  { label: 'Café', value: 'cafe' },
  { label: 'Bäckerei', value: 'baeckerei' },
  { label: 'Döner / Imbiss', value: 'doener' },
  { label: 'Pizzeria / Restaurant', value: 'pizza' },
  { label: 'Eiscafé', value: 'eiscafe' },
  { label: 'Friseur / Salon', value: 'friseur' },
  { label: 'Fitness / Gym', value: 'fitnessstudio' },
  { label: 'Yoga-Studio', value: 'yoga' },
  { label: 'Anderes', value: 'cafe' },
]

const faqs = [
  { q: 'Brauchen meine Kund:innen eine App?', a: 'Nein. Die Karte liegt direkt in Apple Wallet oder Google Wallet – beides ist auf jedem Smartphone schon installiert. Ein Tipp, gespeichert. Kein Download, kein Plastik.' },
  { q: 'Müssen sich meine Kund:innen registrieren?', a: 'Nein. Kein Konto, kein Passwort, keine E-Mail-Pflicht. Deine Gäste speichern die Karte mit einem Tipp – das ist alles.' },
  { q: 'Funktioniert das auch mit älteren Kund:innen?', a: 'Ja. Gerade weil keine neue App nötig ist: Apple und Google Wallet sind auf dem Handy vorinstalliert. Karte antippen, speichern, fertig – kein Technik-Wissen nötig.' },
  { q: 'Was passiert nach den 90 Tagen?', a: 'Du entscheidest selbst. Keine automatische Verlängerung, kein versteckter Vertrag – wir melden uns vorher. Danach ab 29 € im Monat, monatlich kündbar.' },
  { q: 'Wie schnell bin ich startklar?', a: 'In der Regel innerhalb von 24 Stunden. Du schickst uns Name, Branche und Kontakt – wir bauen dein Stammkunden-System mit deinem Logo und deiner Belohnung und melden uns.' },
  { q: 'Ist das DSGVO-konform?', a: 'Ja. Server in Deutschland, Datenverarbeitung nach DSGVO. Wir sind keine Marketing-Plattform – wir sammeln keine Daten, die du nicht brauchst.' },
]

const softwareLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'bonuskarte.digital',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Apple Wallet, Google Wallet, Web',
  description: 'Das einfache Stammkunden-System für lokale Betriebe – macht aus Erstbesuchern regelmäßige Kunden, direkt in Apple Wallet und Google Wallet, ohne App-Download.',
  url: 'https://bonuskarte.digital/',
  offers: { '@type': 'Offer', price: '29', priceCurrency: 'EUR', description: 'ab 29 € pro Monat, 90 Tage kostenlos testen' },
  publisher: { '@type': 'Organization', name: 'fuerte.digital', brand: 'bonuskarte.digital' },
}
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
}

// Formularfeld-Unterstrich als wiederverwendbarer Style
const fieldStyle = 'width:100%;box-sizing:border-box;border:none;border-bottom:1.5px solid var(--ink-24);background:transparent;padding:8px 2px;font-family:var(--font-sans);font-size:16px;color:var(--v2-ink);outline:none'
const selectChevron = `background-image:url('data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%2214%22 height=%2214%22 fill=%22none%22 stroke=%22%231A1410%22 stroke-width=%222.4%22 stroke-linecap=%22round%22%3E%3Cpath d=%22m6 9 6 6 6-6%22/%3E%3C/svg%3E');background-repeat:no-repeat;background-position:right 2px center`
---

<BaseLayout
  title="Aus Erstbesuchern werden Stammkunden | bonuskarte.digital"
  description="Das einfache Stammkunden-System für lokale Betriebe – direkt in Apple & Google Wallet. Aus einmaligen Gästen werden regelmäßige Kunden: ohne App, ohne Papierkarte, ohne Aufwand. 90 Tage kostenlos, ab 29 €/Monat, DSGVO-konform."
  canonical="https://bonuskarte.digital/"
  showStickyCta={false}
>
  <script type="application/ld+json" set:html={JSON.stringify(softwareLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Zilla+Slab:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Caveat:wght@500;600;700&display=swap" />

  <style is:global>
    /* ── Design-Tokens (Redesign Juli 2026) ─────────────────────────── */
    .bk-v2 {
      --amber: #F25C24;
      --v2-ink: #1A1410;
      --v2-paper: #F6F1E8;
      --white: #FFFFFF;
      --amber-press: #D44E1A;
      --amber-hover: #E2531F;
      --amber-tint: #FBE4D8;
      --amber-ring: rgba(242, 92, 36, 0.35);
      --ink-90: rgba(26,20,16,0.90); --ink-72: rgba(26,20,16,0.72); --ink-56: rgba(26,20,16,0.56);
      --ink-40: rgba(26,20,16,0.40); --ink-24: rgba(26,20,16,0.24); --ink-14: rgba(26,20,16,0.14);
      --ink-08: rgba(26,20,16,0.08); --ink-04: rgba(26,20,16,0.04);
      --paper-72: rgba(246,241,232,0.72); --paper-56: rgba(246,241,232,0.56);
      --paper-16: rgba(246,241,232,0.16); --paper-10: rgba(246,241,232,0.10);
      --ink-raised: #241D17; --ink-line: #322A22;
      --surface-sunken: #EFE8DB;
      --accent: var(--amber); --border: var(--ink-14); --border-strong: var(--ink-24); --border-ink: var(--ink-line);
      --radius-md: 14px; --radius-lg: 20px;
      --shadow-sm: 0 2px 6px rgba(26,20,16,0.07);
      --shadow-md: 0 6px 18px rgba(26,20,16,0.09);
      --shadow-lg: 0 16px 40px rgba(26,20,16,0.12);
      --shadow-amber: 0 8px 22px rgba(242,92,36,0.28);
      --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
      --ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);
      --font-sans: 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      --font-mono: 'Geist Mono', ui-monospace, 'SF Mono', Menlo, monospace;
      --font-serif: 'Zilla Slab', Georgia, serif;
      --font-hand: 'Caveat', cursive;
      font-family: var(--font-sans);
      background: var(--v2-paper);
      color: var(--v2-ink);
    }
    .bk-v2 ::selection { background: var(--amber-tint); }

    @keyframes bk-thunk { 0% { transform: scale(0.55) rotate(-8deg); opacity: 0; } 60% { opacity: 1; } 100% { transform: scale(1) rotate(0); opacity: 1; } }
    @keyframes bk-rise { from { transform: translateY(14px); opacity: 0; } to { transform: none; opacity: 1; } }
    @keyframes bk-nudge { 0%,100% { transform: translateX(0); } 50% { transform: translateX(5px); } }
    @keyframes bk-stamp { 0% { transform: scale(2.1) rotate(-12deg); opacity: 0; } 55% { transform: scale(0.94) rotate(2deg); opacity: 1; } 75% { transform: scale(1.03); } 100% { transform: scale(1) rotate(0); } }
    @keyframes bk-notif { from { transform: translateY(-130%); opacity: 0; } to { transform: none; opacity: 1; } }

    /* Stempel: gefüllt/leer wird per Klasse getoggelt */
    .bk-stamp .bk-stamp-on { display: none; }
    .bk-stamp.is-filled .bk-stamp-on { display: block; animation: bk-stamp 0.38s var(--ease-out) both; }
    .bk-stamp.is-filled .bk-stamp-off { display: none; }

    /* Buttons (Design-System "primary") */
    .bk-btn {
      display: inline-flex; align-items: center; justify-content: center;
      background: var(--accent); color: var(--v2-paper); border: none; cursor: pointer;
      font-family: var(--font-sans); font-weight: 600; text-decoration: none;
      border-radius: var(--radius-md); transition: background 0.15s ease;
    }
    .bk-btn:hover { background: var(--amber-hover); }
    .bk-btn:active { background: var(--amber-press); }
    .bk-btn:focus-visible { outline: none; box-shadow: 0 0 0 3px var(--amber-ring); }
    .bk-btn--sm { height: 36px; padding: 0 16px; font-size: 14px; }
    .bk-btn--md { height: 44px; padding: 0 20px; font-size: 15px; }
    .bk-btn--lg { height: 54px; padding: 0 24px; font-size: 16.5px; width: 100%; box-shadow: var(--shadow-amber); }

    /* Hover/Focus aus dem Design (style-hover / style-focus) */
    .bk-navlink { font-size: 15px; font-weight: 500; color: var(--ink-72); text-decoration: none; }
    .bk-navlink:hover { color: var(--v2-ink); }
    .bk-footlink { color: var(--paper-72); text-decoration: none; font-size: 14px; }
    .bk-footlink:hover { color: var(--v2-paper); }
    .bk-field:focus { border-bottom-color: var(--accent) !important; }
    .bk-whatsapp:hover { background: var(--ink-04); }
    .bk-faqlink:hover { text-decoration: underline; }

    .bk-v2 details > summary { list-style: none; }
    .bk-v2 details > summary::-webkit-details-marker { display: none; }
    .bk-v2 details[open] .bk-faq-plus { transform: rotate(45deg); }
    .bk-faq-plus { display: inline-block; transition: transform 0.2s ease; }

    /* Responsive: Nav-Links nur Desktop, Sticky-CTA nur Mobile */
    .bk-sticky { display: none; }
    @media (max-width: 819px) {
      .bk-nav-links { display: none !important; }
      .bk-sticky:not(.is-hidden) { display: flex; }
    }

    /* hidden-Attribut muss auch gegen Inline-display gewinnen */
    .bk-v2 [hidden] { display: none !important; }

    .bk-form-error { display: none; font-size: 13.5px; color: #B23A2B; margin: 12px 0 0; text-align: center; line-height: 1.5; }
    .bk-form-error.is-visible { display: block; }
    .bk-submitting { opacity: 0.65; pointer-events: none; }

    @media (prefers-reduced-motion: reduce) {
      .bk-v2 *, .bk-v2 *::before, .bk-v2 *::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
    }
  </style>

  <div class="bk-v2" style="overflow-x:hidden;position:relative">

    <!-- ======================= HEADER ======================= -->
    <header style="position:sticky;top:0;z-index:60;background:rgba(246,241,232,0.82);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:1px solid var(--border)">
      <div style="max-width:1200px;margin:0 auto;padding:14px 24px;display:flex;align-items:center;justify-content:space-between;gap:24px">
        <a href="/" aria-label="bonuskarte.digital – Startseite" style="display:flex;align-items:center;flex-shrink:0">
          <img src="/images/v2/lockup-horizontal-primary.svg" alt="bonuskarte.digital" width="192" height="30" style="height:30px;width:auto;display:block" />
        </a>
        <nav aria-label="Hauptnavigation" style="display:flex;align-items:center;gap:26px">
          <span class="bk-nav-links" style="display:flex;align-items:center;gap:26px">
            <a href="#ausprobieren" class="bk-navlink">Ausprobieren</a>
            <a href="#so-laeufts" class="bk-navlink">So läuft's</a>
            <a href="#preis" class="bk-navlink">Preis</a>
            <a href="#faq" class="bk-navlink">FAQ</a>
          </span>
          <button type="button" class="bk-btn bk-btn--sm" data-scroll-to-form>Demo-Karte erstellen</button>
        </nav>
      </div>
    </header>

    <main>
      <!-- ======================= HERO ======================= -->
      <section style="position:relative;padding:clamp(40px,7vw,84px) 24px clamp(56px,8vw,96px)">
        <div aria-hidden="true" style="position:absolute;top:8%;right:6%;width:190px;height:190px;border-radius:50%;border:6px solid rgba(242,92,36,0.10);pointer-events:none"></div>
        <div aria-hidden="true" style="position:absolute;bottom:10%;left:4%;width:120px;height:120px;border-radius:50%;border:2px dashed var(--ink-14);pointer-events:none"></div>

        <div style="max-width:1200px;margin:0 auto;display:flex;flex-wrap:wrap;gap:clamp(32px,5vw,72px);align-items:flex-start">
          <!-- copy column -->
          <div style="flex:1 1 440px;min-width:300px;padding-top:clamp(8px,3vw,40px)">
            <p style="font-family:var(--font-mono);font-size:12px;letter-spacing:0.14em;text-transform:uppercase;color:var(--accent);font-weight:500;margin:0 0 22px">Stammkunden-System · Apple &amp; Google Wallet</p>
            <h1 style="font-family:var(--font-serif);font-weight:600;font-size:clamp(38px,6.2vw,72px);line-height:1.02;letter-spacing:-0.02em;margin:0;color:var(--v2-ink);text-wrap:balance">Aus Erstbesuchern werden <span style="color:var(--accent);position:relative;white-space:nowrap">Stammkunden</span>.</h1>
            <p style="font-size:clamp(17px,2.2vw,21px);line-height:1.5;color:var(--ink-72);margin:22px 0 0;max-width:42ch">Wir helfen lokalen Betrieben, dass Gäste häufiger wiederkommen – mit einem einfachen Stammkunden-System direkt im Apple &amp; Google Wallet. Ohne App, ohne Papierkarte, ohne Aufwand.</p>

            <div style="margin-top:26px;display:flex;flex-wrap:wrap;align-items:center;gap:10px 18px;font-family:var(--font-mono);font-size:12.5px;letter-spacing:0.04em;color:var(--ink-56)">
              <span>In 30 Sekunden ausprobieren</span><span aria-hidden="true" style="color:var(--accent)">·</span>
              <span>Einrichtung inklusive</span><span aria-hidden="true" style="color:var(--accent)">·</span>
              <span>90 Tage kostenlos</span><span aria-hidden="true" style="color:var(--accent)">·</span>
              <span>monatlich kündbar</span>
            </div>

            <div style="margin-top:34px;display:flex;align-items:flex-start;gap:14px;max-width:380px">
              <span style="font-family:var(--font-hand);font-size:22px;color:var(--accent);line-height:1.1;transform:rotate(-4deg);flex-shrink:0;padding-top:2px">3 Felder,<br />2 Minuten →</span>
              <p style="font-size:14px;color:var(--ink-56);line-height:1.5;margin:0">Sag uns kurz, wer du bist. Den Rest – Karte bauen, Logo einsetzen, in die Wallet bringen – machen wir.</p>
            </div>
          </div>

          <!-- lead form (Bestellzettel) -->
          <div style="flex:1 1 380px;min-width:300px;max-width:460px" id="lead">
            <div style="position:relative;transform:rotate(-1.1deg)">
              <div aria-hidden="true" style="position:absolute;top:-11px;left:50%;transform:translateX(-50%);width:22px;height:22px;border-radius:50%;background:var(--accent);box-shadow:var(--shadow-md);z-index:2"></div>
              <div style="background:var(--white);border:1px solid var(--border);border-radius:var(--radius-lg);box-shadow:var(--shadow-lg);padding:28px clamp(22px,4vw,34px) 30px;overflow:hidden">
                <div aria-hidden="true" style="display:flex;justify-content:center;gap:9px;margin:-6px 0 18px">
                  <span style="width:6px;height:6px;border-radius:50%;background:var(--surface-sunken)"></span><span style="width:6px;height:6px;border-radius:50%;background:var(--surface-sunken)"></span><span style="width:6px;height:6px;border-radius:50%;background:var(--surface-sunken)"></span><span style="width:6px;height:6px;border-radius:50%;background:var(--surface-sunken)"></span><span style="width:6px;height:6px;border-radius:50%;background:var(--surface-sunken)"></span>
                </div>

                <form data-bk-form="a" novalidate style="display:flex;flex-direction:column">
                  <div style="display:flex;align-items:baseline;justify-content:space-between;border-bottom:1.5px dashed var(--ink-24);padding-bottom:12px;margin-bottom:20px">
                    <h2 style="font-family:var(--font-serif);font-size:22px;font-weight:600;margin:0;letter-spacing:-0.01em">Bestellzettel</h2>
                    <span style="font-family:var(--font-mono);font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:var(--ink-40);text-align:right;flex-shrink:0;margin-left:16px;max-width:42%;line-height:1.5">Wir liefern innerhalb von 24 h</span>
                  </div>
                  <p style="font-family:var(--font-hand);font-size:20px;color:var(--ink-72);margin:-8px 0 20px">3 Felder, 2 Minuten – wir machen den Rest.</p>

                  <label style="display:block;margin-bottom:18px">
                    <span style="display:block;font-size:13px;font-weight:600;color:var(--v2-ink);margin-bottom:2px">Name des Betriebs</span>
                    <input type="text" name="betrieb" required autocomplete="organization" placeholder="z. B. dein Café" class="bk-field" style={fieldStyle} />
                  </label>

                  <label style="display:block;margin-bottom:18px">
                    <span style="display:block;font-size:13px;font-weight:600;color:var(--v2-ink);margin-bottom:2px">Branche</span>
                    <select name="branche" required class="bk-field" style={`${fieldStyle};appearance:none;-webkit-appearance:none;cursor:pointer;${selectChevron}`}>
                      <option value="">Bitte wählen …</option>
                      {branchen.map(b => <option value={b.value}>{b.label}</option>)}
                    </select>
                  </label>

                  <label style="display:block;margin-bottom:24px">
                    <span style="display:block;font-size:13px;font-weight:600;color:var(--v2-ink);margin-bottom:2px">Handynummer oder E-Mail</span>
                    <input type="text" name="kontakt" required autocomplete="tel email" inputmode="text" placeholder="0176 … oder du@laden.de" class="bk-field" style={fieldStyle} />
                  </label>

                  <button type="submit" class="bk-btn bk-btn--lg">Meine Stammkunden-Karte erstellen</button>
                  <p class="bk-form-error" role="alert">Das hat leider nicht geklappt. Versuch's nochmal – oder schreib uns direkt auf WhatsApp.</p>
                  <p style="text-align:center;font-size:12.5px;color:var(--ink-56);margin:14px 0 0;line-height:1.5">Keine Kreditkarte. Wir melden uns innerhalb von 24 h.</p>
                </form>

                <div data-bk-success="a" hidden style="text-align:center;padding:14px 0 6px;animation:bk-rise 0.4s var(--ease-out) both">
                  <div style="width:64px;height:64px;border-radius:50%;background:var(--accent);display:inline-flex;align-items:center;justify-content:center;margin-bottom:18px;box-shadow:var(--shadow-amber);animation:bk-thunk 0.35s var(--ease-out) both">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#F6F1E8" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                  </div>
                  <h2 style="font-family:var(--font-serif);font-size:24px;font-weight:600;margin:0 0 8px;letter-spacing:-0.01em">Angekommen.</h2>
                  <p style="font-size:15px;color:var(--ink-72);line-height:1.55;margin:0 auto 20px;max-width:32ch">Danke! Wir melden uns innerhalb von 24 Stunden – meist schneller. Dann steht deine Karte.</p>
                  <p style="font-size:13px;color:var(--ink-56);margin:0 0 10px">Lieber sofort quatschen?</p>
                  <a href={whatsappUrl} class="bk-whatsapp" style="display:inline-flex;align-items:center;gap:8px;height:44px;padding:0 20px;border-radius:14px;border:1px solid var(--border-strong);color:var(--v2-ink);text-decoration:none;font-weight:600;font-size:15px">Auf WhatsApp schreiben</a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ======================= PROBLEM ======================= -->
      <section id="problem" style="padding:clamp(56px,8vw,104px) 24px;border-top:1px solid var(--border)">
        <div style="max-width:840px;margin:0 auto;text-align:center">
          <p style="font-family:var(--font-mono);font-size:12px;letter-spacing:0.14em;text-transform:uppercase;color:var(--accent);font-weight:500;margin:0 0 18px">Jeder Betrieb kennt das</p>
          <h2 style="font-family:var(--font-serif);font-weight:600;font-size:clamp(26px,4vw,42px);line-height:1.12;letter-spacing:-0.01em;margin:0 auto;max-width:20ch;text-wrap:balance">Ein Gast kommt heute. Aber warum kommt er nächste Woche wieder?</h2>

          <div aria-hidden="true" style="display:flex;flex-direction:column;align-items:center;gap:10px;margin:38px 0">
            <span style="display:inline-flex;align-items:center;gap:9px;background:var(--white);border:1px solid var(--border);border-radius:999px;padding:10px 18px;box-shadow:var(--shadow-sm);font-size:15px;font-weight:600;color:var(--v2-ink)"><span style="width:8px;height:8px;border-radius:50%;background:var(--accent)"></span>Heute: ein Gast steht bei dir</span>
            <svg width="20" height="26" viewBox="0 0 20 26" fill="none" stroke="var(--ink-40)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 1v20"/><path d="m3 15 7 8 7-8"/></svg>
            <span style="display:inline-flex;align-items:center;gap:9px;background:transparent;border:1.5px dashed var(--border-strong);border-radius:999px;padding:10px 18px;font-size:15px;font-weight:600;color:var(--ink-56)">Nächste Woche: kommt er wieder? <span style="font-family:var(--font-hand);font-size:22px;color:var(--accent);line-height:1">?</span></span>
          </div>

          <p style="font-size:18px;line-height:1.65;color:var(--ink-72);margin:0 auto;max-width:54ch;text-wrap:pretty">Viele lokale Betriebe stecken viel Energie in <em style="font-style:normal;color:var(--v2-ink);font-weight:600">neue</em> Kunden. Aber der wertvollste Gast ist oft der, der schon einmal da war – denn aus einem einzelnen Besuch entsteht nicht von allein eine Beziehung.</p>
        </div>
      </section>

      <!-- ======================= VOM BESUCH ZUR ROUTINE ======================= -->
      <section id="routine" style="padding:clamp(56px,8vw,104px) 24px;background:var(--surface-sunken)">
        <div style="max-width:1000px;margin:0 auto;text-align:center">
          <p style="font-family:var(--font-mono);font-size:12px;letter-spacing:0.14em;text-transform:uppercase;color:var(--accent);font-weight:500;margin:0 0 16px">Vom Besuch zur Routine</p>
