---
import { getCollection } from 'astro:content'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import Navbar from '../../../components/Navbar.astro'
import Footer from '../../../components/Footer.astro'

export async function getStaticPaths() {
  const now = new Date()
  const posts = await getCollection('blog')
  return posts
    .filter(p => p.data.city === 'huerth' && p.data.pubDate <= now)
    .map(post => ({ params: { slug: post.slug }, props: { post } }))
}

const { post } = Astro.props
const { Content } = await post.render()

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('de-DE', { day: 'numeric', month: 'long', year: 'numeric' }).format(date)
}

const allPosts = await getCollection('blog')
const related = allPosts
  .filter(p => p.data.city === 'huerth' && p.slug !== post.slug)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3)
---

<BaseLayout title={`${post.data.title} – bonuskarte.digital Hürth`} description={post.data.description} ogImage={post.data.heroImage}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": post.data.title,
    "description": post.data.description,
    "image": post.data.heroImage,
    "datePublished": post.data.pubDate.toISOString(),
    "dateModified": (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    "author": { "@type": "Organization", "name": "bonuskarte.digital", "url": "https://bonuskarte.digital" },
    "publisher": { "@type": "Organization", "name": "bonuskarte.digital", "logo": { "@type": "ImageObject", "url": "https://bonuskarte.digital/favicon.svg" } },
    "mainEntityOfPage": { "@type": "WebPage", "@id": `https://bonuskarte.digital/huerth/blog/${post.slug}` }
  })} />
  <Navbar dark={true} ctaHref="/#demo" />

  <div class="fixed top-0 left-0 right-0 z-[100] h-0.5 bg-transparent">
    <div id="progress-bar" class="h-full bg-amber transition-none" style="width:0%"></div>
  </div>

  <header class="bg-ink pt-24 pb-10 sm:pb-14">
    <div class="max-w-2xl mx-auto px-5 sm:px-8">
      <nav class="flex items-center flex-wrap gap-1.5 text-xs text-white/55 mb-7 tracking-wide">
        <a href="/" class="hover:text-white/60 transition-colors">Home</a><span>›</span>
        <a href="/huerth" class="hover:text-white/60 transition-colors">Hürth</a><span>›</span>
        <a href="/huerth/blog" class="hover:text-white/60 transition-colors">Blog</a><span>›</span>
        <span class="text-white/50">{post.data.category}</span>
      </nav>
      <div class="flex flex-wrap items-center gap-2.5 mb-5">
        <span class="text-white/50 text-xs">{post.data.readingTime} Min. Lesezeit</span>
        <span class="text-white/55 text-xs">📍 Hürth</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-white leading-tight tracking-tight mb-5">{post.data.title}</h1>
      <p class="text-white/55 text-base sm:text-lg leading-relaxed mb-7">{post.data.description}</p>
      <div class="flex items-center gap-3 pt-5 border-t border-white/8">
        <div class="w-9 h-9 bg-amber flex items-center justify-center flex-shrink-0">
          <span class="text-black font-black text-sm">F</span>
        </div>
        <div>
          <div class="text-white text-sm font-semibold leading-none mb-1">FUERTE.DIGITAL</div>
          <div class="text-white/60 text-xs">{formatDate(post.data.pubDate)}</div>
        </div>
      </div>
    </div>
  </header>

  <div class="bg-ink border-t border-white/5">
    <div class="max-w-2xl mx-auto px-5 sm:px-8 py-8 sm:py-10">
      <div class="flex items-center justify-center bg-ink-900 min-h-[200px] sm:min-h-[320px] p-6 sm:p-10">
        <img src={post.data.heroImage} alt={post.data.title} class="max-h-[200px] sm:max-h-[300px] w-auto max-w-full object-contain drop-shadow-2xl" loading="eager" />
      </div>
    </div>
  </div>

  <main class="bg-white">
    <div class="max-w-2xl mx-auto px-5 sm:px-8 py-12 sm:py-16">
      <article id="article-body" class="article-body"><Content /></article>
    </div>
  </main>

  <section class="bg-ink py-14 sm:py-20 border-t border-white/5">
    <div class="max-w-2xl mx-auto px-5 sm:px-8">
      <div class="flex flex-col sm:flex-row sm:items-center gap-6 sm:gap-10">
        <div class="flex-1">
          <div class="text-amber text-xs font-bold tracking-[0.25em] uppercase mb-2">Für Hürther Betriebe</div>
          <h2 class="text-2xl sm:text-3xl font-black text-white leading-tight">Jetzt 90 Tage kostenlos starten</h2>
        </div>
        <a href="/huerth/huerth-mitte/cafes" class="flex-shrink-0 inline-flex items-center justify-center gap-2 bg-amber hover:bg-amber text-black font-bold text-xs tracking-widest uppercase px-7 py-4 transition-colors">
          Gratis starten →
        </a>
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="bg-white py-14 sm:py-16 border-t border-gray-100">
      <div class="max-w-2xl mx-auto px-5 sm:px-8">
        <div class="flex items-center justify-between mb-8">
          <h2 class="text-xs font-bold tracking-[0.25em] uppercase text-black/40">Weitere Artikel</h2>
          <a href="/huerth/blog" class="text-xs text-amber hover:text-amber tracking-widest uppercase font-medium">Alle →</a>
        </div>
        <div class="grid sm:grid-cols-3 gap-px bg-gray-100">
          {related.map(p => (
            <a href={`/huerth/blog/${p.slug}`} class="group bg-white hover:bg-gray-50 transition-colors p-5 flex flex-col gap-3">
              <div class="bg-gray-50 flex items-center justify-center aspect-video overflow-hidden">
                <img src={p.data.heroImage} alt={p.data.title} class="max-h-full max-w-full object-contain" loading="lazy" />
              </div>
              <h3 class="text-sm font-bold text-black leading-snug group-hover:text-amber transition-colors">{p.data.title}</h3>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <Footer />
</BaseLayout>

<script>
  const bar = document.getElementById('progress-bar')
  const article = document.getElementById('article-body')
  if (bar && article) {
    window.addEventListener('scroll', () => {
      const scrolled = window.scrollY - (article.getBoundingClientRect().top + window.scrollY)
      const total    = article.offsetHeight - window.innerHeight
      bar.style.width = (total > 0 ? Math.min(100, Math.max(0, (scrolled / total) * 100)) : 0) + '%'
    }, { passive: true })
  }
</script>

<style is:global>
.article-body { font-size: 1.0625rem; line-height: 1.85; color: #374151; }
.article-body h2 { font-size: 1.4375rem; font-weight: 800; color: #000; margin-top: 3.25rem; margin-bottom: 1rem; padding-left: 1rem; border-left: 3px solid #A38A00; }
.article-body h3 { font-size: 1.125rem; font-weight: 700; color: #111; margin-top: 2.25rem; margin-bottom: 0.75rem; }
.article-body p { margin-bottom: 1.375rem; }
.article-body strong { font-weight: 700; color: #111; }
.article-body a { color: #A38A00; text-decoration: none; border-bottom: 1px solid rgba(139,115,0,0.35); }
.article-body ul { list-style: none; padding: 0; margin: 0 0 1.5rem; }
.article-body ul li { position: relative; padding-left: 1.625rem; margin-bottom: 0.625rem; }
.article-body ul li::before { content: '→'; color: #A38A00; font-weight: 700; position: absolute; left: 0; }
.article-body blockquote { background: #0d0d0d; border-left: 3px solid #A38A00; padding: 1.375rem 1.5rem; margin: 2rem 0; }
.article-body blockquote p { color: rgba(255,255,255,0.8); margin-bottom: 0; }
</style>
