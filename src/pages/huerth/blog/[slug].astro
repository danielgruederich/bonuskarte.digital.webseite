---
import { getCollection } from 'astro:content'
import BlogArticleHeader from '../../../components/blog/BlogArticleHeader.astro'
import BlogRelated from '../../../components/blog/BlogRelated.astro'
import { blogOgImage } from '../../../data/blog-style'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import Navbar from '../../../components/Navbar.astro'
import Footer from '../../../components/Footer.astro'

export async function getStaticPaths() {
  const now = new Date()
  const posts = await getCollection('blog')
  return posts
    .filter(p => p.data.city === 'huerth' && p.data.pubDate <= now)
    .map(post => ({ params: { slug: post.slug }, props: { post } }))
}

const { post } = Astro.props
const { Content } = await post.render()
const bookingUrl = ['cafe', 'eiscafe'].includes(post.data.niche)
  ? 'https://termin.bonuskarte.digital/barista'
  : ['restaurant', 'gastro', 'doener', 'pizza'].includes(post.data.niche)
  ? 'https://termin.bonuskarte.digital/gastro'
  : 'https://termin.bonuskarte.digital/15min'


const allPosts = await getCollection('blog')
const relatedNow = new Date()
const related = allPosts
  .filter(p => p.data.city === 'huerth' && p.slug !== post.slug && p.data.pubDate <= relatedNow)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3)
---

<BaseLayout title={`${post.data.title} – bonuskarte.digital Hürth`} description={post.data.description} ogImage={blogOgImage(post)}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": post.data.title,
    "description": post.data.description,
    "image": `https://bonuskarte.digital${blogOgImage(post)}`,
    "datePublished": post.data.pubDate.toISOString(),
    "dateModified": (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    "author": { "@type": "Person", "name": "Daniel Grüderich", "jobTitle": "Gründer", "url": "https://www.linkedin.com/in/dgruederich/", "worksFor": { "@type": "Organization", "name": "bonuskarte.digital", "url": "https://bonuskarte.digital" } },
    "publisher": { "@type": "Organization", "name": "bonuskarte.digital", "logo": { "@type": "ImageObject", "url": "https://bonuskarte.digital/favicon.svg" } },
    "mainEntityOfPage": { "@type": "WebPage", "@id": `https://bonuskarte.digital/huerth/blog/${post.slug}` }
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://bonuskarte.digital"},
    {"@type": "ListItem", "position": 2, "name": "Hürth", "item": "https://bonuskarte.digital/huerth"},
    {"@type": "ListItem", "position": 3, "name": "Blog", "item": "https://bonuskarte.digital/huerth/blog"},
    {"@type": "ListItem", "position": 4, "name": post.data.title, "item": `https://bonuskarte.digital/huerth/blog/${post.slug}`}
  ]
})} />
  {post.data.faqItems && post.data.faqItems.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": post.data.faqItems.map((item: {q: string, a: string}) => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": { "@type": "Answer", "text": item.a }
      }))
    })} />
  )}
  <Navbar ctaHref="/#demo" />

  <div class="fixed top-0 left-0 right-0 z-[100] h-0.5 bg-transparent">
    <div id="progress-bar" class="h-full bg-amber transition-none" style="width:0%"></div>
  </div>

  <BlogArticleHeader post={post} place="Hürth" crumbs={[{ label: 'Home', href: '/' }, { label: 'Hürth', href: '/huerth/' }, { label: 'Blog', href: '/huerth/blog/' }, { label: post.data.category }]} />

  <main class="bg-white">
    <div class="max-w-2xl mx-auto px-5 sm:px-8 py-12 sm:py-16">
      <article id="article-body" class="article-body"><Content /></article>
    </div>
  </main>

  <!-- ── Author Bio ───────────────────────────── -->
  <section class="bg-paper-dark py-10 sm:py-12 border-t border-ink/10">
    <div class="max-w-2xl mx-auto px-5 sm:px-8">
      <div class="flex items-start gap-5">
        <img src="/images/daniel-gruederich.png" alt="Daniel Grüderich" class="w-16 h-16 rounded-full object-cover object-top flex-shrink-0" />
        <div>
          <div class="text-xs font-bold tracking-[0.2em] uppercase text-ink-500 mb-1">Über den Autor</div>
          <div class="text-ink font-semibold text-sm mb-0.5">Daniel Grüderich</div>
          <div class="text-amber-text text-xs font-medium mb-2">Gründer bonuskarte.digital</div>
          <p class="text-ink-500 text-sm leading-relaxed">Daniel Grüderich ist Gründer von bonuskarte.digital und hilft lokalen Betrieben dabei, Papier-Stempelkarten durch digitale Kundenbindung zu ersetzen. Seit Jahren arbeitet er mit Gastronomen, Cafés und lokalen Händlern zusammen und weiß, was Stammkunden wirklich brauchen.</p>
          <a href="https://www.linkedin.com/in/dgruederich/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 mt-3 text-xs text-ink-500 hover:text-ink transition-colors">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
            LinkedIn
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-ink py-14 sm:py-20 border-t border-ink/30">
    <div class="max-w-2xl mx-auto px-5 sm:px-8">
      <div class="flex flex-col sm:flex-row sm:items-center gap-6 sm:gap-10">
        <div class="flex-1">
          <div class="text-amber text-xs font-bold tracking-[0.25em] uppercase mb-2">Für Hürther Betriebe</div>
          <h2 class="text-2xl sm:text-3xl font-black text-paper leading-tight">Jetzt 90 Tage kostenlos starten</h2>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 flex-shrink-0">
          <a href="/huerth/huerth-mitte/cafes/" class="inline-flex items-center justify-center gap-2 bg-amber hover:bg-amber-dark text-black font-bold text-xs tracking-widest uppercase px-7 py-4 transition-colors">
            Gratis starten →
          </a>
          <a href={bookingUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 border border-ink-400 hover:border-paper text-paper font-bold text-xs tracking-widest uppercase px-7 py-4 transition-colors">
            Termin buchen
          </a>
        </div>
      </div>
    </div>
  </section>

  <BlogRelated title="Weitere Artikel" allLabel="Alle Artikel →" allHref="/huerth/blog/" posts={related.map(p => ({ post: p, href: `/huerth/blog/${p.slug}/` }))} />


  <Footer />
</BaseLayout>

<script>
  const bar = document.getElementById('progress-bar')
  const article = document.getElementById('article-body')
  if (bar && article) {
    window.addEventListener('scroll', () => {
      const scrolled = window.scrollY - (article.getBoundingClientRect().top + window.scrollY)
      const total    = article.offsetHeight - window.innerHeight
      bar.style.width = (total > 0 ? Math.min(100, Math.max(0, (scrolled / total) * 100)) : 0) + '%'
    }, { passive: true })
  }
</script>

