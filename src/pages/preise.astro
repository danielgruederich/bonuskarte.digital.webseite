---
import BaseLayout from '../layouts/BaseLayout.astro'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'
import Icon from '../components/icons/TrustIcons.astro'

const faq = [
  {
    q: 'Was passiert nach den 90 Tagen?',
    a: 'Du entscheidest, ob du weitermachst. Kein automatischer Übergang, kein versteckter Vertrag. Wir melden uns vorher bei dir.',
  },
  {
    q: 'Was zählt als "Standort"?',
    a: 'Ein Standort ist ein Lokal oder eine Filiale. Jeder Standort bekommt seine eigene digitale Stempelkarte mit eigenem Branding.',
  },
  {
    q: 'Brauchen meine Gäste eine App?',
    a: 'Nein. Die Karte landet direkt in Apple Wallet oder Google Wallet – auf jedem iPhone und Android-Handy vorinstalliert. Kein Download, kein Account.',
  },
  {
    q: 'Wie lange dauert die Einrichtung?',
    a: 'Deine Karte ist in unter 24 Stunden live. Wir kümmern uns um alles – du musst nur dein Branding (Logo, Farbe, Belohnung) angeben.',
  },
  {
    q: 'Kann ich jederzeit kündigen?',
    a: 'Ja. Monatlich kündbar, keine Mindestlaufzeit, keine Einrichtungsgebühr. Null Risiko.',
  },
  {
    q: 'Was ist Push Automation?',
    a: 'Automatische Push-Nachrichten an deine Stammkunden – z. B. wenn jemand länger nicht da war, oder du ein neues Angebot hast.',
  },
]
---

<BaseLayout
  title="Preise – digitale Stempelkarte ab 29 €/Monat | bonuskarte.digital"
  description="Einfache, transparente Preise. Bis zu 3 Standorte für 29 €/Monat – unter 1 € pro Tag. 4–10 Standorte Flatrate für 100 €/Monat. 90 Tage kostenlos testen – keine Kreditkarte."
  alternates={[
    { hreflang: 'de', href: 'https://bonuskarte.digital/preise' },
    { hreflang: 'fr', href: 'https://bonuskarte.digital/fr/tarifs' },
    { hreflang: 'x-default', href: 'https://bonuskarte.digital/preise' },
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faq.map(item => ({
      "@type": "Question",
      "name": item.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.a,
      }
    }))
  })} />

  <Navbar ctaHref="#preise" ctaLabel="Jetzt testen" />

  <!-- ── HERO ─────────────────────────────────────────────────── -->
  <section class="relative bg-ink overflow-hidden pt-32 pb-16 px-5 sm:px-8">
    <div class="absolute inset-0 bg-grid-white"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[400px] bg-amber rounded-full blur-[200px] opacity-5 pointer-events-none"></div>

    <div class="relative max-w-3xl mx-auto text-center">
      <div class="inline-flex items-center gap-3 border border-amber/30 px-4 py-2 mb-8">
        <span class="w-1 h-1 bg-amber animate-pulse-slow"></span>
        <span class="text-amber text-xs font-light tracking-[0.3em] uppercase">
          Transparent · Fair · Risikofrei
        </span>
      </div>

      <h1 class="text-5xl sm:text-6xl leading-[1.1] tracking-tight mb-6">
        <span class="font-extralight text-white block mb-3">Einfache</span>
        <span class="font-bold text-amber block">Preise.</span>
      </h1>
      <p class="text-white text-base font-light leading-relaxed max-w-lg mx-auto mb-10">
        Starte 90 Tage kostenlos. Danach ab 29 €/Monat – unter 1 € pro Tag,
        monatlich kündbar, keine Einrichtungsgebühr. Kommt nur ein Gast pro Monat
        wegen der Karte einmal mehr, hat es sich schon bezahlt.
      </p>

      <div class="flex flex-wrap justify-center gap-6">
        {['✅ 90 Tage kostenlos', '🔒 DSGVO-konform', '⚡ Live in 24h', '📱 Apple & Google Wallet'].map(t => (
          <span class="text-xs tracking-widest uppercase text-white">{t}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- ── PRICING ─────────────────────────────────────────────── -->
  <section id="preise" class="py-12 sm:py-16 px-5 sm:px-8 bg-ink">
    <div class="max-w-4xl mx-auto">

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 items-center">

        <!-- SOLO -->
        <div class="relative border border-white/10 hover:border-white/15 transition-colors p-8 flex flex-col h-full">
          <p class="text-xs tracking-[0.3em] uppercase text-white mb-5">Solo</p>
          <div class="flex items-baseline gap-1.5 mb-1">
            <span class="text-5xl font-black text-white">29€</span>
            <span class="text-sm text-white font-light">/ Monat</span>
          </div>
          <p class="text-xs text-amber font-medium mb-1">Unter 1 € pro Tag</p>
          <p class="text-xs text-white mb-8">bis zu 3 Standorte · zzgl. MwSt.</p>

          <div class="space-y-3.5 flex-1 mb-8">
            {[
              'Bis zu 3 Standorte inklusive',
              'Unbegrenzt viele Kundenkarten',
              'Push-Nachrichten an Stammkunden',
              'Live-Statistiken (Karten, Stempel)',
              'QR-Code zum Stempeln',
              'Eigenes Branding (Logo, Farbe)',
              'Apple Wallet & Google Wallet',
              'Setup in unter 24h',
            ].map(f => (
              <div class="flex items-start gap-3">
                <Icon name="diamond" class="w-3.5 h-3.5 text-amber mt-0.5 flex-shrink-0" />
                <span class="text-sm text-white font-light">{f}</span>
              </div>
            ))}
          </div>

          <a href="/koeln"
            class="w-full inline-flex items-center justify-center border border-white/15 hover:border-amber/40 text-white hover:text-white px-6 py-4 text-xs font-medium tracking-[0.15em] uppercase transition-all">
            Kostenlos testen
          </a>
        </div>

        <!-- KETTE — highlighted -->
        <div class="relative border-2 border-amber/60 bg-gradient-to-b from-amber/[0.04] to-transparent shadow-[0_0_80px_rgba(139,115,0,0.1)] p-10 flex flex-col md:scale-105 md:-my-4 z-10">
          <!-- Top gold line -->
          <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-amber to-transparent"></div>

          <!-- Badge -->
          <div class="absolute -top-3.5 left-1/2 -translate-x-1/2">
            <span class="bg-amber text-black text-[9px] font-bold tracking-[0.2em] uppercase px-4 py-1.5 whitespace-nowrap">
              Meistgewählt
            </span>
          </div>

          <p class="text-xs tracking-[0.3em] uppercase text-amber mb-5">Kette</p>
          <div class="flex items-baseline gap-1.5 mb-1">
            <span class="text-5xl font-black text-white">100€</span>
            <span class="text-sm text-white font-light">/ Monat</span>
          </div>
          <p class="text-xs text-white mb-8">4–10 Standorte · Flatrate · zzgl. MwSt.</p>

          <div class="space-y-3.5 flex-1 mb-8">
            {[
              '4–10 Standorte — Flatrate',
              'Alles aus Solo',
              'Push Automation (Abwesenheits-Trigger)',
              'Zentrales Multi-Standort-Dashboard',
              'Alle Standorte in einer Übersicht',
              'Prioritäts-Support',
              'Eigene Subdomain möglich',
              'Setup in unter 24h',
            ].map(f => (
              <div class="flex items-start gap-3">
                <Icon name="diamond" class="w-3.5 h-3.5 text-amber mt-0.5 flex-shrink-0" />
                <span class="text-sm text-white font-light">{f}</span>
              </div>
            ))}
          </div>

          <a href="/koeln"
            class="w-full inline-flex items-center justify-center bg-amber hover:bg-amber text-black px-6 py-4 text-xs font-bold tracking-[0.15em] uppercase transition-all">
            Jetzt starten
          </a>
        </div>

        <!-- FRANCHISE -->
        <div class="relative border border-white/10 hover:border-white/15 transition-colors p-8 flex flex-col h-full">
          <p class="text-xs tracking-[0.3em] uppercase text-white mb-5">Franchise</p>
          <div class="flex items-baseline gap-1.5 mb-1">
            <span class="text-5xl font-black text-white">250€</span>
            <span class="text-sm text-white font-light">/ Monat</span>
          </div>
          <p class="text-xs text-white mb-8">Franchise-Systeme · zzgl. MwSt.</p>

          <div class="space-y-3.5 flex-1 mb-8">
            {[
              'Bis zu 20 Standorten inklusive',
              'Alles aus Kette',
              'Eigene Domain (yourcard.de)',
              'Franchise-weites Dashboard',
              'Zentrales Kampagnen-Management',
              'Push-Nachrichten systemweit',
              'Individuelle Berichte pro Standort',
              'Prioritäts-Support',
            ].map(f => (
              <div class="flex items-start gap-3">
                <Icon name="diamond" class="w-3.5 h-3.5 text-amber mt-0.5 flex-shrink-0" />
                <span class="text-sm text-white font-light">{f}</span>
              </div>
            ))}
          </div>

          <a href="https://wa.me/491705594140" target="_blank" rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center border border-white/15 hover:border-amber/40 text-white hover:text-white px-6 py-4 text-xs font-medium tracking-[0.15em] uppercase transition-all">
            Beratung anfragen
          </a>
        </div>

      </div>

      <!-- Chat CTA -->
      <div class="mt-8 border border-white/10 p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
        <p class="text-white/60 text-sm font-light">Nicht sicher welcher Plan passt? Unser Agent antwortet sofort.</p>
        <button
          onclick="document.querySelector('[id*=zipchat], [class*=zipchat], .zipchat-launcher, #zipchat-launcher')?.click()"
          class="flex-shrink-0 inline-flex items-center gap-2 bg-white text-black px-6 py-3 text-xs font-bold tracking-[0.15em] uppercase hover:bg-amber transition-all">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
          Jetzt mit Agent chatten
        </button>
      </div>

      <!-- Enterprise -->
      <div class="mt-8 border border-white/10 hover:border-white/15 transition-colors p-8 flex flex-col sm:flex-row items-center justify-between gap-6">
        <div>
          <p class="text-xs tracking-[0.3em] uppercase text-white mb-2">Enterprise</p>
          <p class="text-white text-lg font-semibold mb-1">Individuelles Angebot für große Ketten & Systemgastro</p>
          <p class="text-white text-sm font-light">Unbegrenzte Standorte · API-Integration · White-Label · SLA-Garantie · Dedizierter Account Manager</p>
        </div>
        <a href="https://wa.me/491705594140" target="_blank" rel="noopener noreferrer"
          class="flex-shrink-0 inline-flex items-center justify-center border border-white/15 hover:border-amber/40 text-white hover:text-white px-8 py-4 text-xs font-medium tracking-[0.15em] uppercase transition-all">
          Jetzt anfragen
        </a>
      </div>

      <!-- Trust badges -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-6">
        {[
          '✅ 90 Tage kostenlos',
          '🔄 Kein automatischer Übergang',
          '📅 Monatlich kündbar',
          '🚫 Keine Einrichtungsgebühr',
        ].map(t => (
          <span class="text-xs tracking-widest uppercase text-white">{t}</span>
        ))}
      </div>

      <p class="text-center text-white text-xs tracking-wide mt-4">
        Alle Preise zzgl. MwSt.
      </p>
    </div>
  </section>

  <!-- ── VERGLEICH ──────────────────────────────────────────── -->
  <section class="py-12 sm:py-16 px-5 sm:px-8 bg-ink-950 relative overflow-hidden">
    <div class="absolute inset-0 bg-grid-white opacity-50"></div>
    <div class="relative max-w-3xl mx-auto">
      <div class="flex items-center gap-4 mb-14">
        <div class="h-px flex-1 bg-white/5"></div>
        <span class="text-xs tracking-[0.4em] uppercase text-white">Papier vs. Digital</span>
        <div class="h-px flex-1 bg-white/5"></div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-white/5">
              <th class="text-left text-white text-xs tracking-[0.3em] uppercase font-normal pb-4 pr-8">Funktion</th>
              <th class="text-center text-white text-xs tracking-[0.3em] uppercase font-normal pb-4 px-4">Papierkarte</th>
              <th class="text-center text-amber text-xs tracking-[0.3em] uppercase font-normal pb-4 pl-4">bonuskarte.digital</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5">
            {[
              ['Immer beim Gast', '✗', '✓'],
              ['Push-Nachrichten ans Handy', '✗', '✓'],
              ['Statistiken & Auswertungen', '✗', '✓'],
              ['Karte geht verloren', 'Ständig', 'Nie'],
              ['Hygienisch', '✗', '✓'],
              ['Kosten', 'Druck + Papier', 'Ab 29 €/Monat'],
              ['App-Download für Gäste nötig', '—', 'Nein'],
              ['Setup-Zeit', 'Sofort', 'Unter 24h'],
            ].map(([feature, paper, digital]) => (
              <tr>
                <td class="py-4 pr-8 text-white font-light">{feature}</td>
                <td class="py-4 px-4 text-center text-white">{paper}</td>
                <td class="py-4 pl-4 text-center text-amber font-medium">{digital}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ── FAQ ───────────────────────────────────────────────── -->
  <section class="py-12 sm:py-16 px-5 sm:px-8 bg-ink">
    <div class="max-w-3xl mx-auto">
      <div class="flex items-center gap-4 mb-14">
        <div class="h-px flex-1 bg-white/5"></div>
        <span class="text-xs tracking-[0.4em] uppercase text-white">Häufige Fragen</span>
        <div class="h-px flex-1 bg-white/5"></div>
      </div>

      <div class="space-y-px">
        {faq.map(item => (
          <div class="border border-white/5 p-6 hover:border-amber/20 transition-colors">
            <p class="text-white text-sm font-semibold mb-2">{item.q}</p>
            <p class="text-white text-sm font-light leading-relaxed">{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── FINAL CTA ──────────────────────────────────────────── -->
  <section class="py-12 sm:py-16 px-5 sm:px-8 bg-ink border-t border-white/5 relative overflow-hidden">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-amber rounded-full blur-[150px] opacity-5"></div>
    <div class="relative max-w-2xl mx-auto text-center">
      <p class="text-amber text-xs tracking-[0.4em] uppercase mb-6">Kein Risiko</p>
      <h2 class="text-4xl sm:text-5xl font-extralight text-white tracking-tight mb-2">
        90 Tage gratis
      </h2>
      <h2 class="text-4xl sm:text-5xl font-bold text-white tracking-tight mb-10">
        ausprobieren.
      </h2>
      <a href="/koeln"
        class="group inline-flex items-center gap-3 bg-amber hover:bg-amber text-black px-10 py-5 text-xs font-bold tracking-[0.25em] uppercase transition-all">
        Jetzt kostenlos starten
        <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </section>

  <Footer />
</BaseLayout>
