---
import BaseLayout from '../layouts/BaseLayout.astro'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'

const faq = [
  {
    q: 'Was passiert nach den 90 Tagen?',
    a: 'Du entscheidest, ob du weitermachst. Kein automatischer Übergang, kein versteckter Vertrag. Wir melden uns vorher bei dir.',
  },
  {
    q: 'Was zählt als "Standort"?',
    a: 'Ein Standort ist ein Lokal oder eine Filiale. Jeder Standort bekommt seine eigene digitale Stempelkarte mit eigenem Branding.',
  },
  {
    q: 'Brauchen meine Gäste eine App?',
    a: 'Nein. Die Karte landet direkt in Apple Wallet oder Google Wallet – auf jedem iPhone und Android-Handy vorinstalliert. Kein Download, kein Account.',
  },
  {
    q: 'Wie lange dauert die Einrichtung?',
    a: 'Deine Karte ist in unter 24 Stunden live. Wir kümmern uns um alles – du musst nur dein Branding (Logo, Farbe, Belohnung) angeben.',
  },
  {
    q: 'Kann ich jederzeit kündigen?',
    a: 'Ja. Monatlich kündbar, keine Mindestlaufzeit, keine Einrichtungsgebühr. Null Risiko.',
  },
  {
    q: 'Was ist Push Automation?',
    a: 'Automatische Push-Nachrichten an deine Stammkunden – z. B. wenn jemand länger nicht da war, oder du ein neues Angebot hast.',
  },
]
---

<BaseLayout
  title="Preise – digitale Stempelkarte ab 29 €/Monat | bonuskarte.digital"
  description="Einfache, transparente Preise. 1 Standort für 29 €/Monat. Ab 10 Standorte Flatrate für 100 €/Monat. 90 Tage kostenlos testen – keine Kreditkarte."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faq.map(item => ({
      "@type": "Question",
      "name": item.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.a,
      }
    }))
  })} />

  <Navbar ctaHref="#preise" ctaLabel="Jetzt testen" />

  <!-- ── HERO ─────────────────────────────────────────────────── -->
  <section class="relative bg-black overflow-hidden pt-32 pb-16 px-5 sm:px-8">
    <div class="absolute inset-0 bg-grid-white"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[400px] bg-gold-600 rounded-full blur-[200px] opacity-5 pointer-events-none"></div>

    <div class="relative max-w-3xl mx-auto text-center">
      <div class="inline-flex items-center gap-3 border border-gold-600/30 px-4 py-2 mb-8">
        <span class="w-1 h-1 bg-gold-600 animate-pulse-slow"></span>
        <span class="text-gold-600 text-[10px] font-light tracking-[0.3em] uppercase">
          Transparent · Fair · Risikofrei
        </span>
      </div>

      <h1 class="text-5xl sm:text-6xl leading-[1.1] tracking-tight mb-6">
        <span class="font-extralight text-white block mb-3">Einfache</span>
        <span class="font-bold text-gold-600 block">Preise.</span>
      </h1>
      <p class="text-white/40 text-base font-light leading-relaxed max-w-lg mx-auto mb-10">
        Starte 90 Tage kostenlos. Danach zahlst du nur, wenn du zufrieden bist –
        monatlich kündbar, keine Einrichtungsgebühr.
      </p>

      <div class="flex flex-wrap justify-center gap-6">
        {['✅ 90 Tage kostenlos', '🔒 DSGVO-konform', '⚡ Live in 24h', '📱 Apple & Google Wallet'].map(t => (
          <span class="text-[10px] tracking-widest uppercase text-white/50">{t}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- ── PRICING ─────────────────────────────────────────────── -->
  <section id="preise" class="py-24 px-5 sm:px-8 bg-black">
    <div class="max-w-5xl mx-auto">

      <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 items-stretch">

        <!-- SOLO -->
        <div class="relative border border-white/5 hover:border-white/10 transition-colors p-8 flex flex-col">
          <p class="text-[10px] tracking-[0.3em] uppercase text-white/55 mb-5">Solo</p>
          <div class="flex items-baseline gap-1.5 mb-1">
            <span class="text-5xl font-black text-white">29€</span>
            <span class="text-sm text-white/55 font-light">/ Monat</span>
          </div>
          <p class="text-xs text-white/50 mb-8">pro Standort · zzgl. MwSt.</p>

          <div class="space-y-3.5 flex-1 mb-8">
            {[
              '1 Standort',
              'Unbegrenzt viele Kundenkarten',
              'Push-Nachrichten an Stammkunden',
              'Live-Statistiken (Karten, Stempel)',
              'QR-Code zum Stempeln',
              'Eigenes Branding (Logo, Farbe)',
              'Apple Wallet & Google Wallet',
              'Setup in unter 24h',
            ].map(f => (
              <div class="flex items-start gap-3">
                <span class="text-gold-600 text-xs mt-0.5 flex-shrink-0">✦</span>
                <span class="text-sm text-white/50 font-light">{f}</span>
              </div>
            ))}
          </div>

          <a href="/koeln"
            class="w-full inline-flex items-center justify-center border border-white/10 hover:border-gold-600/40 text-white/50 hover:text-white px-6 py-3.5 text-xs font-medium tracking-[0.15em] uppercase transition-all">
            90 Tage kostenlos starten
          </a>
        </div>

        <!-- KETTE — highlighted -->
        <div class="relative border border-gold-600/50 shadow-[0_0_50px_rgba(139,115,0,0.08)] p-8 flex flex-col">
          <!-- Top gold line -->
          <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-gold-600/60 to-transparent"></div>

          <!-- Badge -->
          <div class="absolute -top-3.5 left-1/2 -translate-x-1/2">
            <span class="bg-gold-600 text-black text-[9px] font-bold tracking-[0.2em] uppercase px-3 py-1">
              Beliebt
            </span>
          </div>

          <p class="text-[10px] tracking-[0.3em] uppercase text-gold-600/60 mb-5">Kette</p>
          <div class="flex items-baseline gap-1.5 mb-1">
            <span class="text-5xl font-black text-white">100€</span>
            <span class="text-sm text-white/55 font-light">/ Monat</span>
          </div>
          <p class="text-xs text-white/50 mb-8">ab 10 Standorte · Flatrate · zzgl. MwSt.</p>

          <div class="space-y-3.5 flex-1 mb-8">
            {[
              'Ab 10 Standorte — Flatrate',
              'Alles aus Solo',
              'Push Automation (Abwesenheits-Trigger)',
              'Zentrales Multi-Standort-Dashboard',
              'Alle Standorte in einer Übersicht',
              'Prioritäts-Support',
              'Eigene Subdomain möglich',
              'Setup in unter 24h',
            ].map(f => (
              <div class="flex items-start gap-3">
                <span class="text-gold-600 text-xs mt-0.5 flex-shrink-0">✦</span>
                <span class="text-sm text-white/60 font-light">{f}</span>
              </div>
            ))}
          </div>

          <a href="/koeln"
            class="w-full inline-flex items-center justify-center bg-gold-600 hover:bg-gold-500 text-black px-6 py-3.5 text-xs font-bold tracking-[0.15em] uppercase transition-all">
            90 Tage kostenlos starten
          </a>
        </div>

        <!-- FRANCHISE -->
        <div class="relative border border-white/5 hover:border-white/10 transition-colors p-8 flex flex-col">
          <p class="text-[10px] tracking-[0.3em] uppercase text-white/55 mb-5">Franchise</p>
          <div class="flex items-baseline gap-1.5 mb-1">
            <span class="text-5xl font-black text-white">250€</span>
            <span class="text-sm text-white/55 font-light">/ Monat</span>
          </div>
          <p class="text-xs text-white/50 mb-8">Franchise-Systeme · zzgl. MwSt.</p>

          <div class="space-y-3.5 flex-1 mb-8">
            {[
              '20 Standorte inklusive',
              'Alles aus Kette',
              'Eigene Domain (yourcard.de)',
              'Franchise-weites Dashboard',
              'Zentrales Kampagnen-Management',
              'Push-Nachrichten systemweit',
              'Individuelle Berichte pro Standort',
              'Prioritäts-Support',
            ].map(f => (
              <div class="flex items-start gap-3">
                <span class="text-gold-600 text-xs mt-0.5 flex-shrink-0">✦</span>
                <span class="text-sm text-white/50 font-light">{f}</span>
              </div>
            ))}
          </div>

          <a href="/koeln"
            class="w-full inline-flex items-center justify-center border border-white/10 hover:border-gold-600/40 text-white/50 hover:text-white px-6 py-3.5 text-xs font-medium tracking-[0.15em] uppercase transition-all">
            90 Tage kostenlos starten
          </a>
        </div>

        <!-- ENTERPRISE -->
        <div class="relative border border-white/5 hover:border-white/10 transition-colors p-8 flex flex-col">
          <p class="text-[10px] tracking-[0.3em] uppercase text-white/55 mb-5">Enterprise</p>
          <div class="flex items-baseline gap-1.5 mb-1">
            <span class="text-4xl font-black text-white leading-tight">Individuell</span>
          </div>
          <p class="text-xs text-white/50 mb-8">Für große Ketten & Systemgastro</p>

          <div class="space-y-3.5 flex-1 mb-8">
            {[
              'Unbegrenzte Standorte',
              'Alles aus Franchise',
              'API-Integration',
              'White-Label-Option',
              'Dedizierter Account Manager',
              'SLA-Garantie',
              'Custom Onboarding',
              'Individuelle Vertragsgestaltung',
            ].map(f => (
              <div class="flex items-start gap-3">
                <span class="text-gold-600 text-xs mt-0.5 flex-shrink-0">✦</span>
                <span class="text-sm text-white/50 font-light">{f}</span>
              </div>
            ))}
          </div>

          <a href="https://wa.me/491705594140" target="_blank" rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center border border-white/10 hover:border-gold-600/40 text-white/50 hover:text-white px-6 py-3.5 text-xs font-medium tracking-[0.15em] uppercase transition-all">
            Jetzt anfragen
          </a>
        </div>

      </div>

      <p class="text-center text-white/50 text-xs tracking-widest uppercase mt-10">
        Alle Preise zzgl. MwSt. · Monatlich kündbar · Keine Einrichtungsgebühr · 90 Tage kostenlos
      </p>
    </div>
  </section>

  <!-- ── VERGLEICH ──────────────────────────────────────────── -->
  <section class="py-24 px-5 sm:px-8 bg-ink-950 relative overflow-hidden">
    <div class="absolute inset-0 bg-grid-white opacity-50"></div>
    <div class="relative max-w-3xl mx-auto">
      <div class="flex items-center gap-4 mb-14">
        <div class="h-px flex-1 bg-white/5"></div>
        <span class="text-[10px] tracking-[0.4em] uppercase text-white/50">Papier vs. Digital</span>
        <div class="h-px flex-1 bg-white/5"></div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-white/5">
              <th class="text-left text-white/50 text-[10px] tracking-[0.3em] uppercase font-normal pb-4 pr-8">Funktion</th>
              <th class="text-center text-white/50 text-[10px] tracking-[0.3em] uppercase font-normal pb-4 px-4">Papierkarte</th>
              <th class="text-center text-gold-600 text-[10px] tracking-[0.3em] uppercase font-normal pb-4 pl-4">bonuskarte.digital</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5">
            {[
              ['Immer beim Gast', '✗', '✓'],
              ['Push-Nachrichten ans Handy', '✗', '✓'],
              ['Statistiken & Auswertungen', '✗', '✓'],
              ['Karte geht verloren', 'Ständig', 'Nie'],
              ['Hygienisch', '✗', '✓'],
              ['Kosten', 'Druck + Papier', 'Ab 29 €/Monat'],
              ['App-Download für Gäste nötig', '—', 'Nein'],
              ['Setup-Zeit', 'Sofort', 'Unter 24h'],
            ].map(([feature, paper, digital]) => (
              <tr>
                <td class="py-4 pr-8 text-white/40 font-light">{feature}</td>
                <td class="py-4 px-4 text-center text-white/50">{paper}</td>
                <td class="py-4 pl-4 text-center text-gold-600 font-medium">{digital}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ── FAQ ───────────────────────────────────────────────── -->
  <section class="py-24 px-5 sm:px-8 bg-black">
    <div class="max-w-3xl mx-auto">
      <div class="flex items-center gap-4 mb-14">
        <div class="h-px flex-1 bg-white/5"></div>
        <span class="text-[10px] tracking-[0.4em] uppercase text-white/50">Häufige Fragen</span>
        <div class="h-px flex-1 bg-white/5"></div>
      </div>

      <div class="space-y-px">
        {faq.map(item => (
          <div class="border border-white/5 p-6 hover:border-gold-600/20 transition-colors">
            <p class="text-white text-sm font-semibold mb-2">{item.q}</p>
            <p class="text-white/40 text-sm font-light leading-relaxed">{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── FINAL CTA ──────────────────────────────────────────── -->
  <section class="py-28 px-5 sm:px-8 bg-black border-t border-white/5 relative overflow-hidden">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-gold-600 rounded-full blur-[150px] opacity-5"></div>
    <div class="relative max-w-2xl mx-auto text-center">
      <p class="text-gold-600 text-[10px] tracking-[0.4em] uppercase mb-6">Kein Risiko</p>
      <h2 class="text-4xl sm:text-5xl font-extralight text-white tracking-tight mb-2">
        90 Tage gratis
      </h2>
      <h2 class="text-4xl sm:text-5xl font-bold text-white tracking-tight mb-10">
        ausprobieren.
      </h2>
      <a href="/koeln"
        class="group inline-flex items-center gap-3 bg-gold-600 hover:bg-gold-500 text-black px-10 py-5 text-xs font-bold tracking-[0.25em] uppercase transition-all">
        Jetzt kostenlos starten
        <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </section>

  <Footer />
</BaseLayout>
