---
// Legacy redirect: /doener-koeln?veedel=X → /koeln/[veedel]/doener
---
<meta name="robots" content="noindex,follow" />
<meta http-equiv="refresh" content="0;url=/koeln/innenstadt/doener" />
<script>
  const veedel = new URLSearchParams(window.location.search).get('veedel')
  if (veedel) {
    const slug = veedel.toLowerCase().replace(/\s+/g, '-').replace(/ä/g, 'ae').replace(/ö/g, 'oe').replace(/ü/g, 'ue').replace(/ß/g, 'ss')
    window.location.replace(`/koeln/${slug}/doener`)
  } else {
    window.location.replace('/koeln/innenstadt/doener')
  }
</script>
