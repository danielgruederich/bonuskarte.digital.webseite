---
// Legacy redirect: /restaurant-koeln?veedel=X → /koeln/[veedel]/restaurant
---
<meta http-equiv="refresh" content="0;url=/koeln/innenstadt/restaurant" />
<script>
  const veedel = new URLSearchParams(window.location.search).get('veedel')
  if (veedel) {
    const slug = veedel.toLowerCase().replace(/\s+/g, '-').replace(/ä/g, 'ae').replace(/ö/g, 'oe').replace(/ü/g, 'ue').replace(/ß/g, 'ss')
    window.location.replace(`/koeln/${slug}/restaurant`)
  } else {
    window.location.replace('/koeln/innenstadt/restaurant')
  }
</script>
