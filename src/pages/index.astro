---
import BaseLayout from '../layouts/BaseLayout.astro'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'
import WalletMockup from '../components/WalletMockup.astro'

const howItWorks = [
  { step: '01', title: 'Karte erstellen', desc: 'Wir erstellen deine Stempelkarte mit deinem Branding in unter 24 Stunden.' },
  { step: '02', title: 'Gäste einladen', desc: 'Gäste scannen einmal einen QR-Code und speichern die Karte im Wallet.' },
  { step: '03', title: 'Stempel vergeben', desc: 'Ein Klick – der Stempel landet sofort auf dem Handy deines Gastes.' },
  { step: '04', title: 'Kunden binden', desc: 'Push-Nachrichten, Statistiken, automatische Belohnungen. Alles inklusive.' },
]

const cities = [
  { label: 'Köln',        href: '/koeln',        emoji: '🏙️', available: true  },
  { label: 'Berlin',      href: '/berlin',       emoji: '🐻', available: true  },
  { label: 'Düsseldorf',  href: '/duesseldorf',  emoji: '🌉', available: true  },
  { label: 'Bonn',        href: '/bonn',         emoji: '🎓', available: true  },
  { label: 'Hürth',       href: '/huerth',       emoji: '📍', available: true  },
  { label: 'Weitere Städte', href: '#',          emoji: '＋', available: false },
]

const problems = [
  'Papierkarten gehen verloren oder werden vergessen',
  'Keine Daten über deine Stammkunden',
  'Kunden kommen seltener zurück als erhofft',
  'Kein direkter Kanal zu deinen Gästen',
]

const solutions = [
  'Digitale Karte immer dabei – direkt im Wallet-App',
  'Echte Statistiken: Besuche, Stempel, aktive Karten',
  'Push-Nachrichten bringen Kunden aktiv zurück',
  'Direkter Kanal zu jedem Stammgast',
]
---

<BaseLayout
  title="bonuskarte.digital – Digitale Stempelkarte für lokale Unternehmen"
  description="Mehr Stammkunden mit der digitalen Stempelkarte. Apple Wallet & Google Wallet. Kein App-Download. 90 Tage kostenlos testen."
>
  <Navbar ctaHref="/koeln" ctaLabel="Jetzt starten" />

  <!-- ── HERO ──────────────────────────────────────────────────── -->
  <section class="relative min-h-screen flex items-center bg-black overflow-hidden">
    <div class="absolute inset-0 bg-grid-white"></div>
    <!-- Gold radial glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[600px] bg-gold-600 rounded-full blur-[200px] opacity-5"></div>

    <div class="relative max-w-6xl mx-auto px-5 sm:px-8 pt-28 pb-20 w-full">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <!-- Eyebrow -->
          <div class="inline-flex items-center gap-3 border border-gold-600/30 px-4 py-2 mb-10">
            <span class="w-1 h-1 bg-gold-600 animate-pulse-slow"></span>
            <span class="text-gold-600 text-[10px] font-light tracking-[0.3em] uppercase">
              Kundenbindung für lokale Unternehmen
            </span>
          </div>

          <h1 class="text-5xl sm:text-6xl font-extralight text-white leading-[1.1] tracking-tight mb-3">
            Schluss mit
          </h1>
          <h1 class="text-5xl sm:text-6xl font-bold text-white leading-[1.1] tracking-tight mb-8">
            vergessenen<br />
            <span class="text-gold-600">Stempelkarten.</span>
          </h1>

          <p class="text-white/50 text-base leading-relaxed mb-6 max-w-md font-light">
            Die digitale Stempelkarte für lokale Unternehmen –
            direkt in Apple Wallet und Google Wallet deiner Kunden.
            Kein Papier. Keine App.
          </p>

          <div class="inline-flex items-center gap-3 border border-gold-600/30 bg-gold-600/5 px-4 py-2.5 mb-10">
            <span class="text-gold-600 text-sm">✦</span>
            <span class="text-gold-500 text-xs tracking-[0.15em] font-light">
              90 TAGE KOMPLETT KOSTENLOS — KEINE KREDITKARTE
            </span>
          </div>

          <div class="flex flex-col sm:flex-row gap-3">
            <a href="/koeln"
              class="group inline-flex items-center justify-center gap-3 bg-gold-600 hover:bg-gold-500 text-black px-8 py-4 text-xs font-bold tracking-[0.2em] uppercase transition-all">
              Demo anfordern
              <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
            <a href="#staedte"
              class="inline-flex items-center justify-center border border-white/10 hover:border-gold-600/40 text-white/50 hover:text-white px-8 py-4 text-xs font-medium tracking-[0.2em] uppercase transition-all">
              Städte ansehen
            </a>
          </div>

          <!-- Trust -->
          <div class="flex flex-wrap gap-5 mt-10">
            {['🔒 DSGVO', '📱 Apple & Google Wallet', '⚡ Live in 24h', '✅ Kein Risiko'].map(t => (
              <span class="text-[10px] tracking-widest uppercase text-white/25">{t}</span>
            ))}
          </div>
        </div>

        <!-- Wallet card -->
        <div class="flex justify-center lg:justify-end">
          <WalletMockup businessName="Dein Unternehmen" reward="Gratis-Produkt" stamped={6} total={10} />
        </div>
      </div>
    </div>

    <!-- Bottom fade to next section -->
    <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-black to-transparent"></div>
  </section>

  <!-- ── PROBLEM / SOLUTION ────────────────────────────────────── -->
  <section class="py-24 px-5 sm:px-8 bg-black">
    <div class="max-w-6xl mx-auto">
      <!-- Divider label -->
      <div class="flex items-center gap-4 mb-14">
        <div class="h-px flex-1 bg-white/5"></div>
        <span class="text-[10px] tracking-[0.4em] uppercase text-white/20">Das Problem</span>
        <div class="h-px flex-1 bg-white/5"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <div class="border border-white/5 p-8">
          <p class="text-xs tracking-[0.3em] uppercase text-white/30 mb-6">Papierstempelkarte</p>
          <ul class="space-y-4">
            {problems.map(t => (
              <li class="flex items-start gap-3 text-sm text-white/40 font-light">
                <span class="text-white/20 mt-0.5 flex-shrink-0">—</span>
                {t}
              </li>
            ))}
          </ul>
        </div>

        <div class="border border-gold-600/30 bg-gold-600/3 p-8">
          <p class="text-xs tracking-[0.3em] uppercase text-gold-600 mb-6">bonuskarte.digital</p>
          <ul class="space-y-4">
            {solutions.map(t => (
              <li class="flex items-start gap-3 text-sm text-white/70 font-light">
                <span class="text-gold-600 mt-0.5 flex-shrink-0">✦</span>
                {t}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ── HOW IT WORKS ──────────────────────────────────────────── -->
  <section id="wie-es-funktioniert" class="py-24 px-5 sm:px-8 bg-ink-950 relative overflow-hidden">
    <div class="absolute inset-0 bg-grid-white opacity-50"></div>
    <div class="relative max-w-6xl mx-auto">
      <div class="flex items-center gap-4 mb-14">
        <div class="h-px flex-1 bg-white/5"></div>
        <span class="text-[10px] tracking-[0.4em] uppercase text-white/20">Wie es funktioniert</span>
        <div class="h-px flex-1 bg-white/5"></div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {howItWorks.map((item, i) => (
          <div class="group border border-white/5 hover:border-gold-600/30 p-7 transition-all">
            <div class="text-4xl font-black text-gold-600/20 group-hover:text-gold-600/40 transition-colors leading-none mb-6">{item.step}</div>
            <h3 class="font-semibold text-white tracking-wide mb-3 text-sm">{item.title}</h3>
            <p class="text-white/35 text-sm leading-relaxed font-light">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── STÄDTE ────────────────────────────────────────────────── -->
  <section id="staedte" class="py-24 px-5 sm:px-8 bg-black">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-center gap-4 mb-14">
        <div class="h-px flex-1 bg-white/5"></div>
        <span class="text-[10px] tracking-[0.4em] uppercase text-white/20">Verfügbare Städte</span>
        <div class="h-px flex-1 bg-white/5"></div>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
        {cities.map(c => (
          c.available ? (
            <a href={c.href}
              class="group border border-gold-600/30 hover:border-gold-600 hover:bg-gold-600/5 p-6 text-center transition-all">
              <div class="text-3xl mb-3 group-hover:scale-110 transition-transform">{c.emoji}</div>
              <div class="text-xs font-semibold tracking-widest uppercase text-white group-hover:text-gold-400">{c.label}</div>
              <div class="mt-3 text-[10px] tracking-[0.2em] uppercase text-gold-600 flex items-center justify-center gap-1">
                Zur Stadt
                <svg class="w-2.5 h-2.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
                </svg>
              </div>
            </a>
          ) : (
            <div class="border border-white/5 p-6 text-center opacity-30">
              <div class="text-3xl mb-3">{c.emoji}</div>
              <div class="text-xs font-semibold tracking-widest uppercase text-white/50">{c.label}</div>
              <div class="mt-3 text-[10px] tracking-[0.2em] uppercase text-white/20">Bald verfügbar</div>
            </div>
          )
        ))}
      </div>
    </div>
  </section>

  <!-- ── FINAL CTA ─────────────────────────────────────────────── -->
  <section class="py-28 px-5 sm:px-8 bg-black border-t border-white/5 relative overflow-hidden">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-gold-600 rounded-full blur-[150px] opacity-5"></div>
    <div class="relative max-w-3xl mx-auto text-center">
      <p class="text-gold-600 text-[10px] tracking-[0.4em] uppercase mb-6">90 Tage kostenlos</p>
      <h2 class="text-4xl sm:text-5xl font-extralight text-white tracking-tight mb-2">
        Bereit für mehr
      </h2>
      <h2 class="text-4xl sm:text-5xl font-bold text-white tracking-tight mb-8">
        Stammkunden?
      </h2>
      <p class="text-white/30 text-sm tracking-widest uppercase mb-10">Keine Kreditkarte. Kein Vertrag. Kein Risiko.</p>
      <a href="/koeln"
        class="group inline-flex items-center gap-3 bg-gold-600 hover:bg-gold-500 text-black px-10 py-5 text-xs font-bold tracking-[0.25em] uppercase transition-all">
        Kostenlos starten
        <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </section>

  <Footer />
</BaseLayout>
