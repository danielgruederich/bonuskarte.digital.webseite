---
import BaseLayout from '../layouts/BaseLayout.astro'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'
import PhoneMockup from '../components/PhoneMockup.tsx'
import RotatingWord from '../components/RotatingWord.tsx'

const howItWorks = [
  { step: '01', title: 'Karte erstellen', desc: 'Wir erstellen deine Stempelkarte mit deinem Branding in unter 24 Stunden.' },
  { step: '02', title: 'Gäste einladen', desc: 'Gäste scannen einmal einen QR-Code und speichern die Karte im Wallet.' },
  { step: '03', title: 'Stempel vergeben', desc: 'Ein Klick – der Stempel landet sofort auf dem Handy deines Gastes.' },
  { step: '04', title: 'Kunden binden', desc: 'Push-Nachrichten, Statistiken, automatische Belohnungen. Alles inklusive.' },
]

const cities = [
  { label: 'Köln',        href: '/koeln',        emoji: '🏙️', available: true  },
  { label: 'Berlin',      href: '/berlin',       emoji: '🐻', available: true  },
  { label: 'Düsseldorf',  href: '/duesseldorf',  emoji: '🌉', available: true  },
  { label: 'Bonn',        href: '/bonn',         emoji: '🎓', available: true  },
  { label: 'Hürth',       href: '/huerth',       emoji: '📍', available: true  },
  { label: 'Weitere Städte', href: '#',          emoji: '＋', available: false },
]

const problems = [
  'Du weißt nicht, wie viele Stempelkarten aktiv genutzt werden',
  'Kein direkter Kanal zu deinen Stammgästen',
  'Gäste kommen unregelmäßig – ohne Anreiz zum Wiederkommen',
  'Papier-Karten geben dir null Daten über dein Geschäft',
]

const solutions = [
  'Karte immer beim Gast – direkt in Apple & Google Wallet',
  'Echte Zahlen: aktive Karten, Stempel, Einlösungsrate',
  'Push-Nachrichten bringen Gäste aktiv zurück in dein Lokal',
  'Du siehst genau, welche Stammkunden du hast – und wer fehlt',
]
---

<BaseLayout
  title="Digitale Stempelkarte für Gastronomen in Köln – bonuskarte.digital"
  description="Mehr Stammkunden mit der digitalen Stempelkarte für Cafés, Restaurants & Dönerläden in Köln. Apple Wallet & Google Wallet. Kein App-Download. 90 Tage kostenlos testen."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "bonuskarte.digital",
    "url": "https://bonuskarte.digital",
    "description": "Digitale Stempelkarten für Apple Wallet & Google Wallet. Für Cafés, Restaurants, Dönerläden und Pizzerien in Deutschland.",
    "inLanguage": "de-DE"
  })} />
  <Navbar ctaHref="/koeln" ctaLabel="Jetzt starten" />

  <!-- ── HERO ──────────────────────────────────────────────────── -->
  <section class="relative flex items-center bg-black overflow-hidden">
    <div class="absolute inset-0 bg-grid-white"></div>
    <!-- Gold radial glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[600px] bg-gold-600 rounded-full blur-[200px] opacity-5"></div>

    <div class="relative max-w-6xl mx-auto px-5 sm:px-8 pt-20 md:pt-24 pb-8 md:pb-12 w-full">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-12 lg:gap-16 items-stretch">
        <div class="text-center md:text-left">
          <!-- Eyebrow (fills full width with random branches) -->
          <div id="eyebrow-bar" class="w-full overflow-hidden border border-gold-600/30 px-4 py-2 mb-6 sm:mb-10">
            <div class="flex items-center gap-3">
              <span class="w-1 h-1 bg-gold-600 animate-pulse-slow flex-shrink-0"></span>
              <span id="eyebrow-text" class="text-gold-600 text-[10px] font-light tracking-[0.3em] uppercase whitespace-nowrap overflow-hidden">
                Für Cafés · Restaurants · Dönerläden · Pizzerien · Eiscafés
              </span>
            </div>
          </div>
          <script is:inline>
              const branches = [
                'Cafés', 'Restaurants', 'Dönerläden', 'Pizzerien', 'Eiscafés',
                'Bäckereien', 'Friseure', 'Barbershops', 'Nagelstudios', 'Kosmetikstudios',
                'Fitnessstudios', 'Yoga-Studios', 'Tattoo-Studios', 'Blumenläden',
                'Weinbars', 'Cocktailbars', 'Bubble-Tea-Shops', 'Sushi-Bars',
                'Burger-Läden', 'Shisha-Lounges', 'Hundesalons', 'Massagestudios',
                'Brauereien', 'Buchhandlungen', 'Kioske', 'Waschsalons',
                'Fahrradwerkstätten', 'Autowaschanlagen', 'Imbisse', 'Boba-Shops'
              ];
              var el = document.getElementById('eyebrow-text');
              var bar = document.getElementById('eyebrow-bar');
              var shuffled = branches.sort(function() { return Math.random() - 0.5; });
              var sep = ' · ';
              var text = 'Für ' + shuffled[0];
              el.textContent = text;
              var maxWidth = bar.clientWidth - 40;
              for (var i = 1; i < shuffled.length; i++) {
                var next = text + sep + shuffled[i];
                el.textContent = next;
                if (el.scrollWidth > maxWidth) {
                  el.textContent = text;
                  break;
                }
                text = next;
              }
          </script>

          <h1 class="text-5xl sm:text-6xl tracking-tighter mb-5 sm:mb-8">
            <span class="font-extralight text-white block">Die digitale</span>
            <span class="block"><RotatingWord client:idle /></span>
            <span class="font-bold text-white block">für Kölner</span>
            <span class="font-bold text-gold-600 block">Gastronomen.</span>
          </h1>

          <p class="text-white text-base leading-relaxed mb-6 max-w-md mx-auto md:mx-0 font-light">
            Mehr Stammgäste, messbar mehr Umsatz. Deine Kunden
            tragen die Stempelkarte direkt im Handy –
            kein Papier, keine App, kein Aufwand für dich.
          </p>

          <div class="inline-flex items-center gap-3 border border-gold-600/30 bg-gold-600/5 px-4 py-2.5 mb-6 sm:mb-10">
            <span class="text-gold-600 text-sm">✦</span>
            <span class="text-gold-500 text-xs tracking-[0.15em] font-light">
              90 TAGE KOMPLETT KOSTENLOS — KEINE KREDITKARTE
            </span>
          </div>

          <div class="flex flex-col sm:flex-row gap-3 justify-center md:justify-start">
            <a href="/koeln"
              class="group inline-flex items-center justify-center gap-3 bg-gold-600 hover:bg-gold-500 text-black px-8 py-4 text-xs font-bold tracking-[0.2em] uppercase transition-all">
              Für mein Lokal starten
              <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
            <a href="#staedte"
              class="inline-flex items-center justify-center border border-white/10 hover:border-gold-600/40 text-white hover:text-white px-8 py-4 text-xs font-medium tracking-[0.2em] uppercase transition-all">
              Städte ansehen
            </a>
          </div>

          <!-- Trust -->
          <div class="flex flex-wrap gap-5 mt-6 sm:mt-10 justify-center md:justify-start">
            {['🔒 DSGVO', '📱 Apple & Google Wallet', '⚡ Live in 24h', '✅ Kein Risiko'].map(t => (
              <span class="text-[10px] tracking-widest uppercase text-white">{t}</span>
            ))}
          </div>
        </div>

        <!-- Phone Mockup -->
        <div class="flex justify-center md:justify-end items-center h-full">
          <PhoneMockup client:visible />
        </div>
      </div>
    </div>

    <!-- Bottom fade to next section -->
    <div class="absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-t from-black to-transparent"></div>
  </section>

  <!-- ── PROBLEM / SOLUTION ────────────────────────────────────── -->
  <section class="py-8 sm:py-16 px-5 sm:px-8 bg-black">
    <div class="max-w-6xl mx-auto">
      <!-- Divider label -->
      <div class="flex items-center gap-4 mb-8 sm:mb-12">
        <div class="h-px flex-1 bg-white/5"></div>
        <span class="text-[10px] tracking-[0.4em] uppercase text-white">Das Problem</span>
        <div class="h-px flex-1 bg-white/5"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <div class="border border-white/5 p-8">
          <p class="text-xs tracking-[0.3em] uppercase text-white mb-6">Papierstempelkarte</p>
          <ul class="space-y-4">
            {problems.map(t => (
              <li class="flex items-start gap-3 text-xl text-white font-light">
                <span class="text-white mt-0.5 flex-shrink-0">—</span>
                {t}
              </li>
            ))}
          </ul>
        </div>

        <div class="border border-gold-600/30 bg-gold-600/3 p-8">
          <p class="text-xs tracking-[0.3em] uppercase text-gold-600 mb-6">bonuskarte.digital</p>
          <ul class="space-y-4">
            {solutions.map(t => (
              <li class="flex items-start gap-3 text-xl text-white font-light">
                <span class="text-gold-600 mt-0.5 flex-shrink-0">✦</span>
                {t}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ── HOW IT WORKS ──────────────────────────────────────────── -->
  <section id="wie-es-funktioniert" class="py-8 sm:py-16 px-5 sm:px-8 bg-ink-950 relative overflow-hidden">
    <div class="absolute inset-0 bg-grid-white opacity-50"></div>
    <div class="relative max-w-6xl mx-auto">
      <div class="flex items-center gap-4 mb-6 sm:mb-10">
        <div class="h-px flex-1 bg-white/5"></div>
        <span class="text-xs tracking-[0.4em] uppercase text-white">Wie es funktioniert</span>
        <div class="h-px flex-1 bg-white/5"></div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {howItWorks.map((item, i) => (
          <div class="group border border-white/5 hover:border-gold-600/30 p-7 transition-all">
            <div class="text-4xl font-black text-gold-400 group-hover:text-gold-300 transition-colors leading-none mb-4">{item.step}</div>
            <h3 class="font-semibold text-white tracking-wide mb-2 text-lg">{item.title}</h3>
            <p class="text-white text-base leading-relaxed font-light">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── SOCIAL PROOF ───────────────────────────────────────────── -->
  <section class="py-8 sm:py-16 px-5 sm:px-8 bg-black">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-center gap-4 mb-6 sm:mb-10">
        <div class="h-px flex-1 bg-white/5"></div>
        <span class="text-xs tracking-[0.4em] uppercase text-white">Das sagen unsere Kunden</span>
        <div class="h-px flex-1 bg-white/5"></div>
      </div>

      <!-- Stats -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-5 mb-8">
        {[
          { value: '35+', label: 'Betriebe aktiv' },
          { value: '2.400+', label: 'Karten im Umlauf' },
          { value: '5', label: 'Städte live' },
          { value: '24h', label: 'Setup-Zeit' },
        ].map(stat => (
          <div class="border border-white/5 p-6 text-center">
            <div class="text-3xl sm:text-4xl font-black text-gold-600 mb-2">{stat.value}</div>
            <div class="text-xs tracking-[0.25em] uppercase text-white">{stat.label}</div>
          </div>
        ))}
      </div>

      <!-- Testimonials -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {[
          {
            quote: 'Unsere Gäste lieben es. Kein Papier mehr, kein Nachfragen – die Karte ist einfach immer da.',
            name: 'Maria K.',
            role: 'Inhaberin, Café Sonnenschein',
            location: 'Köln-Ehrenfeld',
          },
          {
            quote: 'In 3 Wochen hatten wir über 80 digitale Stammkarten vergeben. Das hätten wir mit Papier nie geschafft.',
            name: 'Hasan Y.',
            role: 'Inhaber, Döner Meister',
            location: 'Köln-Nippes',
          },
          {
            quote: 'Die Push-Nachrichten bringen Gäste wirklich zurück. Wir sehen den Unterschied in der Kasse.',
            name: 'Laura S.',
            role: 'Geschäftsführerin, Trattoria Bella',
            location: 'Köln-Innenstadt',
          },
        ].map(t => (
          <div class="border border-white/5 hover:border-gold-600/20 p-6 transition-colors">
            <div class="text-gold-600 text-lg mb-3">"</div>
            <p class="text-white text-base font-light leading-relaxed mb-4">{t.quote}</p>
            <div>
              <p class="text-white text-base font-semibold">{t.name}</p>
              <p class="text-white text-sm font-light">{t.role}</p>
              <p class="text-gold-600 text-sm font-light">{t.location}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── STÄDTE ────────────────────────────────────────────────── -->
  <section id="staedte" class="py-8 sm:py-16 px-5 sm:px-8 bg-black">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-center gap-4 mb-6 sm:mb-10">
        <div class="h-px flex-1 bg-white/5"></div>
        <span class="text-xs tracking-[0.4em] uppercase text-white">Verfügbare Städte</span>
        <div class="h-px flex-1 bg-white/5"></div>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
        {cities.map(c => (
          c.available ? (
            <a href={c.href}
              class="group border border-gold-600/30 hover:border-gold-600 hover:bg-gold-600/5 p-6 text-center transition-all">
              <div class="text-3xl mb-3 group-hover:scale-110 transition-transform">{c.emoji}</div>
              <div class="text-xs font-semibold tracking-widest uppercase text-white group-hover:text-gold-400">{c.label}</div>
              <div class="mt-3 text-[10px] tracking-[0.2em] uppercase text-gold-600 flex items-center justify-center gap-1">
                Zur Stadt
                <svg class="w-2.5 h-2.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
                </svg>
              </div>
            </a>
          ) : (
            <div class="border border-white/10 p-6 text-center">
              <div class="text-3xl mb-3">{c.emoji}</div>
              <div class="text-xs font-semibold tracking-widest uppercase text-white">{c.label}</div>
              <div class="mt-3 text-[10px] tracking-[0.2em] uppercase text-white">Bald verfügbar</div>
            </div>
          )
        ))}
      </div>
    </div>
  </section>

  <!-- ── FINAL CTA ─────────────────────────────────────────────── -->
  <section class="py-16 sm:py-28 px-5 sm:px-8 bg-black border-t border-white/5 relative overflow-hidden">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-gold-600 rounded-full blur-[150px] opacity-5"></div>
    <div class="relative max-w-3xl mx-auto text-center">
      <p class="text-gold-600 text-xs tracking-[0.4em] uppercase mb-6">90 Tage kostenlos</p>
      <h2 class="text-4xl sm:text-5xl font-extralight text-white tracking-tight mb-2">
        Bereit für mehr
      </h2>
      <h2 class="text-4xl sm:text-5xl font-bold text-white tracking-tight mb-8">
        Stammkunden?
      </h2>
      <p class="text-white text-sm tracking-widest uppercase mb-10">Keine Kreditkarte. Monatlich kündbar. Kein Risiko.</p>
      <a href="/koeln"
        class="group inline-flex items-center gap-3 bg-gold-600 hover:bg-gold-500 text-black px-10 py-5 text-xs font-bold tracking-[0.25em] uppercase transition-all">
        Kostenlos starten
        <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </section>

  <Footer />
</BaseLayout>
