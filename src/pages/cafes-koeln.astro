---
import BaseLayout from '../layouts/BaseLayout.astro'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'
import WalletMockup from '../components/WalletMockup.astro'
import LeadForm from '../components/LeadForm.tsx'

const FORMSPREE_ID = 'YOUR_FORM_ID'

const steps = [
  { n: '01', title: 'Demo laden', desc: 'Ein Scan, und die Karte liegt im Wallet. Kein Download, keine Registrierung.' },
  { n: '02', title: 'Wir bauen eure Karte', desc: 'In unter 24h erhält ihr eine fertige Karte mit eurem Branding.' },
  { n: '03', title: 'Gäste stempeln lassen', desc: 'Eure Gäste speichern die Karte direkt in Apple oder Google Wallet.' },
]

const benefits = [
  { icon: '📱', title: 'Immer dabei', desc: 'Apple Wallet & Google Wallet. Keine App, keine Registrierung für eure Gäste.' },
  { icon: '🔔', title: 'Push-Nachrichten', desc: 'Erinnert Stammkunden an Aktionen – direkt auf dem Sperrbildschirm.' },
  { icon: '📊', title: 'Live-Statistiken', desc: 'Seht in Echtzeit, wie viele Karten aktiv sind und wie oft gestempelt wird.' },
  { icon: '⚙️', title: 'Zero Aufwand', desc: 'Einmal einrichten, dauerhaft nutzen. Wir kümmern uns um alles Technische.' },
  { icon: '♻️', title: 'Nachhaltig', desc: 'Kein Papier, keine Plastikkarten, kein Nachdrucken.' },
  { icon: '🤝', title: 'Persönliche Note', desc: 'Wir sitzen im selben Veedel. Ein gemeinsames Dinner nach dem erfolgreichen Start.' },
]

const deal = [
  { label: 'Einmaliges Investment', value: '100 € Setup-Gebühr.' },
  { label: 'Kein Abo', value: 'Keine monatlichen Fixkosten, keine versteckten Gebühren.' },
  { label: 'Persönliche Note', value: 'Ein gemeinsames Dinner nach dem erfolgreichen Start – wir sitzen im selben Veedel.' },
  { label: 'Rechtssicher', value: 'Optimierte AGB inklusive unbegrenzter Gültigkeit der Stempel und Belohnungen.' },
]

const faq = [
  { q: 'Brauchen unsere Gäste eine App?', a: 'Nein. Die Karte wird direkt in der nativen Wallet-App von iPhone oder Android gespeichert. Kein Download erforderlich.' },
  { q: 'Wie stempeln wir die Karte ab?', a: 'Mit einem einzigen Klick im Dashboard oder direkt vom Handy aus. Der Stempel landet sofort beim Gast.' },
  { q: 'Was passiert nach den 90 Tagen?', a: 'Ihr entscheidet, ob ihr weitermachen möchtet. Keine automatische Verlängerung ohne eure Zustimmung.' },
  { q: 'Können wir die Karte anpassen?', a: 'Ja – Farben, Logo, Stempelanzahl, Belohnungen und Push-Nachrichten sind vollständig individualisierbar.' },
]

const whatsappUrl = 'https://wa.me/491705594140'
---

<BaseLayout
  title="Digitale Stempelkarte für Cafés in Köln – 90 Tage gratis | bonuskarte.digital"
  description="Digitale Kundenbindung für Kölner Institutionen. Ein fester Platz im Smartphone-Wallet eurer Gäste. Ohne App-Download, ohne Papierchaos."
>
  <Navbar ctaHref="#demo" ctaLabel="Demo anfordern" />

  <!-- ── HERO ─────────────────────────────────────────────────── -->
  <section class="relative min-h-screen flex items-center bg-black overflow-hidden">
    <div class="absolute inset-0 bg-grid-white"></div>
    <div class="absolute top-1/2 -right-40 w-[600px] h-[600px] bg-gold-600 rounded-full blur-[200px] opacity-5"></div>

    <div class="relative max-w-6xl mx-auto px-5 sm:px-8 pt-28 pb-20 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center w-full">
      <div>
        <div class="inline-flex items-center gap-3 border border-gold-600/30 px-4 py-2 mb-10">
          <span class="w-1 h-1 bg-gold-600 animate-pulse-slow"></span>
          <span class="text-gold-600 text-[10px] font-light tracking-[0.3em] uppercase">
            Jetzt für Cafés in Köln
          </span>
        </div>

        <h1 class="text-5xl sm:text-6xl font-extralight text-white leading-[1.1] tracking-tight mb-2">
          Macht aus Laufkundschaft
        </h1>
        <h1 class="text-5xl sm:text-6xl font-bold leading-[1.1] tracking-tight mb-8">
          <span class="text-gold-600">eine Community.</span>
        </h1>

        <p class="text-white/50 text-base leading-relaxed mb-6 max-w-md font-light">
          Digitale Kundenbindung für Kölner Institutionen. Ohne App-Download,
          ohne Papierchaos – ein fester Platz im Smartphone-Wallet eurer Gäste.
          Ein moderner Anker für euer Veedel.
        </p>

        <div class="inline-flex items-center gap-3 border border-gold-600/30 bg-gold-600/5 px-4 py-2.5 mb-10">
          <span class="text-gold-600 text-sm">✦</span>
          <span class="text-gold-500 text-xs tracking-[0.15em] font-light">
            90 TAGE KOMPLETT KOSTENLOS — KEIN KNEBELVERTRAG
          </span>
        </div>

        <div class="flex flex-col sm:flex-row gap-3">
          <a href="#demo"
            class="group inline-flex items-center justify-center gap-3 bg-gold-600 hover:bg-gold-500 text-black px-8 py-4 text-xs font-bold tracking-[0.2em] uppercase transition-all">
            Demo-Karte laden
            <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
          <a href="#deal"
            class="inline-flex items-center justify-center border border-white/10 hover:border-gold-600/40 text-white/50 hover:text-white px-8 py-4 text-xs font-medium tracking-[0.2em] uppercase transition-all">
            Der Veedels-Deal
          </a>
        </div>

        <div class="flex flex-wrap gap-5 mt-10">
          {['🔒 DSGVO', '📱 Apple & Google Wallet', '⚡ Live in 24h', '🤝 Kein Abo'].map(t => (
            <span class="text-[10px] tracking-widest uppercase text-white/20">{t}</span>
          ))}
        </div>
      </div>

      <div class="flex justify-center lg:justify-end">
        <WalletMockup businessName="Café Sonnenschein" reward="Gratis-Kaffee" stamped={7} total={10} />
      </div>
    </div>

    <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-black to-transparent"></div>
  </section>

  <!-- ── HOW IT WORKS ──────────────────────────────────────────── -->
  <section id="wie-es-funktioniert" class="py-24 px-5 sm:px-8 bg-black">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-center gap-4 mb-14">
        <div class="h-px flex-1 bg-white/5"></div>
        <span class="text-[10px] tracking-[0.4em] uppercase text-white/20">In 3 Schritten live</span>
        <div class="h-px flex-1 bg-white/5"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {steps.map((s) => (
          <div class="group border border-white/5 hover:border-gold-600/30 p-8 transition-all">
            <div class="text-4xl font-black text-gold-600/20 group-hover:text-gold-600/40 transition-colors leading-none mb-6">{s.n}</div>
            <h3 class="font-semibold text-white tracking-wide mb-3 text-sm">{s.title}</h3>
            <p class="text-white/35 text-sm leading-relaxed font-light">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── BENEFITS ──────────────────────────────────────────────── -->
  <section class="py-24 px-5 sm:px-8 bg-ink-950 relative overflow-hidden">
    <div class="absolute inset-0 bg-grid-white opacity-50"></div>
    <div class="relative max-w-6xl mx-auto">
      <div class="flex items-center gap-4 mb-14">
        <div class="h-px flex-1 bg-white/5"></div>
        <span class="text-[10px] tracking-[0.4em] uppercase text-white/20">Features</span>
        <div class="h-px flex-1 bg-white/5"></div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {benefits.map(b => (
          <div class="group border border-white/5 hover:border-gold-600/30 p-7 transition-all">
            <div class="text-2xl mb-4 group-hover:scale-110 transition-transform inline-block">{b.icon}</div>
            <h3 class="font-semibold text-white tracking-wide mb-2 text-sm">{b.title}</h3>
            <p class="text-white/35 text-sm leading-relaxed font-light">{b.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── DEMO SECTION ──────────────────────────────────────────── -->
  <section id="demo" class="py-24 px-5 sm:px-8 bg-black relative overflow-hidden">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] bg-gold-600 rounded-full blur-[180px] opacity-5"></div>

    <div class="relative max-w-xl mx-auto">
      <div class="text-center mb-10">
        <div class="inline-flex items-center gap-3 border border-gold-600/30 bg-gold-600/5 px-4 py-2 mb-8">
          <span class="text-gold-600 text-sm">✦</span>
          <span class="text-gold-500 text-[10px] tracking-[0.3em] uppercase">Exklusiv für Cafés in Köln</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-extralight text-white tracking-tight mb-2">
          Das Erlebnis auf dem
        </h2>
        <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight mb-6">
          eigenen Schirm.
        </h2>
        <p class="text-white/40 text-sm font-light leading-relaxed max-w-sm mx-auto">
          Ein Scan, und die Karte gehört euch. Erlebt jetzt am eigenen Smartphone,
          wie sich der „Club" für eure Gäste anfühlt. Keine komplizierte Technik,
          nur ein direkter Draht zu euren Fans.
        </p>
      </div>

      <div class="relative border border-gold-600/20 bg-ink-950 p-8 sm:p-10">
        <LeadForm client:load niche="Café" city="Köln" formspreeId={FORMSPREE_ID} whatsappUrl={whatsappUrl} />
      </div>
    </div>
  </section>

  <!-- ── VEEDELS-DEAL ──────────────────────────────────────────── -->
  <section id="deal" class="py-24 px-5 sm:px-8 bg-ink-950 relative overflow-hidden">
    <div class="absolute inset-0 bg-grid-white opacity-50"></div>
    <div class="relative max-w-3xl mx-auto">
      <div class="flex items-center gap-4 mb-14">
        <div class="h-px flex-1 bg-white/5"></div>
        <span class="text-[10px] tracking-[0.4em] uppercase text-white/20">Das Angebot</span>
        <div class="h-px flex-1 bg-white/5"></div>
      </div>

      <h2 class="text-4xl sm:text-5xl font-extralight text-white tracking-tight mb-2">Ein Deal unter</h2>
      <h2 class="text-4xl sm:text-5xl font-bold text-gold-600 tracking-tight mb-8">Nachbarn.</h2>

      <p class="text-white/50 text-base font-light leading-relaxed mb-12 max-w-xl">
        Digitalisierung muss nicht kompliziert sein und sie braucht keine Knebelverträge.
        Wir bauen das Fundament für euren Erfolg im Viertel zu fairen Konditionen:
      </p>

      <div class="space-y-4 mb-12">
        {deal.map(item => (
          <div class="flex gap-5 border border-white/5 hover:border-gold-600/20 p-6 transition-all group">
            <span class="text-gold-600 mt-0.5 flex-shrink-0">✦</span>
            <div>
              <span class="text-white font-semibold text-sm tracking-wide">{item.label}: </span>
              <span class="text-white/50 text-sm font-light">{item.value}</span>
            </div>
          </div>
        ))}
      </div>

      <div class="text-center">
        <a href="#demo"
          class="group inline-flex items-center gap-3 bg-gold-600 hover:bg-gold-500 text-black px-10 py-5 text-xs font-bold tracking-[0.25em] uppercase transition-all">
          Jetzt Demo-Karte laden
          <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ── FAQ ──────────────────────────────────────────────────── -->
  <section class="py-20 px-5 sm:px-8 bg-black">
    <div class="max-w-2xl mx-auto">
      <div class="flex items-center gap-4 mb-12">
        <div class="h-px flex-1 bg-white/5"></div>
        <span class="text-[10px] tracking-[0.4em] uppercase text-white/20">Häufige Fragen</span>
        <div class="h-px flex-1 bg-white/5"></div>
      </div>

      <div class="divide-y divide-white/5">
        {faq.map(item => (
          <details class="group py-5">
            <summary class="flex items-center justify-between cursor-pointer list-none">
              <span class="text-sm font-medium tracking-wide text-white/70 group-hover:text-white transition-colors pr-6">
                {item.q}
              </span>
              <svg class="w-4 h-4 text-gold-600 flex-shrink-0 group-open:rotate-45 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v16m8-8H4"/>
              </svg>
            </summary>
            <div class="pt-4 text-sm text-white/30 leading-relaxed font-light">
              {item.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ── FINAL CTA ─────────────────────────────────────────────── -->
  <section class="py-24 px-5 sm:px-8 bg-black border-t border-white/5 relative overflow-hidden">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[300px] bg-gold-600 rounded-full blur-[150px] opacity-5"></div>
    <div class="relative max-w-2xl mx-auto text-center">
      <p class="text-gold-600 text-[10px] tracking-[0.4em] uppercase mb-6">Kein Risiko</p>
      <h2 class="text-4xl font-extralight text-white tracking-tight mb-2">90 Tage gratis.</h2>
      <h2 class="text-4xl font-bold text-white tracking-tight mb-10">Überzeug euch selbst.</h2>
      <a href="#demo"
        class="group inline-flex items-center gap-3 bg-gold-600 hover:bg-gold-500 text-black px-10 py-5 text-xs font-bold tracking-[0.25em] uppercase transition-all">
        Jetzt Demo-Karte laden
        <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </section>

  <Footer />
</BaseLayout>
