---
import BaseLayout from '../../layouts/BaseLayout.astro'
import NavbarEn from '../../components/NavbarEn.astro'
import FooterEn from '../../components/FooterEn.astro'
import { uiEn } from '../../data/en/ui-en'
import PhoneMockup from '../../components/PhoneMockup.tsx'
import RotatingWordEn from '../../components/RotatingWordEn.tsx'
import LeadFormEn from '../../components/LeadFormEn.tsx'

const howItWorks = [
  { step: '01', title: 'Create your card', desc: 'We set up your digital loyalty card with your logo and colors in under 24 hours.' },
  { step: '02', title: 'Invite your customers', desc: 'Your customers scan a QR code and save the card straight to their Wallet — no app.' },
  { step: '03', title: 'Stamp in one click', desc: 'One click from your dashboard and the stamp appears instantly on your customer’s phone.' },
  { step: '04', title: 'Build lasting loyalty', desc: 'Push notifications, real-time stats, automatic rewards. All included, zero effort.' },
]

const problems = [
  'No way to know how many paper cards are still in use',
  'No direct channel to reach your regulars',
  'Irregular customers with no incentive to come back',
  'Zero data about your business and your customers',
]

const solutions = [
  'A card that is always there — right inside Apple & Google Wallet',
  'Real numbers: active cards, stamps, reward rate',
  'Push notifications that bring customers back at the right moment',
  'A clear dashboard: who your best regulars are',
]

const industries = [
  { emoji: '🥐', label: 'Bakeries' },
  { emoji: '☕', label: 'Cafés' },
  { emoji: '🍽️', label: 'Restaurants' },
  { emoji: '✂️', label: 'Hair salons' },
  { emoji: '🧘', label: 'Yoga studios' },
  { emoji: '🏋️', label: 'Gyms' },
]
---

<BaseLayout
  title="Digital loyalty card & stamp card for local businesses | bonuskarte.digital"
  description="The digital loyalty card and stamp card for local businesses — in Apple Wallet & Google Wallet, no app. Loyalty program with push notifications and rewards. 90 days free."
  lang="en"
  locale="en_US"
  alternates={[
    { hreflang: 'de', href: 'https://bonuskarte.digital/' },
    { hreflang: 'en', href: 'https://bonuskarte.digital/en/' },
    { hreflang: 'fr', href: 'https://bonuskarte.digital/fr/' },
    { hreflang: 'x-default', href: 'https://bonuskarte.digital/' },
  ]}
>
  <NavbarEn ctaHref="/en/#get-started" ctaLabel={uiEn.nav.cta} />

  <!-- ── HERO ──────────────────────────────────────────────────── -->
  <section class="relative flex items-center bg-paper overflow-hidden min-h-screen">
    <div class="absolute inset-0 bg-grid-ink"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[600px] bg-amber rounded-full blur-[200px] opacity-5"></div>

    <div class="relative max-w-6xl mx-auto px-5 sm:px-8 pt-20 md:pt-24 pb-8 md:pb-12 w-full">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-12 lg:gap-16 items-stretch">
        <div class="text-center md:text-left">

          <!-- Eyebrow -->
          <div class="inline-flex items-center gap-3 border border-amber/50 px-4 py-2 mb-6 sm:mb-10">
            <span class="w-1 h-1 bg-amber animate-pulse-slow flex-shrink-0"></span>
            <span class="text-amber text-[10px] sm:text-xs font-normal tracking-[0.3em] uppercase">
              Bakeries · Cafés · Restaurants · Hair salons
            </span>
          </div>

          <!-- H1 -->
          <h1 class="text-5xl sm:text-6xl leading-[1.1] tracking-tight mb-5 sm:mb-8">
            <span class="font-normal text-ink block mb-2">The digital loyalty</span>
            <RotatingWordEn client:idle />
          </h1>

          <p class="text-ink text-base leading-relaxed mb-6 max-w-md mx-auto md:mx-0 font-normal">
            More regulars, more revenue. Your digital loyalty card right inside their phone — no paper, no app, no hassle.
          </p>

          <!-- Free trial badge -->
          <div class="inline-flex items-center gap-3 border border-amber/50 bg-amber/5 px-4 py-2.5 mb-6 sm:mb-10">
            <span class="text-amber text-xs tracking-[0.15em] font-normal">
              90 DAYS FREE — NO CREDIT CARD
            </span>
          </div>

          <div class="flex flex-col sm:flex-row gap-3 justify-center md:justify-start">
            <a href="/en/#get-started"
              class="group inline-flex items-center justify-center gap-3 bg-amber hover:bg-amber-dark text-black px-8 py-4 text-xs font-bold tracking-[0.2em] uppercase transition-all">
              Start free
              <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
            <a href="/en/#how-it-works"
              class="inline-flex items-center justify-center border border-ink/10 hover:border-amber/40 text-ink px-8 py-4 text-xs font-medium tracking-[0.2em] uppercase transition-all">
              How it works
            </a>
          </div>

          <!-- Trust row -->
          <div class="flex flex-wrap gap-6 mt-6 sm:mt-10 justify-center md:justify-start">
            {uiEn.trust.map(t => (
              <span class="text-[10px] tracking-widest uppercase text-ink/50">{t}</span>
            ))}
          </div>
        </div>

        <!-- Phone Mockup -->
        <div class="flex justify-center md:justify-end items-center h-full">
          <PhoneMockup client:visible />
        </div>
      </div>
    </div>

    <!-- Bottom fade to next section -->
    <div class="absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-t from-paper to-transparent"></div>
  </section>

  <!-- ── PROBLEM / SOLUTION ────────────────────────────────────── -->
  <section class="py-8 sm:py-16 px-5 sm:px-8 bg-paper">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-center gap-4 mb-8 sm:mb-12">
        <div class="h-px flex-1 bg-ink/20"></div>
        <span class="text-xs tracking-[0.4em] uppercase text-ink">The problem</span>
        <div class="h-px flex-1 bg-ink/20"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <div class="border border-ink/30 p-8">
          <p class="text-xs tracking-[0.3em] uppercase text-ink mb-6">Paper stamp card</p>
          <ul class="space-y-4">
            {problems.map(t => (
              <li class="flex items-start gap-3 text-base text-ink font-normal">
                <span class="text-ink mt-0.5 flex-shrink-0">—</span>
                {t}
              </li>
            ))}
          </ul>
        </div>

        <div class="border border-amber/50 bg-amber/3 p-8">
          <p class="text-xs tracking-[0.3em] uppercase text-amber mb-6">bonuskarte.digital</p>
          <ul class="space-y-4">
            {solutions.map(t => (
              <li class="flex items-start gap-3 text-base text-ink font-normal">
                <span class="text-amber mt-0.5 flex-shrink-0">◆</span>
                {t}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ── HOW IT WORKS ──────────────────────────────────────────── -->
  <section id="how-it-works" class="scroll-mt-20 py-8 sm:py-16 px-5 sm:px-8 bg-paper relative overflow-hidden">
    <div class="absolute inset-0 bg-grid-ink opacity-50"></div>
    <div class="relative max-w-6xl mx-auto">
      <div class="flex items-center gap-4 mb-6 sm:mb-10">
        <div class="h-px flex-1 bg-ink/20"></div>
        <span class="text-xs tracking-[0.4em] uppercase text-ink">How the digital loyalty card works</span>
        <div class="h-px flex-1 bg-ink/20"></div>
      </div>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-5">
        {howItWorks.map(item => (
          <div class="group border border-ink/30 hover:border-amber/50 p-4 sm:p-7 transition-all">
            <div class="text-4xl font-black text-amber group-hover:text-amber transition-colors leading-none mb-3">{item.step}</div>
            <h3 class="font-semibold text-ink tracking-wide mb-1 text-sm">{item.title}</h3>
            <p class="text-ink text-sm leading-relaxed font-normal">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── INDUSTRIES ────────────────────────────────────────────── -->
  <section id="industries" class="scroll-mt-20 py-8 sm:py-16 px-5 sm:px-8 bg-paper">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-center gap-4 mb-6 sm:mb-10">
        <div class="h-px flex-1 bg-ink/20"></div>
        <span class="text-xs tracking-[0.4em] uppercase text-ink">Loyalty cards for every local business</span>
        <div class="h-px flex-1 bg-ink/20"></div>
      </div>

      <p class="text-ink/40 text-sm font-normal text-center mb-10 max-w-xl mx-auto">
        Bakeries, cafés, restaurants, hair salons, kebab shops, pizzerias, ice cream shops, florists, gyms, beauty salons — the digital loyalty card fits every kind of local business.
      </p>

      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mb-10">
        {industries.map(n => (
          <a href="/en/cards"
            class="group border border-ink/30 hover:border-amber hover:bg-amber/5 p-5 text-center transition-all hover:-translate-y-1">
            <div class="text-3xl mb-3 group-hover:scale-110 transition-transform">{n.emoji}</div>
            <div class="text-xs font-semibold tracking-widest uppercase text-ink group-hover:text-amber transition-colors">{n.label}</div>
          </a>
        ))}
      </div>

      <div class="text-center">
        <a href="/en/cards"
          class="group inline-flex items-center gap-2 border border-amber/50 hover:border-amber text-amber px-8 py-3 text-xs font-bold tracking-widest uppercase transition-all">
          See all card types
          <svg class="w-3 h-3 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ── PRICING TEASER ────────────────────────────────────────── -->
  <section class="py-8 sm:py-16 px-5 sm:px-8 bg-paper relative overflow-hidden">
    <div class="absolute inset-0 bg-grid-ink opacity-50"></div>
    <div class="relative max-w-3xl mx-auto text-center">
      <div class="flex items-center gap-4 mb-8">
        <div class="h-px flex-1 bg-ink/20"></div>
        <span class="text-xs tracking-[0.4em] uppercase text-ink">Pricing</span>
        <div class="h-px flex-1 bg-ink/20"></div>
      </div>

      <p class="text-amber text-xs tracking-[0.4em] uppercase mb-4">No commitment</p>
      <h2 class="text-4xl sm:text-5xl font-normal text-ink tracking-tight mb-2">
        90 days free.
      </h2>
      <h2 class="text-4xl sm:text-5xl font-bold text-ink tracking-tight mb-8">
        Then from €29/month.
      </h2>
      <p class="text-ink/40 text-sm font-normal mb-10 max-w-lg mx-auto">
        Unlimited cards, push notifications, real-time stats — all included. No setup fee. Cancel any month.
      </p>
      <a href="/en/pricing"
        class="group inline-flex items-center gap-3 border border-amber/40 hover:border-amber text-amber px-8 py-4 text-xs font-bold tracking-widest uppercase transition-all">
        See full pricing
        <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </section>

  <!-- ── FAQ ────────────────────────────────────────────────────── -->
  <section id="faq" class="scroll-mt-20 py-8 sm:py-16 px-5 sm:px-8 bg-paper">
    <div class="max-w-3xl mx-auto">
      <div class="flex items-center gap-4 mb-6 sm:mb-10">
        <div class="h-px flex-1 bg-ink/20"></div>
        <span class="text-xs tracking-[0.4em] uppercase text-ink">Frequently asked questions</span>
        <div class="h-px flex-1 bg-ink/20"></div>
      </div>

      <div class="space-y-4">
        {[
          {
            q: 'Are the 90 days really free?',
            a: 'Yes, with no strings attached. No credit card required. After 90 days you decide whether to continue — from €29/month, no commitment, cancel any time.',
          },
          {
            q: 'Do my customers need to download an app?',
            a: 'No. The card is saved directly to Apple Wallet or Google Wallet, preinstalled on every smartphone. No account, no download for your customers.',
          },
          {
            q: 'How long does setup take?',
            a: 'You fill out a form in 5 minutes. We create your card with your logo and colors. You are live in under 24 hours.',
          },
          {
            q: 'Is it GDPR compliant?',
            a: 'Yes. All data is processed in line with the GDPR. No tracking cookies on your customers’ phones, no reselling of data.',
          },
          {
            q: 'What kind of business does it work for?',
            a: 'Bakeries, cafés, restaurants, hair salons, kebab shops, pizzerias, ice cream shops, florists, gyms, beauty salons — and many more. If you have regular customers, it works for you.',
          },
          {
            q: 'What if my customer loses their phone?',
            a: 'The card is tied to the customer’s Apple or Google account. It is automatically restored on the new device — stamps and progress are kept.',
          },
        ].map(faq => (
          <details class="group border border-ink/30 hover:border-amber/20 transition-colors">
            <summary class="flex items-center justify-between cursor-pointer p-5 sm:p-6">
              <span class="text-ink text-sm font-medium pr-4">{faq.q}</span>
              <svg class="w-4 h-4 text-amber flex-shrink-0 group-open:rotate-45 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
              </svg>
            </summary>
            <div class="px-5 sm:px-6 pb-5 sm:pb-6">
              <p class="text-ink text-sm leading-relaxed font-normal">{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ── GET STARTED ───────────────────────────────────────────── -->
  <section id="get-started" class="scroll-mt-20 py-8 sm:py-16 px-5 sm:px-8 bg-paper">
    <div class="max-w-2xl mx-auto">
      <div class="flex items-center gap-4 mb-8 sm:mb-12">
        <div class="h-px flex-1 bg-ink/20"></div>
        <span class="text-xs tracking-[0.4em] uppercase text-ink">Get started</span>
        <div class="h-px flex-1 bg-ink/20"></div>
      </div>

      <div class="text-center mb-10">
        <h2 class="text-3xl sm:text-4xl font-normal text-ink tracking-tight mb-3">
          Get your <span class="font-bold text-amber">digital loyalty card</span>
        </h2>
        <p class="text-ink/60 text-sm font-normal max-w-md mx-auto">
          Fill in 3 fields and we build your free demo card for Apple Wallet & Google Wallet — live in 24 hours.
        </p>
      </div>

      <div class="border border-amber/20 bg-paper p-8 sm:p-10">
        <LeadFormEn client:load whatsappUrl="https://wa.me/491705594140" />
      </div>
    </div>
  </section>

  <!-- ── FINAL CTA ─────────────────────────────────────────────── -->
  <section class="py-16 sm:py-28 px-5 sm:px-8 bg-paper border-t border-ink/30 relative overflow-hidden">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-amber rounded-full blur-[150px] opacity-5"></div>
    <div class="relative max-w-3xl mx-auto text-center">
      <p class="text-amber text-xs tracking-[0.4em] uppercase mb-6">90 days free</p>
      <h2 class="text-4xl sm:text-5xl font-normal text-ink tracking-tight mb-2">
        Ready to keep
      </h2>
      <h2 class="text-4xl sm:text-5xl font-bold text-ink tracking-tight mb-8">
        your customers coming back?
      </h2>
      <p class="text-ink text-xs tracking-widest uppercase mb-10">No credit card. Cancel any month. Zero risk.</p>
      <a href="/en/#get-started"
        class="group inline-flex items-center gap-3 bg-amber hover:bg-amber-dark text-black px-10 py-5 text-xs font-bold tracking-[0.25em] uppercase transition-all">
        Start free
        <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>

      <!-- Trust row -->
      <div class="flex flex-wrap gap-6 mt-10 justify-center">
        {uiEn.trust.map(t => (
          <span class="text-[10px] tracking-widest uppercase text-ink/50">{t}</span>
        ))}
      </div>
    </div>
  </section>

  <FooterEn />
</BaseLayout>
