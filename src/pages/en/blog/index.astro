---
import BaseLayout from '@/layouts/BaseLayout.astro'
import NavbarEn from '@/components/NavbarEn.astro'
import FooterEn from '@/components/FooterEn.astro'
import BlogPageHero from '@/components/blog/BlogPageHero.astro'
import BlogFeature from '@/components/blog/BlogFeature.astro'
import BlogCard from '@/components/blog/BlogCard.astro'
import BlogCta from '@/components/blog/BlogCta.astro'
import { getCollection } from 'astro:content'
import { getLangFromSlug, stripLang } from '@/data/hilfe-categories'
import { BLOG_UI, blogBase } from '@/data/blog-i18n'

const lang = 'en' as const
const ui = BLOG_UI[lang]
const base = blogBase(lang)

const now = new Date()
const allPosts = await getCollection('blog')
const posts = allPosts
  .filter(p => getLangFromSlug(p.slug) === lang && p.data.pubDate <= now && p.data.approved !== false)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())

const featured = posts.find(p => p.data.featured) ?? posts[0]
const rest = posts.filter(p => p.slug !== featured.slug)
---

<BaseLayout
  title={ui.metaTitle}
  description={ui.metaDescription}
  lang={lang}
  locale={ui.locale}
  alternates={[
    { hreflang: 'de', href: 'https://bonuskarte.digital/koeln/blog/' },
    { hreflang: 'fr', href: 'https://bonuskarte.digital/fr/blog/' },
    { hreflang: 'en', href: 'https://bonuskarte.digital/en/blog/' },
    { hreflang: 'x-default', href: 'https://bonuskarte.digital/koeln/blog/' },
  ]}
>
  <NavbarEn ctaHref="/en/" />

  <BlogPageHero crumbs={[{ label: ui.breadcrumbHome, href: '/en/' }, { label: ui.breadcrumbBlog }]} kicker={ui.heroEyebrow} lead={ui.heroSubtitle}>
    {ui.heroTitle}
  </BlogPageHero>

  <main class="bg-paper">
    <div class="max-w-6xl mx-auto px-5 sm:px-8 pb-20">
      {featured && <BlogFeature post={featured} lang={lang} href={`${base}/${stripLang(featured.slug)}/`} />}
      {rest.length > 0 && (
        <>
          <div class="flex items-baseline justify-between gap-4 mb-6">
            <h2 class="text-2xl sm:text-3xl font-extrabold text-ink tracking-tight">{ui.allArticles}</h2>
          </div>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {rest.map(post => <BlogCard post={post} lang={lang} href={`${base}/${stripLang(post.slug)}/`} />)}
          </div>
        </>
      )}
    </div>
  </main>

  <BlogCta title={ui.ctaTitle} text={ui.ctaText} button={ui.ctaButton} href="/en/" />

  <FooterEn />
</BaseLayout>
