---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'

const allPosts = await getCollection('blog')
const now = new Date()

const scheduled = allPosts
  .filter(p => p.data.pubDate > now)
  .sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf())

const live = allPosts
  .filter(p => p.data.pubDate <= now)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('de-DE', { day: 'numeric', month: 'long', year: 'numeric' }).format(date)
}

const cityPaths: Record<string, string> = {
  koeln: '/koeln/blog/',
  berlin: '/berlin/blog/',
  bonn: '/bonn/blog/',
  duesseldorf: '/duesseldorf/blog/',
  huerth: '/huerth/blog/',
}

const categoryColors: Record<string, string> = {
  'Ratgeber':  'bg-gold-600/20 text-gold-400 border border-gold-600/30',
  'Strategie': 'bg-blue-900/30 text-blue-300 border border-blue-700/30',
  'How-to':    'bg-emerald-900/30 text-emerald-300 border border-emerald-700/30',
  'News':      'bg-white/10 text-white/60 border border-white/10',
}
---

<BaseLayout title="Preview: Alle Blog-Artikel" description="Interne Vorschau">
  <div class="min-h-screen bg-black text-white">
    <div class="max-w-3xl mx-auto px-5 py-20">
      <div class="text-xs font-bold tracking-[0.3em] uppercase text-gold-600 mb-4">Interne Vorschau</div>
      <h1 class="text-3xl font-black mb-2">Alle Blog-Artikel</h1>
      <p class="text-white/50 text-sm mb-10">{allPosts.length} Artikel total · {scheduled.length} geplant · {live.length} live</p>

      {scheduled.length > 0 && (
        <>
          <div class="flex items-center gap-4 mb-6">
            <h2 class="text-xs font-bold tracking-[0.3em] uppercase text-white/40">Geplant ({scheduled.length})</h2>
            <div class="flex-1 h-px bg-white/5"></div>
          </div>

          <div class="space-y-4 mb-14">
            {scheduled.map((post) => {
              const cityPath = cityPaths[post.data.city] || '/koeln/blog/'
              return (
                <a href={`${cityPath}${post.slug}`} class="block border border-white/10 hover:border-gold-600/40 transition-colors p-6">
                  <div class="flex flex-wrap items-center gap-2 mb-2">
                    <span class="text-xs px-2 py-0.5 rounded-sm bg-white/10 text-white/40 border border-white/10">
                      GEPLANT
                    </span>
                    <span class={`text-xs px-2 py-0.5 rounded-sm ${categoryColors[post.data.category] || ''}`}>
                      {post.data.category}
                    </span>
                    <span class="text-white/40 text-xs">{formatDate(post.data.pubDate)}</span>
                    <span class="text-white/40 text-xs">· {post.data.readingTime} Min.</span>
                    <span class="text-white/30 text-xs">· {post.data.city}</span>
                  </div>
                  <h3 class="text-lg font-bold text-white hover:text-gold-400 transition-colors mb-1">
                    {post.data.title}
                  </h3>
                  <p class="text-white/40 text-sm">{post.data.description}</p>
                </a>
              )
            })}
          </div>
        </>
      )}

      <div class="flex items-center gap-4 mb-6">
        <h2 class="text-xs font-bold tracking-[0.3em] uppercase text-white/40">Live ({live.length})</h2>
        <div class="flex-1 h-px bg-white/5"></div>
      </div>

      <div class="space-y-4">
        {live.map((post) => {
          const cityPath = cityPaths[post.data.city] || '/koeln/blog/'
          return (
            <a href={`${cityPath}${post.slug}`} class="block border border-white/10 hover:border-gold-600/40 transition-colors p-6">
              <div class="flex flex-wrap items-center gap-2 mb-2">
                <span class="text-xs px-2 py-0.5 rounded-sm bg-emerald-900/30 text-emerald-300 border border-emerald-700/30">
                  LIVE
                </span>
                <span class={`text-xs px-2 py-0.5 rounded-sm ${categoryColors[post.data.category] || ''}`}>
                  {post.data.category}
                </span>
                <span class="text-white/40 text-xs">{formatDate(post.data.pubDate)}</span>
                <span class="text-white/40 text-xs">· {post.data.readingTime} Min.</span>
                <span class="text-white/30 text-xs">· {post.data.city}</span>
              </div>
              <h3 class="text-lg font-bold text-white hover:text-gold-400 transition-colors mb-1">
                {post.data.title}
              </h3>
              <p class="text-white/40 text-sm">{post.data.description}</p>
            </a>
          )
        })}
      </div>

      <div class="mt-12 p-6 border border-white/5 bg-ink-900">
        <p class="text-white/40 text-sm">
          Diese Seite ist nicht verlinkt und nicht indexiert. Geplante Artikel sind über die Direktlinks erreichbar, auch wenn sie noch nicht im Blog-Listing erscheinen.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
