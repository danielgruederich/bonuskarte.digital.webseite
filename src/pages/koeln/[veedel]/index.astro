---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import Navbar from '../../../components/Navbar.astro'
import Footer from '../../../components/Footer.astro'
import { veedel, fallbackVeedel, getVeedelBySlug } from '../../../data/veedel'

export function getStaticPaths() {
  return veedel.map(v => ({ params: { veedel: v.slug } }))
}

const { veedel: slug } = Astro.params
const data = getVeedelBySlug(slug) ?? fallbackVeedel

const niches = [
  {
    key: 'cafe',
    label: 'Café',
    emoji: '☕',
    desc: 'Kaffee, Kuchen, Stammgäste',
    href: `/koeln/${data.slug}/cafes`,
    fomo: data.fomoCount.cafe,
  },
  {
    key: 'doener',
    label: 'Döner',
    emoji: '🥙',
    desc: 'Imbiss & Dönerläden',
    href: `/koeln/${data.slug}/doener`,
    fomo: data.fomoCount.doener,
  },
  {
    key: 'restaurant',
    label: 'Restaurant & Bistro',
    emoji: '🍽️',
    desc: 'Restaurants & Bistros',
    href: `/koeln/${data.slug}/restaurant`,
    fomo: data.fomoCount.restaurant,
  },
  {
    key: 'pizza',
    label: 'Pizza',
    emoji: '🍕',
    desc: 'Pizzerien & Lieferdienste',
    href: `/koeln/${data.slug}/pizza`,
    fomo: data.fomoCount.pizza,
  },
  {
    key: 'eiscafe',
    label: 'Eiscafé',
    emoji: '🍦',
    desc: 'Eiscafés & Frozen Yogurt',
    href: `/koeln/${data.slug}/eiscafe`,
    fomo: data.fomoCount.eiscafe,
  },
]
---

<BaseLayout
  title={`Digitale Kundenkarte für ${data.name} – bonuskarte.digital`}
  description={`Digitale Kundenbindung für lokale Läden in ${data.name}. Wähle deine Branche und starte 90 Tage kostenlos.`}
>
  <Navbar ctaHref="#branchen" ctaLabel="Jetzt starten" />

  <section class="relative min-h-screen flex items-center bg-paper overflow-hidden">
    <div class="absolute inset-0 bg-grid-ink"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[500px] bg-amber rounded-full blur-[200px] opacity-5"></div>

    <div class="relative max-w-4xl mx-auto px-5 sm:px-8 pt-28 pb-20 w-full">

      <!-- Eyebrow -->
      <div class="inline-flex items-center gap-3 border border-amber/50 px-4 py-2 mb-10">
        <span class="w-1 h-1 bg-amber animate-pulse-slow"></span>
        <span class="text-amber text-[10px] font-normal tracking-[0.3em] uppercase">
          Köln · {data.name}
        </span>
      </div>

      <!-- Headline -->
      <h1 class="text-5xl sm:text-6xl leading-[1.1] tracking-tight mb-6">
        <span class="font-normal text-ink block mb-2">Digitale Kundenbindung</span>
        <span class="font-bold text-amber block">für {data.name}.</span>
      </h1>

      <p class="text-ink/40 text-base font-normal leading-relaxed mb-14 max-w-lg">
        Wähle deine Branche und sieh, wie andere Läden in {data.name} bereits
        mehr Stammkunden gewinnen.
      </p>

      <!-- Niche selector -->
      <div id="branchen" class="grid grid-cols-2 md:grid-cols-5 gap-4">
        {niches.map(n => (
          <a
            href={n.href}
            class="group relative border border-ink/30 hover:border-amber bg-ink/2 hover:bg-amber/5 p-6 text-center transition-all hover:-translate-y-1"
          >
            <!-- FOMO badge -->
            {n.fomo > 0 && (
              <div class="absolute -top-2.5 left-1/2 -translate-x-1/2 bg-amber text-black text-[9px] font-black tracking-wider uppercase px-2.5 py-1 whitespace-nowrap">
                {n.fomo} bereits dabei
              </div>
            )}

            <div class="text-4xl mb-4 group-hover:scale-110 transition-transform">{n.emoji}</div>
            <div class="text-ink font-bold text-sm tracking-wide mb-1">{n.label}</div>
            <div class="text-ink/55 text-[11px]">{n.desc}</div>

            <div class="mt-4 flex items-center justify-center gap-1 text-amber text-[10px] font-bold tracking-widest uppercase opacity-0 group-hover:opacity-100 transition-opacity">
              Starten
              <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
          </a>
        ))}
      </div>

      <!-- Trust row -->
      <div class="flex flex-wrap gap-6 mt-12">
        {['✅ 90 Tage kostenlos', '🔒 DSGVO', '⚡ In 24h live', '📱 Apple & Google Wallet'].map(t => (
          <span class="text-[10px] tracking-widest uppercase text-ink/50">{t}</span>
        ))}
      </div>

    </div>
  </section>

  <Footer />
</BaseLayout>
