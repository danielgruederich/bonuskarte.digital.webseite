---
import NicheLanding from '../../../components/NicheLanding.astro'
import { veedel as allVeedel } from '../../../data/veedel'
import { niches } from '../../../data/niches'
import { nicheVeedelContent } from '../../../data/niche-veedel-content'

export function getStaticPaths() {
  return allVeedel.flatMap(v =>
    niches.map(n => ({
      params: { veedel: v.slug, niche: n.slug },
      props: { veedelData: v, nicheData: n },
    }))
  )
}

const { veedelData, nicheData } = Astro.props
const fomoCount = veedelData.fomoCount[nicheData.fomoKey]
const contentHtml = nicheVeedelContent[nicheData.slug]?.[veedelData.slug] ?? null
---
<NicheLanding
  cityName="Köln"
  citySlug="koeln"
  locationName={veedelData.name}
  locationSlug={veedelData.slug}
  nicheData={nicheData}
  fomoCount={fomoCount}
  contentHtml={contentHtml}
/>
