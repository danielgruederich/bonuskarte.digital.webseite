---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import Navbar from '../../../components/Navbar.astro'
import Footer from '../../../components/Footer.astro'
import WalletMockup from '../../../components/WalletMockup.astro'
import LeadForm from '../../../components/LeadForm.tsx'
import LeadFormDoener from '../../../components/LeadFormDoener.tsx'
import { veedel as allVeedel, getVeedelBySlug, fallbackVeedel } from '../../../data/veedel'
import { niches, getNicheBySlug } from '../../../data/niches'
import { nicheVeedelContent } from '../../../data/niche-veedel-content'
import { GooeyText } from '../../../components/ui/gooey-text-morphing'
import Icon from '../../../components/icons/TrustIcons.astro'

const emojiToIcon: Record<string, string> = {
  '📱': 'smartphone', '🔔': 'bell', '📊': 'chart', '🔥': 'flame',
  '📣': 'megaphone', '🍕': 'pizza', '🍦': 'ice-cream', '🤝': 'handshake',
  '⚡': 'zap', '🔒': 'shield',
}

export function getStaticPaths() {
  return allVeedel.flatMap(v =>
    niches.map(n => ({
      params: { veedel: v.slug, niche: n.slug },
      props: { veedelData: v, nicheData: n },
    }))
  )
}

const { veedelData, nicheData } = Astro.props
const whatsappUrl = 'https://wa.me/491705594140'

// Resolve all templated strings at build time — no JS injection needed
const r = (s: string) =>
  s.replace('{veedelName}', veedelData.name)
   .replace('{fomoCount}', String(veedelData.fomoCount[nicheData.fomoKey]))

const fomoCount = veedelData.fomoCount[nicheData.fomoKey]
const showFomo  = fomoCount > 0
const isEiscafe = nicheData.slug === 'eiscafe'
const gooeyTexts = ['Eiscafé', 'Digitale Stempelkarte', 'Mehr Stammkunden', 'Mehr Umsatz']
---

<BaseLayout
  title={r(nicheData.seoTitle)}
  description={r(nicheData.seoDescription)}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "bonuskarte.digital", "item": "https://bonuskarte.digital/" },
      { "@type": "ListItem", "position": 2, "name": "Köln", "item": "https://bonuskarte.digital/koeln/" },
      { "@type": "ListItem", "position": 3, "name": veedelData.name, "item": `https://bonuskarte.digital/koeln/${veedelData.slug}/` },
      { "@type": "ListItem", "position": 4, "name": `${nicheData.label} in ${veedelData.name}` }
    ]
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": `Digitale ${nicheData.cardType} für ${nicheData.label} in ${veedelData.name}`,
    "description": r(nicheData.seoDescription),
    "url": `https://bonuskarte.digital/koeln/${veedelData.slug}/${nicheData.slug}`,
    "provider": {
      "@type": "Organization",
      "name": "bonuskarte.digital",
      "url": "https://bonuskarte.digital"
    },
    "areaServed": {
      "@type": "Place",
      "name": `${veedelData.name}, Köln`
    },
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "EUR",
      "description": "90 Tage kostenlos testen – keine Kreditkarte, monatlich kündbar"
    }
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Ist das wirklich 90 Tage kostenlos?", "acceptedAnswer": { "@type": "Answer", "text": "Ja, komplett. Keine Kreditkarte, keine versteckten Kosten. Nach 90 Tagen entscheidest du, ob du weitermachst – ab 29 €/Monat. Monatlich kündbar." } },
      { "@type": "Question", "name": "Brauchen meine Kunden eine App?", "acceptedAnswer": { "@type": "Answer", "text": "Nein. Die Karte landet direkt in Apple Wallet oder Google Wallet – beide sind auf jedem Smartphone vorinstalliert. Kein Download, keine Registrierung." } },
      { "@type": "Question", "name": "Wie viel Aufwand habe ich bei der Einrichtung?", "acceptedAnswer": { "@type": "Answer", "text": "Null. Du füllst ein kurzes Formular aus, wir erstellen deine Karte mit deinem Branding. In unter 24 Stunden bist du live." } },
      { "@type": "Question", "name": "Was kostet es nach der Testphase?", "acceptedAnswer": { "@type": "Answer", "text": "Ab 29 €/Monat für einen Standort. Unbegrenzt Karten, Push-Nachrichten, Statistiken – alles inklusive. Keine Setup-Gebühr, monatlich kündbar." } },
      { "@type": "Question", "name": "Ist das DSGVO-konform?", "acceptedAnswer": { "@type": "Answer", "text": "Ja. Alle Daten werden DSGVO-konform verarbeitet. Keine Tracking-Apps, keine Cookies auf dem Handy deiner Kunden." } }
    ]
  })} />
  <Navbar ctaHref="#demo" ctaLabel={nicheData.heroCopy.ctaLabel} />

  <!-- ── HERO ─────────────────────────────────────────────────── -->
  <section class="relative min-h-screen flex items-center bg-black overflow-hidden">
    <div class="absolute inset-0 bg-grid-white"></div>
    <div class="absolute top-1/2 -right-40 w-[600px] h-[600px] bg-gold-600 rounded-full blur-[200px] opacity-5"></div>

    <div class="relative max-w-6xl mx-auto px-5 sm:px-8 pt-20 pb-12 grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-12 items-center w-full">
      <div>
        <div class="inline-flex items-center gap-3 border border-gold-600/30 px-4 py-2 mb-8">
          <span class="w-1 h-1 bg-gold-600 animate-pulse-slow"></span>
          <span class="text-gold-600 text-xs font-light tracking-[0.3em] uppercase">
            {r(nicheData.heroCopy.eyebrow)}
          </span>
        </div>

        {isEiscafe ? (
          <div class="mb-8">
            <GooeyText
              client:visible
              texts={gooeyTexts}
              morphTime={1.5}
              cooldownTime={1}
              className="h-[60px] sm:h-[80px]"
              textClassName="font-bold text-gold-600 text-3xl sm:text-5xl md:text-[50pt]"
            />
            <p class="text-white font-extralight text-lg tracking-wide mt-4 text-center sm:text-left">
              {r(nicheData.heroCopy.headlineBold)}
            </p>
          </div>
        ) : (
          <h1 class="text-5xl sm:text-6xl leading-[1.1] tracking-tight mb-8">
            <span class="font-extralight text-white block mb-2">{nicheData.heroCopy.headlineLight}</span>
            <span class="font-bold text-gold-600 block">{r(nicheData.heroCopy.headlineBold)}</span>
          </h1>
        )}

        {showFomo && (
          <div class="flex items-center gap-3 border border-gold-600/20 bg-gold-600/5 px-4 py-2.5 mb-6">
            <Icon name="diamond" class="w-4 h-4 text-gold-600 shrink-0" />
            <span class="text-gold-500 text-xs tracking-[0.1em] font-light">{r(nicheData.heroCopy.fomoText)}</span>
          </div>
        )}

        <p class="text-white text-base leading-relaxed mb-6 max-w-md font-light">
          {r(nicheData.heroCopy.bodyText)}
        </p>

        <div class="inline-flex items-center gap-3 border border-gold-600/30 bg-gold-600/5 px-4 py-2.5 mb-6">
          <Icon name="diamond" class="w-4 h-4 text-gold-600 shrink-0" />
          <span class="text-gold-500 text-xs tracking-[0.15em] font-light">
            90 TAGE KOMPLETT KOSTENLOS — KEIN KNEBELVERTRAG
          </span>
        </div>

        <div class="flex flex-col sm:flex-row gap-3">
          <a href="#demo"
            class="group inline-flex items-center justify-center gap-3 bg-gold-600 hover:bg-gold-500 text-black px-8 py-4 text-sm font-bold tracking-[0.2em] uppercase transition-all">
            {nicheData.heroCopy.ctaLabel}
            <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer"
            onclick="if(typeof gtag!=='undefined')gtag('event','whatsapp_clicked',{location:'hero'})"
            class="group inline-flex items-center justify-center gap-3 border border-white/10 hover:border-[#25D366]/50 text-white hover:text-white px-8 py-4 text-xs font-medium tracking-[0.2em] uppercase transition-all">
            <svg class="w-4 h-4 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Per WhatsApp anfragen
          </a>
        </div>
        <a href="https://termin.fuerte.digital"
          target="_blank"
          rel="noopener noreferrer"
          onclick="if(typeof gtag!=='undefined')gtag('event','demo_booking',{source:'hero'})"
          class="inline-flex items-center gap-2 text-white/50 hover:text-white/80 text-xs tracking-[0.15em] uppercase transition-colors py-1">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          Erst informieren? Termin buchen
        </a>

        <div class="flex flex-wrap gap-5 mt-10">
          <span class="inline-flex items-center gap-2 text-xs tracking-wider uppercase text-white font-light">
            <Icon name="shield" class="w-4 h-4 text-gold-600" /> DSGVO
          </span>
          <span class="inline-flex items-center gap-2 text-xs tracking-wider uppercase text-white font-light">
            <Icon name="wallet" class="w-4 h-4 text-gold-600" /> Apple & Google Wallet
          </span>
          <span class="inline-flex items-center gap-2 text-xs tracking-wider uppercase text-white font-light">
            <Icon name="zap" class="w-4 h-4 text-gold-600" /> Live in 24h
          </span>
          <span class="inline-flex items-center gap-2 text-xs tracking-wider uppercase text-white font-light">
            <Icon name="check-circle" class="w-4 h-4 text-gold-600" /> Kein Abo
          </span>
        </div>
      </div>

      <div class="flex flex-col gap-6 items-center md:items-end">
        {nicheData.formType === 'simple' ? (
          <WalletMockup
            businessName={nicheData.walletMockup.businessName}
            reward={nicheData.walletMockup.reward}
            stamped={nicheData.walletMockup.stamped}
            total={nicheData.walletMockup.total}
          />
        ) : (
          <>
            <div class="opacity-60 scale-75 origin-top hidden md:block">
              <WalletMockup
                businessName={nicheData.walletMockup.businessName}
                reward={nicheData.walletMockup.reward}
                stamped={nicheData.walletMockup.stamped}
                total={nicheData.walletMockup.total}
              />
            </div>
            <div id="demo" class="w-full border border-gold-600/20 bg-black/60 backdrop-blur-sm p-6 sm:p-8">
              <LeadForm
                client:load
                niche={nicheData.label}
                city="Köln"
                whatsappUrl={whatsappUrl}
                bookingUrl="https://termin.fuerte.digital"
              />
            </div>
          </>
        )}
      </div>
    </div>

    <div class="absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-t from-black to-transparent"></div>
  </section>

  <!-- ── ARGUMENTS ─────────────────────────────────────────────── -->
  <section class="py-12 sm:py-16 px-5 sm:px-8 bg-black">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-center gap-4 mb-14">
        <div class="h-px flex-1 bg-white/5"></div>
        <span class="text-xs tracking-[0.4em] uppercase text-white">Der Vorteil</span>
        <div class="h-px flex-1 bg-white/5"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {nicheData.arguments.map(a => (
          <div class="group border border-white/5 hover:border-gold-600/30 p-8 transition-all">
            <div class="mb-5 group-hover:scale-110 transition-transform inline-block text-gold-600">
              {emojiToIcon[a.icon] ? (
                <Icon name={emojiToIcon[a.icon]} class="w-8 h-8" />
              ) : (
                <span class="text-4xl">{a.icon}</span>
              )}
            </div>
            <h3 class="font-bold text-white text-lg mb-3">{a.title}</h3>
            <p class="text-white text-base leading-relaxed font-light">{a.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CONTENT BODY ─────────────────────────────────────────── -->
  {(nicheVeedelContent[nicheData.slug]?.[veedelData.slug] || nicheData.contentBody) && (
    <section class="py-12 sm:py-16 px-5 sm:px-8 bg-black border-t border-white/5">
      <div class="max-w-3xl mx-auto">
        <div class="flex items-center gap-4 mb-10">
          <div class="h-px flex-1 bg-white/5"></div>
          <span class="text-xs tracking-[0.4em] uppercase text-white">{nicheData.label} in {veedelData.name}</span>
          <div class="h-px flex-1 bg-white/5"></div>
        </div>
        <div class="[&_p]:text-white [&_p]:font-light [&_p]:leading-relaxed [&_p]:mb-5 [&_p:last-child]:mb-0 [&_strong]:text-gold-600 [&_strong]:font-semibold"
          set:html={nicheVeedelContent[nicheData.slug]?.[veedelData.slug] ?? r(nicheData.contentBody)} />
      </div>
    </section>
  )}

  <!-- ── OFFER ─────────────────────────────────────────────────── -->
  <section class="py-12 sm:py-16 px-5 sm:px-8 bg-ink-950 relative overflow-hidden">
    <div class="absolute inset-0 bg-grid-white opacity-50"></div>
    <div class="relative max-w-3xl mx-auto text-center">
      <div class="flex items-center gap-4 mb-10">
        <div class="h-px flex-1 bg-white/5"></div>
        <span class="text-xs tracking-[0.4em] uppercase text-white">Das Angebot</span>
        <div class="h-px flex-1 bg-white/5"></div>
      </div>
      <h2 class="text-4xl sm:text-5xl font-extralight text-white tracking-tight mb-2">90 Tage Test.</h2>
      <h2 class="text-4xl sm:text-5xl font-bold text-gold-600 tracking-tight mb-10">0€ Risiko.</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {[
          { n: '0€', label: 'Setup-Gebühr',  sub: 'Komplett kostenlos starten' },
          { n: '90', label: 'Tage gratis',   sub: 'Kein Risiko, kein Druck'    },
          { n: '∞',  label: 'Stammkunden',   sub: 'Die immer wiederkommen'     },
        ].map(stat => (
          <div class="border border-gold-600/20 p-6 text-center">
            <div class="text-4xl font-black text-gold-600 mb-1">{stat.n}</div>
            <div class="text-white font-semibold text-sm mb-1">{stat.label}</div>
            <div class="text-white text-sm">{stat.sub}</div>
          </div>
        ))}
      </div>
      <div class="mt-10">
        <a href="#demo"
          class="group inline-flex items-center gap-3 bg-gold-600 hover:bg-gold-500 text-black px-10 py-5 text-sm font-bold tracking-[0.25em] uppercase transition-all">
          Jetzt 90 Tage gratis starten
          <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ── FAQ ───────────────────────────────────────────────────── -->
  <section class="py-12 sm:py-16 px-5 sm:px-8 bg-ink-950 relative overflow-hidden">
    <div class="absolute inset-0 bg-grid-white opacity-50"></div>
    <div class="relative max-w-3xl mx-auto">
      <div class="flex items-center gap-4 mb-10">
        <div class="h-px flex-1 bg-white/5"></div>
        <span class="text-xs tracking-[0.4em] uppercase text-white">Häufige Fragen</span>
        <div class="h-px flex-1 bg-white/5"></div>
      </div>

      <div class="space-y-4">
        {[
          {
            q: 'Ist das wirklich 90 Tage kostenlos?',
            a: 'Ja, komplett. Keine Kreditkarte, keine versteckten Kosten. Nach 90 Tagen entscheidest du, ob du weitermachst – ab 29 €/Monat. Monatlich kündbar.',
          },
          {
            q: 'Brauchen meine Kunden eine App?',
            a: 'Nein. Die Karte landet direkt in Apple Wallet oder Google Wallet – beide sind auf jedem Smartphone vorinstalliert. Kein Download, keine Registrierung.',
          },
          {
            q: 'Wie viel Aufwand habe ich bei der Einrichtung?',
            a: 'Null. Du füllst ein kurzes Formular aus, wir erstellen deine Karte mit deinem Branding. In unter 24 Stunden bist du live.',
          },
          {
            q: 'Was kostet es nach der Testphase?',
            a: 'Ab 29 €/Monat für einen Standort. Unbegrenzt Karten, Push-Nachrichten, Statistiken – alles inklusive. Keine Setup-Gebühr, monatlich kündbar.',
          },
          {
            q: 'Ist das DSGVO-konform?',
            a: 'Ja. Alle Daten werden DSGVO-konform verarbeitet. Keine Tracking-Apps, keine Cookies auf dem Handy deiner Kunden.',
          },
        ].map(faq => (
          <details class="group border border-white/5 hover:border-gold-600/20 transition-colors">
            <summary class="flex items-center justify-between cursor-pointer p-5 sm:p-6">
              <span class="text-white text-sm sm:text-base font-medium pr-4">{faq.q}</span>
              <svg class="w-4 h-4 text-gold-600 flex-shrink-0 group-open:rotate-45 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
              </svg>
            </summary>
            <div class="px-5 sm:px-6 pb-5 sm:pb-6">
              <p class="text-white text-sm leading-relaxed font-light">{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ── LEAD FORM ─────────────────────────────────────────────── -->
  {nicheData.formType === 'simple' ? (
    <section id="demo" class="py-12 sm:py-16 px-5 sm:px-8 bg-black relative overflow-hidden">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] bg-gold-600 rounded-full blur-[180px] opacity-5"></div>
      <div class="relative max-w-xl mx-auto">
        <div class="text-center mb-10">
          <div class="inline-flex items-center gap-3 border border-gold-600/30 bg-gold-600/5 px-4 py-2 mb-8">
            <Icon name="diamond" class="w-4 h-4 text-gold-600 shrink-0" />
            <span class="text-gold-500 text-xs tracking-[0.3em] uppercase">
              Exklusiv für {nicheData.emoji} in {veedelData.name}
            </span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-extralight text-white tracking-tight mb-2">Demo-Karte</h2>
          <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight mb-6">direkt ins Wallet.</h2>
          <p class="text-white text-base font-light leading-relaxed max-w-sm mx-auto">
            Trag dich ein – deine persönliche Demo-Karte liegt in Sekunden in deinem Wallet.
          </p>
        </div>
        <div class="relative border border-gold-600/20 bg-ink-950 p-8 sm:p-10">
          <LeadFormDoener client:load whatsappUrl={whatsappUrl} niche={nicheData.slug} />
        </div>
        <p class="text-center text-white text-sm mt-5">
          Nach 90 Tagen ab 29 €/Monat ·
          <a href="/preise" class="text-gold-600 hover:text-gold-600 underline underline-offset-2 transition-colors">Alle Preise ansehen</a>
        </p>
      </div>
    </section>
  ) : (
    <section class="py-10 sm:py-12 px-5 sm:px-8 bg-black border-t border-white/5 md:hidden">
      <div class="max-w-xl mx-auto text-center">
        <p class="text-white/50 text-sm mb-4">Noch nicht überzeugt?</p>
        <a href="#demo"
          class="group inline-flex items-center gap-3 border border-gold-600/40 hover:border-gold-600 text-gold-600 px-8 py-4 text-sm font-medium tracking-[0.15em] uppercase transition-all">
          {nicheData.heroCopy.ctaLabel}
          <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </section>
  )}

  <!-- ── FINAL CTA ─────────────────────────────────────────────── -->
  <section class="py-12 sm:py-16 px-5 sm:px-8 bg-black border-t border-white/5 relative overflow-hidden">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[300px] bg-gold-600 rounded-full blur-[150px] opacity-5"></div>
    <div class="relative max-w-2xl mx-auto text-center">
      <p class="text-gold-600 text-xs tracking-[0.4em] uppercase mb-6">Kein Risiko</p>
