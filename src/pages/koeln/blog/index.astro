---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import Navbar from '../../../components/Navbar.astro'
import Footer from '../../../components/Footer.astro'
import BlogPageHero from '../../../components/blog/BlogPageHero.astro'
import BlogFeature from '../../../components/blog/BlogFeature.astro'
import BlogCta from '../../../components/blog/BlogCta.astro'
import BlogCard from '../../../components/blog/BlogCard.astro'
import { getCollection } from 'astro:content'

const now = new Date()
const allPosts = await getCollection('blog')
const posts = allPosts
  .filter(p => p.data.city === 'koeln' && p.data.pubDate <= now && p.data.approved !== false)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())

const featured = posts.find(p => p.data.featured) ?? posts[0]
const rest = posts.filter(p => p.slug !== featured.slug)
const themen = rest.filter(p => p.data.category !== 'Lokales')
const veedel = rest.filter(p => p.data.category === 'Lokales')
const filterCategories = (['Ratgeber', 'Strategie', 'How-to', 'News'] as const)
  .map(c => ({ name: c, count: themen.filter(p => p.data.category === c).length }))
  .filter(c => c.count > 0)
---

<BaseLayout
  title="Blog Köln – bonuskarte.digital | Kundenbindung für Kölner Betriebe"
  description="Tipps, Anleitungen und Strategien zur digitalen Kundenbindung speziell für Cafés, Restaurants und Dönerläden in Köln – Ehrenfeld, Nippes, Innenstadt und mehr."
  alternates={[
    { hreflang: 'de', href: 'https://bonuskarte.digital/koeln/blog/' },
    { hreflang: 'en', href: 'https://bonuskarte.digital/en/blog/' },
    { hreflang: 'fr', href: 'https://bonuskarte.digital/fr/blog/' },
    { hreflang: 'x-default', href: 'https://bonuskarte.digital/koeln/blog/' },
  ]}
>
  <Navbar ctaHref="/#demo" />

  <BlogPageHero
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Köln', href: '/koeln/' }, { label: 'Blog' }]}
    kicker="Blog Köln"
    lead="Praxiswissen zu digitalen Bonus- und Stempelkarten – für Cafés, Eisdielen, Bäckereien, Studios und Restaurants in allen Veedeln."
  >
    Mehr Stammkunden für <span class="text-amber-text">Kölner</span> Läden.
    <dl slot="after" class="flex flex-wrap gap-7 mt-8 text-sm text-ink-500">
      <div><dt class="sr-only">Artikel</dt><dd><b class="block text-2xl font-extrabold text-ink tracking-tight">{posts.length}</b>Artikel</dd></div>
      <div><dt class="sr-only">Veedel</dt><dd><b class="block text-2xl font-extrabold text-ink tracking-tight">{veedel.length}</b>Veedel-Porträts</dd></div>
      <div><dt class="sr-only">Themen</dt><dd><b class="block text-2xl font-extrabold text-ink tracking-tight">{filterCategories.length}</b>Themen</dd></div>
    </dl>
  </BlogPageHero>

  <main class="bg-paper">
    <div class="max-w-6xl mx-auto px-5 sm:px-8">
      <!-- Filter -->
      <div class="flex flex-wrap gap-2 pt-2 pb-8 mb-10 border-b border-ink-200" role="group" aria-label="Nach Thema filtern" id="blog-filter">
        <button type="button" data-filter="" aria-pressed="true" class="blog-chip">Alle<span>{themen.length}</span></button>
        {filterCategories.map(c => (
          <button type="button" data-filter={c.name} aria-pressed="false" class="blog-chip">{c.name}<span>{c.count}</span></button>
        ))}
        {veedel.length > 0 && <a href="#veedel" class="blog-chip">Veedel<span>{veedel.length}</span></a>}
      </div>

      <!-- Hauptartikel -->
      <BlogFeature post={featured} href={`/koeln/blog/${featured.slug}/`} />

      <!-- Alle Themen-Artikel -->
      <div class="flex items-baseline justify-between gap-4 mb-6">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-ink tracking-tight" id="blog-grid-title">Alle Artikel</h2>
        <p class="text-ink-500 text-[15px]" id="blog-grid-count">{themen.length} Artikel</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 pb-20" id="blog-grid">
        {themen.map(post => <BlogCard post={post} href={`/koeln/blog/${post.slug}/`} />)}
      </div>
    </div>
  </main>

  <!-- Veedel -->
  {veedel.length > 0 && (
    <section class="bg-paper-dark py-16 sm:py-20" id="veedel">
      <div class="max-w-6xl mx-auto px-5 sm:px-8">
        <div class="text-amber-text text-xs font-bold tracking-[0.25em] uppercase mb-2">Aus den Veedeln</div>
        <div class="flex items-baseline justify-between gap-4 mb-6">
          <h2 class="text-2xl sm:text-3xl font-extrabold text-ink tracking-tight">Kundenbindung, Veedel für Veedel</h2>
          <p class="text-ink-500 text-[15px]">{veedel.length} Veedel-Artikel</p>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
          {veedel.map(post => <BlogCard post={post} href={`/koeln/blog/${post.slug}/`} compact />)}
        </div>
      </div>
    </section>
  )}

  <BlogCta
    title="Ihre eigene digitale Kundenkarte – in Ihrem Veedel."
    text="90 Tage kostenlos. Direkt in Apple Wallet und Google Wallet. Kein Download, kein Plastik."
    button="Jetzt gratis starten"
    href="/#demo"
    note="Keine Kreditkarte nötig."
  />

  <Footer />
</BaseLayout>

<style>
  .blog-chip {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    font-weight: 600;
    font-size: 14px;
    color: #1A1410;
    background: #fff;
    border: 1.5px solid #cbc7c0;
    padding: 9px 16px;
    border-radius: 999px;
    cursor: pointer;
    transition: border-color 0.2s, background-color 0.2s, color 0.2s;
  }
  .blog-chip span { font-weight: 500; font-size: 12px; }
  .blog-chip:hover { border-color: #1A1410; }
  .blog-chip[aria-pressed='true'] { background: #1A1410; border-color: #1A1410; color: #F6F1E8; }
  .blog-chip:focus-visible { outline: 3px solid #B23F12; outline-offset: 3px; }
</style>

<script>
  const filter = document.getElementById('blog-filter')
  const cards = document.querySelectorAll<HTMLElement>('#blog-grid > a')
  const title = document.getElementById('blog-grid-title')
  const count = document.getElementById('blog-grid-count')
  filter?.addEventListener('click', e => {
    const btn = (e.target as HTMLElement).closest('button')
    if (!btn) return
    const cat = btn.dataset.filter ?? ''
    filter.querySelectorAll('button').forEach(b => b.setAttribute('aria-pressed', String(b === btn)))
    let visible = 0
    cards.forEach(c => {
      const show = !cat || c.dataset.category === cat
      c.classList.toggle('hidden', !show)
      if (show) visible++
    })
    if (title) title.textContent = cat || 'Alle Artikel'
    if (count) count.textContent = `${visible} Artikel`
  })
</script>
