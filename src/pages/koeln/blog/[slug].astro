---
import { getCollection } from 'astro:content'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import Navbar from '../../../components/Navbar.astro'
import Footer from '../../../components/Footer.astro'

export async function getStaticPaths() {
  const posts = await getCollection('blog')
  return posts
    .filter(p => p.data.city === 'koeln')
    .map(post => ({
      params: { slug: post.slug },
      props: { post },
    }))
}

const { post } = Astro.props
const { Content } = await post.render()

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('de-DE', {
    day: 'numeric', month: 'long', year: 'numeric'
  }).format(date)
}

const categoryColors: Record<string, string> = {
  'Ratgeber':  'bg-amber/20 text-amber border border-amber/50',
  'Strategie': 'bg-blue-900/30 text-blue-300 border border-blue-700/30',
  'How-to':    'bg-emerald-900/30 text-emerald-300 border border-emerald-700/30',
  'News':      'bg-ink/10 text-ink/60 border border-ink/10',
}

const allPosts = await getCollection('blog')
const related = allPosts
  .filter(p => p.data.city === 'koeln' && p.slug !== post.slug)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3)
---

<BaseLayout
  title={`${post.data.title} – bonuskarte.digital Köln`}
  description={post.data.description}
  ogImage={post.data.heroImage}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": post.data.title,
    "description": post.data.description,
    "image": post.data.heroImage,
    "datePublished": post.data.pubDate.toISOString(),
    "dateModified": (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    "author": {
      "@type": "Organization",
      "name": "bonuskarte.digital",
      "url": "https://bonuskarte.digital"
    },
    "publisher": {
      "@type": "Organization",
      "name": "bonuskarte.digital",
      "logo": {
        "@type": "ImageObject",
        "url": "https://bonuskarte.digital/favicon.svg"
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": `https://bonuskarte.digital/koeln/blog/${post.slug}`
    }
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://bonuskarte.digital"},
    {"@type": "ListItem", "position": 2, "name": "Köln", "item": "https://bonuskarte.digital/koeln"},
    {"@type": "ListItem", "position": 3, "name": "Blog", "item": "https://bonuskarte.digital/koeln/blog"},
    {"@type": "ListItem", "position": 4, "name": post.data.title, "item": `https://bonuskarte.digital/koeln/blog/${post.slug}`}
  ]
})} />
  <Navbar ctaHref="/#demo" />

  <!-- Reading progress bar -->
  <div class="fixed top-0 left-0 right-0 z-[100] h-0.5 bg-transparent">
    <div id="progress-bar" class="h-full bg-amber transition-none" style="width:0%"></div>
  </div>

  <!-- ── Article Header ───────────────────────── -->
  <header class="bg-ink pt-24 pb-10 sm:pb-14">
    <div class="max-w-2xl mx-auto px-5 sm:px-8">

      <!-- Breadcrumb -->
      <nav class="flex items-center flex-wrap gap-1.5 text-xs text-paper/55 mb-7 tracking-wide">
        <a href="/" class="hover:text-paper/60 transition-colors">Home</a>
        <span>›</span>
        <a href="/koeln" class="hover:text-paper/60 transition-colors">Köln</a>
        <span>›</span>
        <a href="/koeln/blog" class="hover:text-paper/60 transition-colors">Blog</a>
        <span>›</span>
        <span class="text-paper/50">{post.data.category}</span>
      </nav>

      <!-- Category + meta -->
      <div class="flex flex-wrap items-center gap-2.5 mb-5">
        <span class={`text-xs font-semibold tracking-wide uppercase px-2.5 py-1 ${categoryColors[post.data.category]}`}>
          {post.data.category}
        </span>
        <span class="text-paper/50 text-xs">{post.data.readingTime} Min. Lesezeit</span>
        <span class="text-paper/50">·</span>
        <span class="text-paper/55 text-xs">📍 Köln</span>
      </div>

      <!-- Title -->
      <h1 class="text-3xl sm:text-4xl font-black text-paper leading-tight tracking-tight mb-5">
        {post.data.title}
      </h1>

      <!-- Description -->
      <p class="text-paper/55 text-base sm:text-lg leading-relaxed mb-7">
        {post.data.description}
      </p>

      <!-- Author + date -->
      <div class="flex items-center gap-3 pt-5 border-t border-paper/8">
        <div class="w-9 h-9 bg-amber flex items-center justify-center flex-shrink-0">
          <span class="text-black font-black text-sm">F</span>
        </div>
        <div>
          <div class="text-paper text-sm font-semibold leading-none mb-1">FUERTE.DIGITAL</div>
          <div class="text-paper/60 text-xs">{formatDate(post.data.pubDate)}</div>
        </div>
      </div>

    </div>
  </header>

  <!-- ── Hero Image ───────────────────────────── -->
  <div class="bg-ink border-t border-ink/30">
    <div class="max-w-2xl mx-auto px-5 sm:px-8 py-8 sm:py-10">
      <div class="flex items-center justify-center bg-ink-900 min-h-[200px] sm:min-h-[320px] p-6 sm:p-10">
        <img
          src={post.data.heroImage}
          alt={post.data.title}
          class="max-h-[200px] sm:max-h-[300px] w-auto max-w-full object-contain drop-shadow-2xl"
          loading="eager"
        />
      </div>
    </div>
  </div>

  <!-- ── Article Body ─────────────────────────── -->
  <main class="bg-white">
    <div class="max-w-2xl mx-auto px-5 sm:px-8 py-12 sm:py-16">
      <article id="article-body" class="article-body">
        <Content />
      </article>
    </div>
  </main>

  <!-- ── CTA Banner ───────────────────────────── -->
  <section class="bg-ink py-14 sm:py-20 border-t border-ink/30">
    <div class="max-w-2xl mx-auto px-5 sm:px-8">
      <div class="flex flex-col sm:flex-row sm:items-center gap-6 sm:gap-10">
        <div class="flex-1">
          <div class="text-amber text-xs font-bold tracking-[0.25em] uppercase mb-2">Für Kölner Betriebe</div>
          <h2 class="text-2xl sm:text-3xl font-black text-paper leading-tight">
            Jetzt 90 Tage kostenlos starten
          </h2>
          <p class="text-paper/45 text-sm mt-2 leading-relaxed">
            Keine Kreditkarte. Keine App. Läuft auf jedem Smartphone in Ihrem Veedel.
          </p>
        </div>
        <a
          href="/#demo"
          class="flex-shrink-0 inline-flex items-center justify-center gap-2 bg-amber hover:bg-amber-dark text-black font-bold text-xs tracking-widest uppercase px-7 py-4 transition-colors group"
        >
          Gratis starten
          <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ── Related Posts ────────────────────────── -->
  {related.length > 0 && (
    <section class="bg-white py-14 sm:py-16 border-t border-gray-100">
      <div class="max-w-2xl mx-auto px-5 sm:px-8">
        <div class="flex items-center justify-between mb-8">
          <h2 class="text-xs font-bold tracking-[0.25em] uppercase text-black/40">Weitere Artikel</h2>
          <a href="/koeln/blog" class="text-xs text-amber hover:text-amber tracking-widest uppercase transition-colors font-medium">
            Alle →
          </a>
        </div>
        <div class="grid sm:grid-cols-3 gap-px bg-gray-100">
          {related.map(p => (
            <a href={`/koeln/blog/${p.slug}`} class="group bg-white hover:bg-gray-50 transition-colors p-5 flex flex-col gap-3">
              <div class="bg-gray-50 flex items-center justify-center aspect-video overflow-hidden">
                <img
                  src={p.data.heroImage}
                  alt={p.data.title}
                  class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              </div>
              <span class="text-amber text-xs font-semibold tracking-wide uppercase">{p.data.category}</span>
              <h3 class="text-sm font-bold text-black leading-snug group-hover:text-amber transition-colors">
                {p.data.title}
              </h3>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <Footer />
</BaseLayout>

<!-- Reading progress bar script -->
<script>
  const bar = document.getElementById('progress-bar')
  const article = document.getElementById('article-body')

  if (bar && article) {
    window.addEventListener('scroll', () => {
      const articleTop = article.getBoundingClientRect().top + window.scrollY
      const articleH   = article.offsetHeight
      const winH       = window.innerHeight
      const scrolled   = window.scrollY - articleTop
      const total      = articleH - winH
      const pct        = total > 0 ? Math.min(100, Math.max(0, (scrolled / total) * 100)) : 0
      bar.style.width  = pct + '%'
    }, { passive: true })
  }
</script>

<style is:global>
/* ── Base ── */
.article-body {
  font-size: 1.0625rem;
  line-height: 1.85;
  color: #374151;
}

/* ── Headings ── */
.article-body h2 {
  font-size: 1.4375rem;
  font-weight: 800;
  color: #000;
  margin-top: 3.25rem;
  margin-bottom: 1rem;
  line-height: 1.25;
  letter-spacing: -0.02em;
  padding-left: 1rem;
  border-left: 3px solid #A38A00;
}

.article-body h3 {
  font-size: 1.125rem;
  font-weight: 700;
  color: #111;
  margin-top: 2.25rem;
  margin-bottom: 0.75rem;
  line-height: 1.4;
}

/* ── Paragraph ── */
.article-body p {
  margin-bottom: 1.375rem;
}

/* ── First paragraph after h2 ── */
.article-body h2 + p {
  margin-top: 0.25rem;
}

/* ── Bold ── */
.article-body strong {
  font-weight: 700;
  color: #111;
}

/* ── Links ── */
.article-body a {
  color: #A38A00;
  text-decoration: none;
  border-bottom: 1px solid rgba(139,115,0,0.35);
  transition: border-color 0.15s;
}
.article-body a:hover {
  border-bottom-color: #A38A00;
}

/* ── Lists ── */
.article-body ul {
  list-style: none;
  padding: 0;
  margin: 0 0 1.5rem;
}
.article-body ul li {
  position: relative;
  padding-left: 1.625rem;
  margin-bottom: 0.625rem;
  line-height: 1.75;
}
.article-body ul li::before {
  content: '→';
  color: #A38A00;
  font-weight: 700;
  position: absolute;
  left: 0;
  top: 0.05em;
}
.article-body ol {
  list-style: none;
  padding: 0;
  margin: 0 0 1.5rem;
  counter-reset: ol-counter;
}
.article-body ol li {
  position: relative;
  padding-left: 2.25rem;
  margin-bottom: 0.75rem;
  line-height: 1.75;
  counter-increment: ol-counter;
}
.article-body ol li::before {
  content: counter(ol-counter);
  position: absolute;
  left: 0;
  top: 0.1em;
  width: 1.5rem;
  height: 1.5rem;
  background: #000;
  color: #fff;
  font-size: 0.6875rem;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* ── Blockquote — editorial dark card ── */
.article-body blockquote {
  background: #0d0d0d;
  border: none;
  border-left: 3px solid #A38A00;
  padding: 1.375rem 1.5rem;
  margin: 2rem 0;
  font-style: normal;
}
.article-body blockquote p {
  color: rgba(255,255,255,0.8);
  margin-bottom: 0;
  font-size: 1rem;
  line-height: 1.75;
}
.article-body blockquote strong {
  color: #c9a84c;
  font-weight: 700;
}

/* ── Tables — mobile scrollable ── */
.article-body table {
  display: block;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  width: 100%;
  max-width: 100%;
  border-collapse: collapse;
  margin: 2rem 0;
  font-size: 0.875rem;
}
.article-body thead th {
  background: #000;
  color: #fff;
  text-align: left;
  padding: 0.75rem 1rem;
  font-weight: 600;
  font-size: 0.75rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  white-space: nowrap;
}
.article-body thead th:first-child {
  border-left: 3px solid #A38A00;
}
.article-body tbody tr {
  border-bottom: 1px solid #f0f0f0;
  transition: background 0.1s;
}
.article-body tbody tr:hover {
  background: #fafafa;
}
.article-body tbody td {
  padding: 0.75rem 1rem;
  vertical-align: top;
  color: #374151;
  white-space: nowrap;
}
.article-body tbody td:first-child {
  font-weight: 600;
  color: #111;
  white-space: normal;
}

/* ── HR ── */
.article-body hr {
  border: none;
  border-top: 1px solid #f0f0f0;
  margin: 3rem 0;
}

/* ── Code ── */
.article-body code {
  background: #f4f4f5;
  padding: 0.15em 0.45em;
  border-radius: 3px;
  font-size: 0.875em;
  font-family: 'Fira Code', 'Consolas', monospace;
  color: #111;
}
</style>
