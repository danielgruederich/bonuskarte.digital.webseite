---
import BaseLayout from '../layouts/BaseLayout.astro'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'
import { pabbly } from '../config/integrations'
---

<BaseLayout
  title="Buchung bestätigt | bonuskarte.digital"
  description="Dein Termin ist gebucht. Wir freuen uns auf das Gespräch!"
  noindex={true}
  showStickyCta={false}
>
  <Navbar ctaHref="/koeln/" ctaLabel="Zur Startseite" />

  <!-- Hero -->
  <section class="relative bg-paper overflow-hidden pt-28 pb-12 px-5 sm:px-8">
    <div class="absolute inset-0 bg-grid-ink"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[400px] bg-amber rounded-full blur-[200px] opacity-5 pointer-events-none"></div>

    <div class="relative max-w-3xl mx-auto text-center">
      <div class="inline-flex items-center gap-3 border border-amber/50 px-4 py-2 mb-8">
        <span class="w-1 h-1 bg-amber animate-pulse-slow"></span>
        <span class="text-amber text-xs font-normal tracking-[0.3em] uppercase">
          Buchung bestätigt
        </span>
      </div>
      <h1 class="text-4xl sm:text-5xl leading-[1.1] tracking-tight mb-6">
        <span class="font-normal text-ink block mb-2">Wir sehen uns,</span>
        <span id="invitee-name" class="font-bold text-amber block">bald!</span>
      </h1>
      <p id="hero-subtext" class="text-ink/60 text-base font-normal leading-relaxed max-w-lg mx-auto">
        Dein Termin ist reserviert. Wir freuen uns drauf.
      </p>
    </div>
  </section>

  <!-- Details + Next Steps + CTA -->
  <section class="bg-ink pb-16 px-5 sm:px-8">
    <div class="max-w-3xl mx-auto space-y-6 pt-8">

      <!-- Buchungsdetails -->
      <div class="border border-amber/20 bg-paper p-6 sm:p-8 space-y-4">
        <div id="row-date" class="hidden items-start gap-4">
          <svg aria-hidden="true" class="w-5 h-5 text-amber mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span id="meeting-date" class="text-ink text-sm font-normal leading-relaxed"></span>
        </div>
        <div id="row-email" class="hidden items-start gap-4">
          <svg aria-hidden="true" class="w-5 h-5 text-amber mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span id="invitee-email-text" class="text-ink text-sm font-normal"></span>
        </div>
        <div id="row-type" class="hidden items-start gap-4">
          <svg aria-hidden="true" class="w-5 h-5 text-amber mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
          <span id="meeting-type-text" class="text-ink text-sm font-normal"></span>
        </div>
      </div>

      <!-- Daniel — menschliches Element -->
      <div class="border border-amber/20 bg-paper p-6 sm:p-8 flex items-start gap-5">
        <img
          src="/images/daniel-gruederich.png"
          alt="Daniel Grüderich"
          class="w-14 h-14 rounded-full object-cover shrink-0"
        />
        <div>
          <p class="text-ink text-sm font-normal leading-relaxed mb-2">
            "Ich freue mich auf unser Gespräch. Ich zeige dir live, wie deine Karte aussehen könnte — in 15 Minuten weißt du ob es passt."
          </p>
          <p class="text-ink/50 text-xs font-normal tracking-wide">Daniel Grüderich · bonuskarte.digital</p>
        </div>
      </div>

      <!-- Nächste Schritte -->
      <div class="border border-amber/20 bg-paper p-6 sm:p-8">
        <h2 class="text-ink text-xs font-bold tracking-[0.25em] uppercase mb-6">Was passiert als nächstes?</h2>
        <ol class="space-y-5">
          <li class="flex items-start gap-4">
            <span class="text-amber text-xs font-bold tracking-widest mt-0.5 shrink-0">01</span>
            <p class="text-ink/70 text-sm font-normal leading-relaxed">
              Du bekommst eine Bestätigungsmail mit allen Details.
            </p>
          </li>
          <li class="flex items-start gap-4">
            <span class="text-amber text-xs font-bold tracking-widest mt-0.5 shrink-0">02</span>
            <p class="text-ink/70 text-sm font-normal leading-relaxed">
              Bereite gerne ein paar Infos vor: dein Name, Branche, und ungefähr wie viele Kunden du hast.
            </p>
          </li>
          <li class="flex items-start gap-4">
            <span class="text-amber text-xs font-bold tracking-widest mt-0.5 shrink-0">03</span>
            <p class="text-ink/70 text-sm font-normal leading-relaxed">
              Bei Fragen erreichst du uns jederzeit per
              <a href="https://wa.me/491705594140" class="text-amber hover:underline">WhatsApp</a>
              oder <a href="mailto:hallo@bonuskarte.digital" class="text-amber hover:underline">E-Mail</a>.
            </p>
          </li>
        </ol>
      </div>

      <!-- 3 eBook-Karten -->
      <div class="border border-amber/20 bg-paper p-6 sm:p-8">
        <div class="flex items-center gap-3 mb-6">
          <span class="w-1 h-1 bg-amber"></span>
          <p class="text-ink text-xs font-bold tracking-[0.25em] uppercase">Dein Bonus — 3 kostenlose Leitfäden</p>
        </div>
        <div class="grid grid-cols-3 gap-4">
          <a href="/downloads/leitfaden-stammkunden-cafes-koeln.pdf" target="_blank" rel="noopener noreferrer" class="group flex flex-col">
            <div class="overflow-hidden mb-3 border border-ink/8">
              <img
                src="/images/ebook-cover-stammkunden.png"
                alt="Stammkunden-Leitfaden"
                class="w-full object-cover group-hover:scale-105 transition-transform duration-300"
              />
            </div>
            <p class="text-ink text-xs font-normal leading-snug group-hover:text-amber transition-colors">Stammkunden-Leitfaden Cafés</p>
          </a>
          <a href="/downloads/leitfaden-cafe-abo.pdf" target="_blank" rel="noopener noreferrer" class="group flex flex-col">
            <div class="overflow-hidden mb-3 border border-ink/8">
              <img
                src="/images/ebook-cover-cafe-abo.png"
                alt="Das Café-Abo"
                class="w-full object-cover group-hover:scale-105 transition-transform duration-300"
              />
            </div>
            <p class="text-ink text-xs font-normal leading-snug group-hover:text-amber transition-colors">Das Café-Abo</p>
          </a>
          <a href="/downloads/leitfaden-yoga-studios.pdf" target="_blank" rel="noopener noreferrer" class="group flex flex-col">
            <div class="overflow-hidden mb-3 border border-ink/8">
              <img
                src="/images/ebook-cover-yoga.png"
                alt="Yoga-Studio Leitfaden"
                class="w-full object-cover group-hover:scale-105 transition-transform duration-300"
              />
            </div>
            <p class="text-ink text-xs font-normal leading-snug group-hover:text-amber transition-colors">Yoga-Studio Leitfaden</p>
          </a>
        </div>
      </div>

      <!-- Testimonial — Tim, Erste Liebe -->
      <div class="border border-amber/20 bg-paper p-6 sm:p-8">
        <p class="text-ink text-sm font-normal leading-relaxed mb-5">
          "Daniel kam schon bei der Eröffnung von Erste Liebe auf uns zu. GoLive war 24 Stunden später. Keine Ausfälle, Kunden lieben es. Wir haben schon 200 Karten im Umlauf – und nutzen bisher nur 10 % der Plattform."
        </p>
        <div class="flex items-center gap-3">
          <img src="/images/testimonials/erste-liebe.jpg" alt="Café Erste Liebe" class="w-8 h-8 object-cover rounded-full" />
          <p class="text-ink/50 text-xs font-normal tracking-wide">Tim · Inhaber, Café Erste Liebe</p>
        </div>
      </div>

      <!-- Weiterempfehlung -->
      <a
        href={`https://wa.me/?text=${encodeURIComponent('Ich hab gerade eine digitale Kundenkarte für mein Café gebucht – schau dir das mal an: https://bonuskarte.digital/koeln')}`}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-3 w-full border border-amber/20 bg-paper hover:border-amber/50 text-ink px-10 py-5 text-xs font-bold tracking-[0.2em] uppercase transition-colors"
      >
        <svg aria-hidden="true" class="w-4 h-4 text-amber" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Einem Café weiterempfehlen
      </a>

      <!-- CTA -->
      <a
        href="/koeln/"
        class="flex items-center justify-center w-full bg-amber hover:bg-amber-dark text-black px-10 py-5 text-xs font-bold tracking-[0.25em] uppercase transition-all"
      >
        Zur Startseite
      </a>

    </div>
  </section>

  <Footer />

  <!-- Pass server-side config to client -->
  <script define:vars={{ webhookUrl: pabbly.webhookUrl }}>
    window.__dankeWebhookUrl = webhookUrl
  </script>

  <script>
    import { formatDate } from '../lib/booking'

    const KEY    = 'booking_tracked'
    const params = new URLSearchParams(window.location.search)

    const fullName = params.get('invitee_full_name')    || ''
    const email    = params.get('invitee_email')         || ''
    const startsAt = params.get('meeting_starts_at')     || ''
    const type     = params.get('meeting_type')          || ''
    const phone    = params.get('invitee_phone_number')  || ''

    const startsAtFormatted = formatDate(startsAt)

    // Personalize hero
    const firstName = fullName.split(' ')[0]
    if (firstName) {
      const nameEl = document.getElementById('invitee-name')
      if (nameEl) nameEl.textContent = firstName + '!'
    }
    if (startsAtFormatted) {
      const subtextEl = document.getElementById('hero-subtext')
      if (subtextEl) subtextEl.textContent = 'Dein Termin am ' + startsAtFormatted + ' ist reserviert. Wir freuen uns drauf.'
    }

    // Show booking detail rows
    function showRow(rowId: string, contentId: string, text: string) {
      if (!text) return
      const row     = document.getElementById(rowId)
      const content = document.getElementById(contentId)
      if (row && content) {
        content.textContent = text
        row.classList.remove('hidden')
        row.classList.add('flex')
      }
    }
    showRow('row-date',  'meeting-date',       startsAtFormatted)
    showRow('row-email', 'invitee-email-text', email)
    showRow('row-type',  'meeting-type-text',  type)

    // Pabbly webhook + GA event — once per session, only when email present
    const webhookUrl = (window as any).__dankeWebhookUrl as string
    if (email && !sessionStorage.getItem(KEY)) {
      sessionStorage.setItem(KEY, '1')

      // GA4 — booking confirmed
      // @ts-ignore – gtag wird global vom GA4-Snippet bereitgestellt
      if (typeof gtag === 'function') {
        gtag('event', 'booking_confirmed', {
          meeting_type: type || 'unknown',
          source: 'simplymeet',
        })
      }

      // Pabbly webhook
      if (webhookUrl) {
        fetch(webhookUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            invitee_full_name:    fullName,
            invitee_email:        email,
            meeting_starts_at:    startsAt,
            meeting_type:         type,
            invitee_phone_number: phone,
            source:               'simplymeet',
          }),
        }).catch(() => {})
      }
    }
  </script>

</BaseLayout>
