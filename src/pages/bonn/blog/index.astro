---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import Navbar from '../../../components/Navbar.astro'
import Footer from '../../../components/Footer.astro'
import { getCollection } from 'astro:content'

const allPosts = await getCollection('blog')
const posts = allPosts
  .filter(p => p.data.city === 'bonn')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())

const featured = posts.find(p => p.data.featured) ?? posts[0]
const rest = posts.filter(p => p.slug !== featured?.slug)

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('de-DE', { day: 'numeric', month: 'long', year: 'numeric' }).format(date)
}

const categoryColors: Record<string, string> = {
  'Ratgeber':  'bg-gold-600/20 text-gold-400 border border-gold-600/30',
  'Strategie': 'bg-blue-900/30 text-blue-300 border border-blue-700/30',
  'How-to':    'bg-emerald-900/30 text-emerald-300 border border-emerald-700/30',
  'News':      'bg-white/10 text-white/60 border border-white/10',
}
---

<BaseLayout
  title="Blog Bonn – bonuskarte.digital | Kundenbindung für Bonner Betriebe"
  description="Tipps und Strategien zur digitalen Kundenbindung für Cafés, Restaurants und Dönerläden in Bonn – Innenstadt, Kessenich, Beuel, Poppelsdorf und mehr."
>
  <Navbar dark={true} ctaHref="/#demo" />

  <section class="relative bg-black overflow-hidden pt-32 pb-20">
    <div class="absolute inset-0 bg-grid-white opacity-100 pointer-events-none"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-black via-black/80 to-black pointer-events-none"></div>
    <div class="relative max-w-6xl mx-auto px-5 sm:px-8">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 text-gold-600 text-xs font-bold tracking-[0.3em] uppercase mb-6">
          <span class="w-8 h-px bg-gold-600"></span>
          Bonn · FUERTE.DIGITAL
        </div>
        <h1 class="text-5xl sm:text-6xl font-black text-white tracking-tight leading-none mb-5">
          BLOG<br/><span class="text-gold-600">BONN</span>
        </h1>
        <p class="text-lg text-white/50 leading-relaxed max-w-lg">
          Wissen für Bonner Unternehmer. Kundenbindung für Innenstadt, Kessenich, Beuel und alle Bonner Stadtteile.
        </p>
        <nav class="flex items-center gap-2 text-xs text-white/55 mt-8 tracking-wide">
          <a href="/" class="hover:text-white/60 transition-colors">Home</a>
          <span>›</span>
          <a href="/bonn" class="hover:text-white/60 transition-colors">Bonn</a>
          <span>›</span>
          <span class="text-white/50">Blog</span>
        </nav>
      </div>
    </div>
  </section>

  {featured && (
    <section class="bg-black">
      <div class="max-w-6xl mx-auto px-5 sm:px-8">
        <a href={`/bonn/blog/${featured.slug}`} class="group block">
          <div class="grid md:grid-cols-2 gap-0 border border-white/10 hover:border-gold-600/40 transition-colors duration-300 overflow-hidden">
            <div class="relative overflow-hidden aspect-[4/3] md:aspect-auto min-h-[280px]">
              <img src={featured.data.heroImage} alt={featured.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="eager" />
              <div class="absolute inset-0 bg-black/20"></div>
              <div class="absolute top-4 left-4">
                <span class="inline-block bg-gold-600 text-black text-xs font-bold tracking-widest uppercase px-3 py-1.5">Featured</span>
              </div>
            </div>
            <div class="bg-ink-900 p-8 sm:p-10 flex flex-col justify-center">
              <div class="flex items-center gap-3 mb-5">
                <span class={`text-xs font-semibold tracking-wide uppercase px-2.5 py-1 rounded-sm ${categoryColors[featured.data.category]}`}>{featured.data.category}</span>
                <span class="text-white/55 text-xs">{featured.data.readingTime} Min. Lesezeit</span>
              </div>
              <h2 class="text-2xl sm:text-3xl font-bold text-white leading-snug mb-4 group-hover:text-gold-400 transition-colors">{featured.data.title}</h2>
              <p class="text-white/50 leading-relaxed text-sm mb-6 line-clamp-3">{featured.data.description}</p>
              <div class="flex items-center justify-between">
                <span class="text-white/55 text-xs">{formatDate(featured.data.pubDate)}</span>
                <span class="text-gold-600 text-xs font-bold tracking-widest uppercase">Weiterlesen →</span>
              </div>
            </div>
          </div>
        </a>
      </div>
    </section>
  )}

  {rest.length > 0 && (
    <section class="bg-black py-16">
      <div class="max-w-6xl mx-auto px-5 sm:px-8">
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-px bg-white/5">
          {rest.map(post => (
            <a href={`/bonn/blog/${post.slug}`} class="group bg-black hover:bg-ink-900 transition-colors duration-200 p-7 flex flex-col">
              <div class="relative overflow-hidden aspect-video mb-6">
                <img src={post.data.heroImage} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
              </div>
              <h3 class="text-base font-bold text-white leading-snug mb-3 group-hover:text-gold-400 transition-colors flex-1">{post.data.title}</h3>
              <span class="text-white/50 text-xs">{formatDate(post.data.pubDate)}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="bg-black border-t border-white/5 py-20">
    <div class="max-w-3xl mx-auto px-5 sm:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl font-black text-white mb-5">Bereit für Ihre digitale Kundenkarte in Bonn?</h2>
      <a href="/bonn/innenstadt/cafes" class="inline-flex items-center gap-3 bg-gold-600 hover:bg-gold-500 text-black font-bold text-xs tracking-widest uppercase px-8 py-4 transition-colors">
        Jetzt gratis starten →
      </a>
    </div>
  </section>

  <Footer />
</BaseLayout>
