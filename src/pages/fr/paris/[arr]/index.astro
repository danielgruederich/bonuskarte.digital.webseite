---
import BaseLayout from '../../../../layouts/BaseLayout.astro'
import NavbarFr from '../../../../components/NavbarFr.astro'
import FooterFr from '../../../../components/FooterFr.astro'
import { arrondissements, getArrondissement, fallbackArrondissement } from '../../../../data/fr/paris'
import { nichesFr } from '../../../../data/fr/niches-fr'

export function getStaticPaths() {
  return arrondissements.map(a => ({ params: { arr: a.slug } }))
}

const { arr } = Astro.params
const data = getArrondissement(arr) ?? fallbackArrondissement

const trustItems = ['✅ 90 jours gratuits', '🔒 RGPD', '⚡ En ligne en 24h', '📱 Apple & Google Wallet']
---

<BaseLayout
  title={`Carte de fidélité numérique à ${data.name} (${data.cp}) | bonuskarte.digital`}
  description={`Fidélisez vos clients dans le ${data.arrLong} (${data.cp}). Choisissez votre secteur et démarrez 90 jours gratuits — Apple & Google Wallet, sans application.`}
  lang="fr"
  locale="fr_FR"
>
  <NavbarFr ctaHref="#secteurs" ctaLabel="Commencer" />

  <section class="relative min-h-screen flex items-center bg-paper overflow-hidden">
    <div class="absolute inset-0 bg-grid-ink"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[500px] bg-amber rounded-full blur-[200px] opacity-5"></div>

    <div class="relative max-w-4xl mx-auto px-5 sm:px-8 pt-28 pb-20 w-full">

      <!-- Eyebrow -->
      <div class="inline-flex items-center gap-3 border border-amber/30 px-4 py-2 mb-10">
        <span class="w-1 h-1 bg-amber animate-pulse-slow"></span>
        <span class="text-amber text-[10px] font-normal tracking-[0.3em] uppercase">
          Paris · {data.name}
        </span>
      </div>

      <!-- Headline -->
      <h1 class="text-5xl sm:text-6xl leading-[1.1] tracking-tight mb-6">
        <span class="font-normal text-ink block mb-2">Fidélisation numérique</span>
        <span class="font-bold text-amber block">pour {data.name}.</span>
      </h1>

      <p class="text-ink/40 text-base font-normal leading-relaxed mb-4 max-w-lg">
        {data.arrLong} · {data.cp} · {data.quartiers}
      </p>

      <p class="text-ink/40 text-base font-normal leading-relaxed mb-14 max-w-lg">
        {data.intro}
      </p>

      <!-- Secteur selector -->
      <div id="secteurs" class="grid grid-cols-2 md:grid-cols-5 gap-4">
        {nichesFr.map(n => (
          <a
            href={`/fr/paris/${data.slug}/${n.slug}`}
            class="group relative border border-ink/15 hover:border-amber bg-ink/2 hover:bg-amber/5 p-6 text-center transition-all hover:-translate-y-1"
          >
            <!-- FOMO badge -->
            {data.fomoCount[n.fomoKey] > 0 && (
              <div class="absolute -top-2.5 left-1/2 -translate-x-1/2 bg-amber text-black text-[9px] font-black tracking-wider uppercase px-2.5 py-1 whitespace-nowrap">
                {data.fomoCount[n.fomoKey]} l'utilisent déjà
              </div>
            )}

            <div class="text-4xl mb-4 group-hover:scale-110 transition-transform">{n.emoji}</div>
            <div class="text-ink font-bold text-sm tracking-wide mb-1">{n.label}</div>

            <div class="mt-4 flex items-center justify-center gap-1 text-amber text-[10px] font-bold tracking-widest uppercase opacity-0 group-hover:opacity-100 transition-opacity">
              Choisir
              <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
          </a>
        ))}
      </div>

      <!-- Trust row -->
      <div class="flex flex-wrap gap-6 mt-12">
        {trustItems.map(t => (
          <span class="text-[10px] tracking-widest uppercase text-ink/50">{t}</span>
        ))}
      </div>

    </div>
  </section>

  <FooterFr />
</BaseLayout>
