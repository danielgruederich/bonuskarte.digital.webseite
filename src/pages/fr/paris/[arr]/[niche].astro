---
import BaseLayout from '../../../../layouts/BaseLayout.astro'
import NavbarFr from '../../../../components/NavbarFr.astro'
import FooterFr from '../../../../components/FooterFr.astro'
import LeadFormFr from '../../../../components/LeadFormFr.tsx'
import { arrondissements, getArrondissement, fallbackArrondissement } from '../../../../data/fr/paris'
import { nichesFr, getNicheFr } from '../../../../data/fr/niches-fr'

// ── Static paths: 20 arrondissements × 10 niches = 200 pages ─────────────────
export function getStaticPaths() {
  return arrondissements.flatMap(a =>
    nichesFr.map(n => ({
      params: { arr: a.slug, niche: n.slug },
    }))
  )
}

const { arr: arrSlug, niche: nicheSlug } = Astro.params
const a = getArrondissement(arrSlug) ?? fallbackArrondissement
const n = getNicheFr(nicheSlug)!

// ── Token fill helper ─────────────────────────────────────────────────────────
const fill = (s: string) =>
  s
    .replace(/\{arr\}/g,       a.name)
    .replace(/\{cp\}/g,        a.cp)
    .replace(/\{fomoCount\}/g, String(a.fomoCount[n.fomoKey]))

// Resolved hero copy
const eyebrow      = fill(n.heroCopy.eyebrow)
const headlineLight = fill(n.heroCopy.headlineLight)
const headlineBold  = fill(n.heroCopy.headlineBold)
const bodyText      = fill(n.heroCopy.bodyText)
const fomoText      = fill(n.heroCopy.fomoText)
const ctaLabel      = fill(n.heroCopy.ctaLabel)

const fomoCount = a.fomoCount[n.fomoKey]
const showFomo  = fomoCount > 0

const whatsappUrl = 'https://wa.me/491705594140'
---

<BaseLayout
  title={fill(n.seoTitle)}
  description={fill(n.seoDescription)}
  lang="fr"
  locale="fr_FR"
>
  <NavbarFr ctaHref="#demo" ctaLabel={ctaLabel} />

  <!-- ── HERO ──────────────────────────────────────────────────────────────── -->
  <section class="relative min-h-screen flex items-center bg-paper overflow-hidden">
    <div class="absolute inset-0 bg-grid-ink"></div>
    <div class="absolute top-1/2 -right-40 w-[600px] h-[600px] bg-amber rounded-full blur-[200px] opacity-5"></div>

    <div class="relative max-w-6xl mx-auto px-5 sm:px-8 pt-20 pb-12 grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-12 items-center w-full">
      <div>
        <!-- Eyebrow -->
        <div class="inline-flex items-center gap-3 border border-amber/30 px-4 py-2 mb-8">
          <span class="w-1 h-1 bg-amber animate-pulse-slow"></span>
          <span class="text-amber text-xs font-normal tracking-[0.3em] uppercase">{eyebrow}</span>
        </div>

        <!-- Headline -->
        <h1 class="text-5xl sm:text-6xl leading-[1.1] tracking-tight mb-8">
          <span class="font-normal text-ink block mb-2">{headlineLight}</span>
          <span class="font-bold text-amber block">{headlineBold}</span>
        </h1>

        <!-- FOMO (only when count > 0; currently never) -->
        {showFomo && (
          <div class="flex items-center gap-3 border border-amber/20 bg-amber/5 px-4 py-2.5 mb-6">
            <svg class="w-4 h-4 text-amber shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
            </svg>
            <span class="text-amber text-xs tracking-[0.1em] font-normal">{fomoText}</span>
          </div>
        )}

        <!-- Body text -->
        <p class="text-ink text-base leading-relaxed mb-6 max-w-md font-normal">{bodyText}</p>

        <!-- 90 jours badge -->
        <div class="inline-flex items-center gap-3 border border-amber/30 bg-amber/5 px-4 py-2.5 mb-6">
          <svg class="w-4 h-4 text-amber shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
          </svg>
          <span class="text-amber text-xs tracking-[0.15em] font-normal uppercase">
            90 jours offerts — sans engagement
          </span>
        </div>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="#demo"
            class="group inline-flex items-center justify-center gap-3 bg-amber hover:bg-amber-dark text-black px-8 py-4 text-sm font-bold tracking-[0.2em] uppercase transition-all">
            {ctaLabel}
            <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer"
            onclick="if(typeof analytics!=='undefined')analytics.whatsappClicked('hero')"
            class="group inline-flex items-center justify-center gap-3 border border-ink/10 hover:border-[#25D366]/50 text-ink hover:text-ink px-8 py-4 text-xs font-medium tracking-[0.2em] uppercase transition-all">
            <svg class="w-4 h-4 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Contacter par WhatsApp
          </a>
        </div>

        <!-- Trust badges -->
        <div class="flex flex-wrap gap-5 mt-10">
          <span class="inline-flex items-center gap-2 text-xs tracking-wider uppercase text-ink font-normal">
            <svg class="w-4 h-4 text-amber" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            RGPD
          </span>
          <span class="inline-flex items-center gap-2 text-xs tracking-wider uppercase text-ink font-normal">
            <svg class="w-4 h-4 text-amber" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
            Apple &amp; Google Wallet
          </span>
          <span class="inline-flex items-center gap-2 text-xs tracking-wider uppercase text-ink font-normal">
            <svg class="w-4 h-4 text-amber" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            En ligne en 24h
          </span>
          <span class="inline-flex items-center gap-2 text-xs tracking-wider uppercase text-ink font-normal">
            <svg class="w-4 h-4 text-amber" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Sans abonnement
          </span>
        </div>
      </div>

      <!-- Right col: SEO-rich arrondissement intro block -->
      <div class="hidden md:flex flex-col justify-center gap-6">
        <div class="border border-ink/15 bg-ink/2 p-8">
          <p class="text-amber text-xs tracking-[0.3em] uppercase mb-4">
            {a.name} · {a.arrLong} · {a.cp}
          </p>
          <p class="text-ink/70 text-sm leading-relaxed mb-4">{a.intro}</p>
          <p class="text-ink/40 text-xs leading-relaxed">
            Quartiers : {a.quartiers}
          </p>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="border border-amber/20 p-5 text-center">
            <div class="text-3xl font-black text-amber mb-1">90</div>
            <div class="text-ink text-xs font-semibold">jours offerts</div>
            <div class="text-ink/40 text-xs">sans risque</div>
          </div>
          <div class="border border-amber/20 p-5 text-center">
            <div class="text-3xl font-black text-amber mb-1">0€</div>
            <div class="text-ink text-xs font-semibold">pour démarrer</div>
            <div class="text-ink/40 text-xs">sans carte bancaire</div>
          </div>
        </div>
      </div>
    </div>

    <div class="absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-t from-paper to-transparent"></div>
  </section>

  <!-- ── SEO PARAGRAPH ────────────────────────────────────────────────────── -->
  <section class="py-10 sm:py-12 px-5 sm:px-8 bg-paper border-t border-ink/15">
    <div class="max-w-3xl mx-auto">
      <p class="text-ink/50 text-sm leading-relaxed">
        Vous gérez une <strong class="text-ink/70">{n.label}</strong> dans le <strong class="text-ink/70">{a.arrLong}</strong> ({a.cp}) — {a.quartiers} ?
        bonuskarte.digital propose un programme de fidélité numérique directement dans Apple Wallet et Google Wallet, sans application à télécharger pour vos clients.
        Notre solution est conçue pour les commerçants de proximité à <strong class="text-ink/70">{a.name}</strong> qui souhaitent fidéliser leur clientèle locale
        et augmenter leur fréquence de visite, sans contrainte technique ni engagement de durée.
        Testez gratuitement pendant 90 jours depuis votre {n.label} dans le {a.arrLong} ({a.cp}).
      </p>
    </div>
  </section>

  <!-- ── ARGUMENTS ─────────────────────────────────────────────────────────── -->
  <section class="py-12 sm:py-16 px-5 sm:px-8 bg-paper">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-center gap-4 mb-14">
        <div class="h-px flex-1 bg-ink/20"></div>
        <span class="text-xs tracking-[0.4em] uppercase text-ink">Les avantages</span>
        <div class="h-px flex-1 bg-ink/20"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {n.arguments.map(arg => (
          <div class="group border border-ink/15 hover:border-amber/30 p-8 transition-all">
            <div class="mb-5 group-hover:scale-110 transition-transform inline-block">
              <span class="text-4xl text-amber">{arg.icon}</span>
            </div>
            <h3 class="font-bold text-ink text-lg mb-3">{arg.title}</h3>
            <p class="text-ink text-base leading-relaxed font-normal">{arg.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── OFFER ──────────────────────────────────────────────────────────────── -->
  <section class="py-12 sm:py-16 px-5 sm:px-8 bg-paper relative overflow-hidden">
    <div class="absolute inset-0 bg-grid-ink opacity-50"></div>
    <div class="relative max-w-3xl mx-auto text-center">
      <div class="flex items-center gap-4 mb-10">
        <div class="h-px flex-1 bg-ink/20"></div>
        <span class="text-xs tracking-[0.4em] uppercase text-ink">L'offre</span>
        <div class="h-px flex-1 bg-ink/20"></div>
      </div>
      <h2 class="text-4xl sm:text-5xl font-normal text-ink tracking-tight mb-2">90 jours d'essai.</h2>
      <h2 class="text-4xl sm:text-5xl font-bold text-amber tracking-tight mb-10">0 € de risque.</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {[
          { n: '0€',  label: 'Frais de démarrage', sub: 'Commencez sans rien débourser' },
          { n: '90',  label: 'Jours offerts',       sub: 'Sans risque, sans pression'   },
          { n: '∞',   label: 'Clients fidèles',     sub: 'Qui reviennent toujours'      },
        ].map(stat => (
          <div class="border border-amber/20 p-6 text-center">
            <div class="text-4xl font-black text-amber mb-1">{stat.n}</div>
            <div class="text-ink font-semibold text-sm mb-1">{stat.label}</div>
            <div class="text-ink text-sm">{stat.sub}</div>
          </div>
        ))}
      </div>
      <div class="mt-10">
        <a href="#demo"
          class="group inline-flex items-center gap-3 bg-amber hover:bg-amber-dark text-black px-10 py-5 text-sm font-bold tracking-[0.25em] uppercase transition-all">
          Tester 90 jours gratuitement
          <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ── FAQ ───────────────────────────────────────────────────────────────── -->
  <section class="py-12 sm:py-16 px-5 sm:px-8 bg-paper relative overflow-hidden">
    <div class="absolute inset-0 bg-grid-ink opacity-50"></div>
    <div class="relative max-w-3xl mx-auto">
      <div class="flex items-center gap-4 mb-10">
        <div class="h-px flex-1 bg-ink/20"></div>
        <span class="text-xs tracking-[0.4em] uppercase text-ink">Questions fréquentes</span>
        <div class="h-px flex-1 bg-ink/20"></div>
      </div>
      <div class="space-y-4">
        {[
          {
            q: 'Les 90 jours sont-ils vraiment gratuits ?',
            a: 'Oui, entièrement. Aucune carte bancaire requise, aucun frais caché. Après 90 jours, vous choisissez si vous continuez — à partir de 29 €/mois. Sans engagement.',
          },
          {
            q: 'Mes clients doivent-ils télécharger une application ?',
            a: 'Non. La carte s\'ajoute directement dans Apple Wallet ou Google Wallet — préinstallés sur tous les smartphones. Aucun téléchargement, aucun compte à créer.',
          },
          {
            q: 'Combien de temps faut-il pour démarrer ?',
            a: 'Zéro effort de votre côté. Vous remplissez le formulaire, nous créons votre carte avec votre branding. En moins de 24h, vous êtes en ligne.',
          },
          {
            q: 'Quel est le tarif après la période d\'essai ?',
            a: 'À partir de 29 €/mois pour un établissement. Cartes illimitées, notifications push, statistiques — tout inclus. Sans frais de démarrage, sans abonnement annuel obligatoire.',
          },
          {
            q: 'Est-ce conforme au RGPD ?',
            a: 'Oui. Toutes les données sont traitées conformément au RGPD. Aucun cookie de tracking sur le téléphone de vos clients, aucune donnée revendue.',
          },
        ].map(faq => (
          <details class="group border border-ink/15 hover:border-amber/20 transition-colors">
            <summary class="flex items-center justify-between cursor-pointer p-5 sm:p-6">
              <span class="text-ink text-sm sm:text-base font-medium pr-4">{faq.q}</span>
              <svg class="w-4 h-4 text-amber flex-shrink-0 group-open:rotate-45 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
              </svg>
            </summary>
            <div class="px-5 sm:px-6 pb-5 sm:pb-6">
              <p class="text-ink text-sm leading-relaxed font-normal">{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ── LEAD FORM ─────────────────────────────────────────────────────────── -->
  <section id="demo" class="py-12 sm:py-16 px-5 sm:px-8 bg-paper relative overflow-hidden">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] bg-amber rounded-full blur-[180px] opacity-5"></div>
    <div class="relative max-w-xl mx-auto">
      <div class="text-center mb-10">
        <div class="inline-flex items-center gap-3 border border-amber/30 bg-amber/5 px-4 py-2 mb-8">
          <svg class="w-4 h-4 text-amber shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
          </svg>
          <span class="text-amber text-xs tracking-[0.3em] uppercase">
            Exclusif {n.emoji} à {a.name}
          </span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-normal text-ink tracking-tight mb-2">Démarrez</h2>
        <h2 class="text-3xl sm:text-4xl font-bold text-ink tracking-tight mb-6">gratuitement.</h2>
        <p class="text-ink text-base font-normal leading-relaxed max-w-sm mx-auto">
          Laissez vos coordonnées — nous vous contactons sous 24h pour lancer votre carte de fidélité.
        </p>
      </div>

      <div class="relative border border-amber/20 bg-paper p-8 sm:p-10">
        <LeadFormFr client:visible niche={n.label} arr={a.name} />
      </div>

      <p class="text-center text-ink/50 text-sm mt-5">
        Après 90 jours à partir de 29 €/mois · sans engagement · sans carte bancaire
      </p>
    </div>
  </section>

  <!-- ── FINAL CTA ─────────────────────────────────────────────────────────── -->
  <section class="py-12 sm:py-16 px-5 sm:px-8 bg-paper border-t border-ink/15 relative overflow-hidden">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[300px] bg-amber rounded-full blur-[150px] opacity-5"></div>
    <div class="relative max-w-2xl mx-auto text-center">
      <p class="text-amber text-xs tracking-[0.4em] uppercase mb-6">Sans risque</p>
      <h2 class="text-4xl font-normal text-ink tracking-tight mb-2">90 jours gratuits.</h2>
      <h2 class="text-4xl font-bold text-ink tracking-tight mb-10">Convainquez-vous.</h2>
      <a href="#demo"
        class="group inline-flex items-center gap-3 bg-amber hover:bg-amber-dark text-black px-10 py-5 text-sm font-bold tracking-[0.25em] uppercase transition-all">
        {ctaLabel}
        <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </section>

  <FooterFr />
</BaseLayout>
