---
import { getCollection } from 'astro:content'
import BlogArticleHeader from '@/components/blog/BlogArticleHeader.astro'
import BlogRelated from '@/components/blog/BlogRelated.astro'
import { blogOgImage } from '@/data/blog-style'
import BaseLayout from '@/layouts/BaseLayout.astro'
import NavbarFr from '@/components/NavbarFr.astro'
import FooterFr from '@/components/FooterFr.astro'
import { getLangFromSlug, stripLang } from '@/data/hilfe-categories'
import { BLOG_UI, blogBase, getBlogCategoryLabel } from '@/data/blog-i18n'

const lang = 'fr' as const
const ui = BLOG_UI[lang]
const base = blogBase(lang)

export async function getStaticPaths() {
  const posts = await getCollection('blog')
  return posts
    .filter(p => getLangFromSlug(p.slug) === 'fr')
    .map(post => ({
      params: { slug: stripLang(post.slug) },
      props: { post },
    }))
}

const { post } = Astro.props
const { Content } = await post.render()
const articleUrl = `https://bonuskarte.digital${base}/${stripLang(post.slug)}`


const allPosts = await getCollection('blog')
const relatedNow = new Date()
const related = allPosts
  .filter(p => getLangFromSlug(p.slug) === 'fr' && p.slug !== post.slug && p.data.pubDate <= relatedNow)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3)
---

<BaseLayout
  title={`${post.data.title} — bonuskarte.digital`}
  description={post.data.description}
  ogImage={blogOgImage(post)}
  lang={lang}
  locale={ui.locale}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": post.data.title,
    "description": post.data.description,
    "image": `https://bonuskarte.digital${blogOgImage(post)}`,
    "inLanguage": "fr",
    "datePublished": post.data.pubDate.toISOString(),
    "dateModified": (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    "author": { "@type": "Person", "name": "Daniel Grüderich", "url": "https://www.linkedin.com/in/dgruederich/" },
    "publisher": {
      "@type": "Organization",
      "name": "bonuskarte.digital",
      "logo": { "@type": "ImageObject", "url": "https://bonuskarte.digital/favicon.svg" }
    },
    "mainEntityOfPage": { "@type": "WebPage", "@id": articleUrl }
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": ui.breadcrumbHome, "item": "https://bonuskarte.digital/fr/"},
      {"@type": "ListItem", "position": 2, "name": ui.breadcrumbBlog, "item": `https://bonuskarte.digital${base}`},
      {"@type": "ListItem", "position": 3, "name": post.data.title, "item": articleUrl}
    ]
  })} />
  {post.data.faqItems && post.data.faqItems.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": post.data.faqItems.map((item: {q: string, a: string}) => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": { "@type": "Answer", "text": item.a }
      }))
    })} />
  )}
  <NavbarFr ctaHref="/fr/" />

  <!-- Reading progress bar -->
  <div class="fixed top-0 left-0 right-0 z-[100] h-0.5 bg-transparent">
    <div id="progress-bar" class="h-full bg-amber transition-none" style="width:0%"></div>
  </div>

  <BlogArticleHeader post={post} lang={lang} crumbs={[{ label: ui.breadcrumbHome, href: '/fr/' }, { label: ui.breadcrumbBlog, href: `${base}/` }, { label: getBlogCategoryLabel(post.data.category, lang) }]} />

  <!-- ── Article Body ─────────────────────────── -->
  <main class="bg-white">
    <div class="max-w-2xl mx-auto px-5 sm:px-8 py-12 sm:py-16">
      <article id="article-body" class="article-body">
        <Content />
      </article>
    </div>
  </main>

  <!-- ── Author Bio ───────────────────────────── -->
  <section class="bg-paper-dark py-10 sm:py-12 border-t border-ink/10">
    <div class="max-w-2xl mx-auto px-5 sm:px-8">
      <div class="flex items-start gap-5">
        <img src="/images/daniel-gruederich.png" alt="Daniel Grüderich" class="w-16 h-16 rounded-full object-cover object-top flex-shrink-0" />
        <div>
          <div class="text-xs font-bold tracking-[0.2em] uppercase text-ink-500 mb-1">{ui.authorHeading}</div>
          <div class="text-ink font-semibold text-sm mb-0.5">Daniel Grüderich</div>
          <div class="text-amber-text text-xs font-medium mb-2">{ui.authorRole}</div>
          <p class="text-ink-500 text-sm leading-relaxed">{ui.authorBio}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── CTA Banner ───────────────────────────── -->
  <section class="bg-ink py-14 sm:py-20">
    <div class="max-w-2xl mx-auto px-5 sm:px-8">
      <div class="flex flex-col sm:flex-row sm:items-center gap-6 sm:gap-10">
        <div class="flex-1">
          <div class="text-amber text-xs font-bold tracking-[0.25em] uppercase mb-2">{ui.ctaEyebrow}</div>
          <h2 class="text-2xl sm:text-3xl font-black text-paper leading-tight">
            {ui.ctaTitle}
          </h2>
          <p class="text-ink-200 text-sm mt-2 leading-relaxed">
            {ui.ctaText}
          </p>
        </div>
        <div class="flex-shrink-0">
          <a
            href="/fr/"
            class="inline-flex items-center justify-center gap-2 bg-amber hover:bg-amber-dark text-ink font-bold text-xs tracking-widest uppercase px-7 py-4 transition-colors group"
          >
            {ui.ctaButton}
            <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <BlogRelated lang={lang} title={ui.relatedTitle} allLabel={ui.relatedAll} allHref={`${base}/`} posts={related.map(p => ({ post: p, href: `${base}/${stripLang(p.slug)}/` }))} />


  <FooterFr />
</BaseLayout>

<!-- Reading progress bar script -->
<script>
  const bar = document.getElementById('progress-bar')
  const article = document.getElementById('article-body')

  if (bar && article) {
    window.addEventListener('scroll', () => {
      const articleTop = article.getBoundingClientRect().top + window.scrollY
      const articleH   = article.offsetHeight
      const winH       = window.innerHeight
      const scrolled   = window.scrollY - articleTop
      const total      = articleH - winH
      const pct        = total > 0 ? Math.min(100, Math.max(0, (scrolled / total) * 100)) : 0
      bar.style.width  = pct + '%'
    }, { passive: true })
  }
</script>

