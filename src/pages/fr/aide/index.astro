---
import BaseLayout from '@/layouts/BaseLayout.astro'
import NavbarFr from '@/components/NavbarFr.astro'
import FooterFr from '@/components/FooterFr.astro'
import { getCollection } from 'astro:content'
import { hilfeCategories, getCategoryFromSlug, getLangFromSlug, getCategoryLabel, stripLang, hilfeBase, HILFE_UI } from '@/data/hilfe-categories'

const lang = 'fr'
const ui = HILFE_UI[lang]
const base = hilfeBase(lang)
const allEntries = (await getCollection('hilfe')).filter(e => getLangFromSlug(e.slug) === lang)

const categories = hilfeCategories.map(cat => ({
  ...cat,
  count: allEntries.filter(e => getCategoryFromSlug(e.slug) === cat.slug).length,
  firstSlug: allEntries
    .filter(e => getCategoryFromSlug(e.slug) === cat.slug)
    .sort((a, b) => a.data.order - b.data.order)[0]?.slug,
}))
---

<BaseLayout
  title={ui.metaTitle}
  description={ui.metaDescription}
  lang="fr"
  locale="fr_FR"
  alternates={[
    { hreflang: 'de', href: 'https://bonuskarte.digital/hilfe/' },
    { hreflang: 'fr', href: 'https://bonuskarte.digital/fr/aide/' },
    { hreflang: 'en', href: 'https://bonuskarte.digital/en/help/' },
    { hreflang: 'x-default', href: 'https://bonuskarte.digital/hilfe/' },
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": ui.centerTitle,
    "description": ui.metaDescription,
    "url": `https://bonuskarte.digital${base}`,
    "isPartOf": {
      "@type": "WebSite",
      "name": "bonuskarte.digital",
      "url": "https://bonuskarte.digital"
    }
  })} />
  <NavbarFr ctaHref={`${base}/`} ctaLabel={ui.navLabel} />

  <main class="min-h-screen bg-paper pt-24 pb-16">
    <div class="max-w-4xl mx-auto px-5 sm:px-8">

      <!-- Hero -->
      <div class="text-center mb-16">
        <p class="text-xs font-medium tracking-[0.3em] uppercase text-amber mb-4">
          {ui.heroEyebrow}
        </p>
        <h1 class="text-4xl sm:text-5xl font-bold text-ink mb-4">
          {ui.heroTitle}
        </h1>
        <p class="text-lg text-ink/50 max-w-xl mx-auto">
          {ui.heroSubtitle}
        </p>
      </div>

      <!-- Category Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {categories.filter(cat => cat.firstSlug).map(cat => (
          <a
            href={`${base}/${stripLang(cat.firstSlug)}/`}
            class="group block border border-ink/10 rounded-lg p-6 hover:border-amber/50 hover:bg-ink/[0.02] transition-all"
          >
            <span class="text-3xl mb-4 block">{cat.icon}</span>
            <h2 class="text-sm font-bold tracking-widest uppercase text-ink group-hover:text-amber transition-colors mb-2">
              {getCategoryLabel(cat.slug, lang)}
            </h2>
            <p class="text-xs text-ink/40">
              {cat.count} {cat.count === 1 ? 'article' : 'articles'}
            </p>
          </a>
        ))}
      </div>

    </div>
  </main>

  <FooterFr />
</BaseLayout>
