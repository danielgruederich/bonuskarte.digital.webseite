---
import BaseLayout from '../../layouts/BaseLayout.astro'
import NavbarFr from '../../components/NavbarFr.astro'
import FooterFr from '../../components/FooterFr.astro'

const cards = [
  {
    slug: 'carte-a-tampons',
    name: 'Carte à tampons',
    tag: 'Carte la plus populaire',
    tagline: '10 visites, 1 offerte.',
    description: 'La carte à tampons numérique remplace les cartes papier directement dans Apple Wallet & Google Wallet. Les clients collectent des tampons à chaque visite ou achat et obtiennent leur récompense en un clic.',
    useCases: ['Café & Boulangerie', 'Coiffeur & Beauté', 'Restaurant & Snack'],
    accent: '#8B7300',
    color: '#d4aa2a',
    stampCount: 10,
    stampsFilled: 7,
    cardLabel: 'Carte de fidélité',
    cardSub: '7 / 10 tampons',
    installLink: 'https://take.cards/xyBTG',
    highlight: true,
  },
  {
    slug: 'carte-10-seances',
    name: 'Carte 10 séances',
    tag: 'Pour les prestataires',
    tagline: '10 achetées, 11 reçues.',
    description: "Les clients achètent un forfait à l'avance — par exemple 10 séances de yoga. La carte affiche le solde restant en temps réel. Idéal pour tous ceux qui proposent des rendez-vous réguliers.",
    useCases: ['Yoga & Pilates', 'Fitness & Coaching personnel', 'Massage & Thérapie'],
    accent: '#1a6b4a',
    color: '#3aaa77',
    stampCount: 10,
    stampsFilled: 4,
    cardLabel: 'Carte de séances',
    cardSub: '4 sur 10 séances',
    installLink: 'https://take.cards/Joa7T',
    highlight: false,
  },
  {
    slug: 'coupon',
    name: 'Carte coupon',
    tag: 'Aimant à nouveaux clients',
    tagline: 'Offre de bienvenue, en numérique.',
    description: "Une réduction unique ou une offre gratuite pour les nouveaux clients — directement dans le Wallet. Pas d'impression, rien à perdre. Le client scanne, l'employé valide, c'est fait.",
    useCases: ['Réduction de bienvenue', 'Coupons happy hour', 'Promotions saisonnières'],
    accent: '#8B2500',
    color: '#e05030',
    stampCount: 0,
    stampsFilled: 0,
    cardLabel: '10 % de réduction',
    cardSub: 'Valable à la première visite',
    installLink: 'https://take.cards/WTwtQ',
    highlight: false,
  },
  {
    slug: 'carte-cadeau',
    name: 'Carte cadeau',
    tag: 'Idée cadeau',
    tagline: 'Solde numérique, à offrir.',
    description: "Des bons d'achat numériques dans Apple Wallet & Google Wallet. Les clients achètent, offrent et utilisent — entièrement sans papier. Le solde se met à jour automatiquement après chaque utilisation.",
    useCases: ['Cadeaux & Occasions', 'Spa & Bien-être', 'Commerce de détail'],
    accent: '#5B3A8B',
    color: '#9b7acc',
    stampCount: 0,
    stampsFilled: 0,
    cardLabel: 'Bon de 50 €',
    cardSub: '32,50 € encore disponibles',
    installLink: 'https://take.cards/dYns7',
    highlight: false,
  },
  {
    slug: 'carte-de-membre',
    name: 'Carte de membre',
    tag: 'VIP & Abonnement',
    tagline: 'Carte de membre numérique.',
    description: "La carte de membre numérique contient le nom, la photo (en option) et le statut d'adhésion — toujours à jour dans le Wallet. Parfait pour les clubs, les studios et tous les modèles d'abonnement.",
    useCases: ['Salle de sport & Studio', 'Club & Association', 'Programmes VIP'],
    accent: '#1a4a6b',
    color: '#4a9acc',
    stampCount: 0,
    stampsFilled: 0,
    cardLabel: 'Membre VIP',
    cardSub: "Valable jusqu'en déc. 2026",
    installLink: 'https://take.cards/viNUR',
    highlight: false,
  },
  {
    slug: 'carte-de-reduction',
    name: 'Carte de réduction',
    tag: "Basée sur le chiffre d'affaires",
    tagline: 'Plus vous dépensez, plus vous économisez.',
    description: "Les niveaux de réduction (Bronze, Argent, Or) augmentent automatiquement avec le chiffre d'affaires. Plus un client dépense, plus sa réduction permanente est élevée — une forte incitation aux achats répétés.",
    useCases: ['Mode & Lifestyle', 'Électronique & Tech', 'Commerce premium'],
    accent: '#6B4F1A',
    color: '#c4903a',
    stampCount: 0,
    stampsFilled: 0,
    cardLabel: 'Statut Or',
    cardSub: '25 % de réduction dès 1 000 €',
    installLink: 'https://take.cards/0RthB',
    highlight: false,
  },
  {
    slug: 'cashback',
    name: 'Carte cashback',
    tag: 'Avantage immédiat',
    tagline: 'Achetez, recevez du solde.',
    description: "Un pourcentage de chaque achat revient automatiquement sous forme de solde sur la carte. Les clients voient leur solde en temps réel et l'utilisent lors de leur prochaine visite.",
    useCases: ['Supermarché & Alimentation', 'Droguerie & Pharmacie', 'Station-service & Services'],
    accent: '#1A5C2A',
    color: '#4aaa5a',
    stampCount: 0,
    stampsFilled: 0,
    cardLabel: 'Carte cashback',
    cardSub: '3,50 € de solde',
    installLink: 'https://take.cards/h3dmR',
    highlight: false,
  },
  {
    slug: 'carte-a-points',
    name: 'Carte à points',
    tag: 'Collecte flexible',
    tagline: 'Cumulez des points, choisissez vos récompenses.',
    description: 'Les clients cumulent des points à chaque achat et les échangent contre des récompenses. Différents paliers de récompenses incitent au retour — comme Miles & More, mais pour les commerces locaux.',
    useCases: ['Hôtellerie & Restauration', 'Commerce de détail', 'En ligne & En boutique'],
    accent: '#3A1A6B',
    color: '#8a6acc',
    stampCount: 0,
    stampsFilled: 0,
    cardLabel: 'Carte à points',
    cardSub: '1 240 points',
    installLink: 'https://take.cards/DLt8y',
    highlight: false,
  },
]
---

<BaseLayout
  title="Tous les types de cartes – Carte à tampons, carte cadeau, abonnement & plus | bonuskarte.digital"
  description="8 cartes de fidélité numériques pour les commerces locaux : carte à tampons, carte 10 séances, coupon, carte cadeau, carte de membre, carte de réduction, cashback & carte à points – toutes dans Apple Wallet & Google Wallet."
  lang="fr"
  locale="fr_FR"
  alternates={[
    { hreflang: 'de', href: 'https://bonuskarte.digital/karten' },
    { hreflang: 'fr', href: 'https://bonuskarte.digital/fr/cartes' },
    { hreflang: 'x-default', href: 'https://bonuskarte.digital/karten' },
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "bonuskarte.digital", "item": "https://bonuskarte.digital/fr/" },
      { "@type": "ListItem", "position": 2, "name": "Toutes les cartes" }
    ]
  })} />

  <NavbarFr ctaHref="/fr/paris/" ctaLabel="Commencer maintenant" />

  <!-- HERO -->
  <section class="bg-paper pt-28 pb-14 px-5 sm:px-8 border-b border-ink/30">
    <div class="max-w-4xl mx-auto">
      <nav class="flex items-center gap-1.5 text-xs text-ink/40 mb-8 tracking-wide">
        <a href="/fr/" class="hover:text-ink/60 transition-colors">Accueil</a>
        <span>›</span>
        <span class="text-ink/60">Toutes les cartes</span>
      </nav>
      <div class="inline-flex items-center gap-3 border border-amber/50 px-4 py-2 mb-6">
        <span class="w-1 h-1 bg-amber animate-pulse-slow"></span>
        <span class="text-amber text-xs font-normal tracking-[0.3em] uppercase">8 types de cartes</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-normal text-ink tracking-tight mb-4">
        La bonne carte<br />
        <span class="font-bold text-amber">pour chaque établissement.</span>
      </h1>
      <p class="text-ink/60 text-base leading-relaxed max-w-2xl">
        Que vous soyez un café, une salle de sport ou une boutique — bonuskarte.digital a le type de carte qu'il vous faut. Toutes les cartes arrivent directement dans Apple Wallet & Google Wallet. Aucun téléchargement d'application, aucune inscription.
      </p>
    </div>
  </section>

  <!-- CARDS GRID -->
  <section class="bg-paper py-14 px-5 sm:px-8">
    <div class="max-w-5xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        {cards.map((card) => (
          <div class={`border ${card.highlight ? 'border-amber/40' : 'border-ink/8'} hover:border-ink/20 transition-colors p-0 overflow-hidden flex flex-col`}>

            <!-- Card mockup placeholder -->
            <div class="relative bg-paper p-6 flex items-center justify-center min-h-[160px]">
              {card.highlight && (
                <div class="absolute top-3 right-3 bg-amber text-black text-[10px] font-bold tracking-[0.2em] uppercase px-2 py-0.5">
                  Carte la plus populaire
                </div>
              )}

              <!-- Wallet card mockup -->
              <div class="w-full max-w-[280px] rounded-xl overflow-hidden shadow-2xl" style={`background: #111; border: 1px solid rgba(255,255,255,0.08);`}>
                <!-- Card top bar -->
                <div class="px-4 pt-3 pb-2 flex items-center justify-between" style={`background: ${card.accent}22; border-bottom: 1px solid ${card.accent}33;`}>
                  <span class="text-white/90 text-[11px] font-semibold tracking-wide">{card.cardLabel}</span>
                  <svg class="w-5 h-5 opacity-60" viewBox="0 0 24 24" fill="none">
                    <rect x="2" y="5" width="20" height="14" rx="2" stroke="white" stroke-width="1.5"/>
                    <path d="M2 10h20" stroke="white" stroke-width="1.5"/>
                  </svg>
                </div>

                <!-- Card body -->
                <div class="px-4 py-3">
                  {card.stampCount > 0 ? (
                    <!-- Stamp grid -->
                    <div class="grid grid-cols-5 gap-1.5 mb-3">
                      {Array.from({ length: card.stampCount }).map((_, i) => (
                        <div
                          class={`w-full aspect-square rounded-full border ${i < card.stampsFilled ? 'border-0' : 'border-white/15'}`}
                          style={i < card.stampsFilled ? `background: ${card.accent}` : 'background: rgba(255,255,255,0.05)'}
                        />
                      ))}
                    </div>
                  ) : (
                    <!-- Non-stamp visual -->
                    <div class="h-10 rounded flex items-center px-3 mb-3" style={`background: ${card.accent}18; border: 1px solid ${card.accent}33;`}>
                      <span class="text-white/80 text-sm font-normal">{card.cardSub}</span>
                    </div>
                  )}
                  <div class="flex items-center justify-between">
                    <span class="text-white/40 text-[10px]">{card.cardSub}</span>
                    <div class="flex items-center gap-0.5">
                      <div class="w-4 h-4 rounded-full bg-white/10" />
                      <div class="w-4 h-4 rounded-full bg-white/20 -ml-1" />
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Content -->
            <div class="p-6 flex flex-col flex-1">
              <div class="flex items-start justify-between gap-3 mb-3">
                <div>
                  <span class="text-[10px] tracking-[0.25em] uppercase font-medium mb-1 block" style={`color: ${card.color}`}>
                    {card.tag}
                  </span>
                  <h2 class="text-ink text-xl font-bold tracking-tight">{card.name}</h2>
                  <p class="text-ink/50 text-sm font-normal mt-0.5">{card.tagline}</p>
                </div>
              </div>

              <p class="text-ink/65 text-sm leading-relaxed mb-4">{card.description}</p>

              <!-- Use cases -->
              <div class="flex flex-wrap gap-2 mb-5">
                {card.useCases.map(uc => (
                  <span class="text-ink/40 text-[11px] border border-ink/8 px-2.5 py-1 tracking-wide">{uc}</span>
                ))}
              </div>

              <!-- CTA -->
              <div class="mt-auto">
                {card.installLink !== '#' ? (
                  <a
                    href={card.installLink}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 text-black text-xs font-bold tracking-[0.2em] uppercase px-5 py-3 hover:opacity-90 transition-opacity"
                    style={`background: ${card.highlight ? '#8B7300' : 'rgba(255,255,255,0.9)'}`}
                  >
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/>
                    </svg>
                    Tester cette carte
                  </a>
                ) : (
                  <a
                    href="/fr/paris/"
                    class="inline-flex items-center gap-2 text-ink/60 text-xs font-medium tracking-[0.15em] uppercase px-5 py-3 border border-ink/10 hover:border-ink/20 transition-colors"
                  >
                    Demander la carte
                  </a>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- COMPARISON NOTE -->
  <section class="bg-paper py-10 px-5 sm:px-8 border-t border-ink/30">
    <div class="max-w-4xl mx-auto flex flex-col sm:flex-row items-start sm:items-center gap-6">
      <div class="flex-1">
        <p class="text-ink/80 text-base font-normal leading-relaxed">
          <span class="text-ink font-semibold">Vous ne savez pas quelle carte choisir ?</span><br class="sm:hidden" />
          <span class="text-ink/60"> 90 % de nos clients commencent avec la carte à tampons. Nous vous conseillons gratuitement sous 24 heures.</span>
        </p>
      </div>
      <a
        href="/fr/paris/"
        class="flex-shrink-0 inline-flex items-center gap-2 bg-amber hover:bg-amber-dark text-black px-8 py-4 text-xs font-bold tracking-[0.2em] uppercase transition-all"
      >
        Démarrer gratuitement
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </section>

  <FooterFr />
</BaseLayout>
