---
import BaseLayout from '../../layouts/BaseLayout.astro'
import NavbarFr from '../../components/NavbarFr.astro'
import FooterFr from '../../components/FooterFr.astro'
import { uiFr } from '../../data/fr/ui-fr'
import { nichesFr } from '../../data/fr/niches-fr'
import PhoneMockup from '../../components/PhoneMockup.tsx'
import RotatingWordFr from '../../components/RotatingWordFr.tsx'

const howItWorks = [
  { step: '01', title: 'Créer votre carte', desc: 'Nous configurons votre carte de fidélité numérique avec votre logo et vos couleurs en moins de 24 heures.' },
  { step: '02', title: 'Inviter vos clients', desc: 'Vos clients scannent un QR code et enregistrent la carte directement dans leur Wallet — sans application.' },
  { step: '03', title: 'Tamponner en un clic', desc: 'Un clic depuis votre tableau de bord et le tampon apparaît instantanément sur le téléphone de votre client.' },
  { step: '04', title: 'Fidéliser durablement', desc: 'Notifications push, statistiques en temps réel, récompenses automatiques. Tout inclus, zéro effort.' },
]

const problems = [
  'Impossible de savoir combien de cartes papier sont encore utilisées',
  'Aucun canal direct pour contacter vos habitués',
  'Clients irréguliers faute d\'incentive à revenir',
  'Zéro données sur votre activité et vos clients',
]

const solutions = [
  'Carte toujours présente — directement dans Apple & Google Wallet',
  'Chiffres réels : cartes actives, tampons, taux de récompense',
  'Notifications push qui ramènent vos clients au bon moment',
  'Tableau de bord clair : qui sont vos meilleurs habitués',
]

// Show a sample of niches for the teaser
const nicheTeaser = nichesFr.slice(0, 6)
---

<BaseLayout
  title="Carte de fidélité numérique pour commerçants | bonuskarte.digital"
  description="Programme de fidélité numérique pour commerces de proximité — boulangeries, cafés, restaurants, coiffeurs. Apple & Google Wallet, sans application. 90 jours gratuits."
  lang="fr"
  locale="fr_FR"
  alternates={[
    { hreflang: 'de', href: 'https://bonuskarte.digital/' },
    { hreflang: 'fr', href: 'https://bonuskarte.digital/fr/' },
    { hreflang: 'x-default', href: 'https://bonuskarte.digital/' },
  ]}
>
  <NavbarFr ctaHref="/fr/paris/" ctaLabel={uiFr.nav.cta} />

  <!-- ── HERO ──────────────────────────────────────────────────── -->
  <section class="relative flex items-center bg-paper overflow-hidden min-h-screen">
    <div class="absolute inset-0 bg-grid-ink"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[600px] bg-amber rounded-full blur-[200px] opacity-5"></div>

    <div class="relative max-w-6xl mx-auto px-5 sm:px-8 pt-20 md:pt-24 pb-8 md:pb-12 w-full">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-12 lg:gap-16 items-stretch">
        <div class="text-center md:text-left">

          <!-- Eyebrow -->
          <div class="inline-flex items-center gap-3 border border-amber/50 px-4 py-2 mb-6 sm:mb-10">
            <span class="w-1 h-1 bg-amber animate-pulse-slow flex-shrink-0"></span>
            <span class="text-amber text-[10px] sm:text-xs font-normal tracking-[0.3em] uppercase">
              Boulangeries · Cafés · Restaurants · Coiffeurs
            </span>
          </div>

          <!-- H1 -->
          <h1 class="text-5xl sm:text-6xl leading-[1.1] tracking-tight mb-5 sm:mb-8">
            <span class="font-normal text-ink block mb-2">La carte de fidélité</span>
            <RotatingWordFr client:idle />
          </h1>

          <p class="text-ink text-base leading-relaxed mb-6 max-w-md mx-auto md:mx-0 font-normal">
            Plus de clients réguliers, plus de chiffre d'affaires. Votre carte de fidélité numérique directement dans leur téléphone — sans papier, sans application, sans effort.
          </p>

          <!-- Free trial badge -->
          <div class="inline-flex items-center gap-3 border border-amber/50 bg-amber/5 px-4 py-2.5 mb-6 sm:mb-10">
            <span class="text-amber text-xs tracking-[0.15em] font-normal">
              90 JOURS GRATUITS — SANS CARTE BANCAIRE
            </span>
          </div>

          <div class="flex flex-col sm:flex-row gap-3 justify-center md:justify-start">
            <a href="/fr/paris/"
              class="group inline-flex items-center justify-center gap-3 bg-amber hover:bg-amber-dark text-black px-8 py-4 text-xs font-bold tracking-[0.2em] uppercase transition-all">
              Commencer gratuitement
              <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
            <a href="#comment-ca-marche"
              class="inline-flex items-center justify-center border border-ink/10 hover:border-amber/40 text-ink px-8 py-4 text-xs font-medium tracking-[0.2em] uppercase transition-all">
              Comment ça marche
            </a>
          </div>

          <!-- Trust row -->
          <div class="flex flex-wrap gap-6 mt-6 sm:mt-10 justify-center md:justify-start">
            {uiFr.trust.map(t => (
              <span class="text-[10px] tracking-widest uppercase text-ink/50">{t}</span>
            ))}
          </div>
        </div>

        <!-- Phone Mockup -->
        <div class="flex justify-center md:justify-end items-center h-full">
          <PhoneMockup client:visible />
        </div>
      </div>
    </div>

    <!-- Bottom fade to next section -->
    <div class="absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-t from-paper to-transparent"></div>
  </section>

  <!-- ── PROBLEM / SOLUTION ────────────────────────────────────── -->
  <section class="py-8 sm:py-16 px-5 sm:px-8 bg-paper">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-center gap-4 mb-8 sm:mb-12">
        <div class="h-px flex-1 bg-ink/20"></div>
        <span class="text-xs tracking-[0.4em] uppercase text-ink">Le problème</span>
        <div class="h-px flex-1 bg-ink/20"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <div class="border border-ink/30 p-8">
          <p class="text-xs tracking-[0.3em] uppercase text-ink mb-6">Carte tampon papier</p>
          <ul class="space-y-4">
            {problems.map(t => (
              <li class="flex items-start gap-3 text-base text-ink font-normal">
                <span class="text-ink mt-0.5 flex-shrink-0">—</span>
                {t}
              </li>
            ))}
          </ul>
        </div>

        <div class="border border-amber/50 bg-amber/3 p-8">
          <p class="text-xs tracking-[0.3em] uppercase text-amber mb-6">bonuskarte.digital</p>
          <ul class="space-y-4">
            {solutions.map(t => (
              <li class="flex items-start gap-3 text-base text-ink font-normal">
                <span class="text-amber mt-0.5 flex-shrink-0">◆</span>
                {t}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ── COMMENT ÇA MARCHE ─────────────────────────────────────── -->
  <section id="comment-ca-marche" class="py-8 sm:py-16 px-5 sm:px-8 bg-paper relative overflow-hidden">
    <div class="absolute inset-0 bg-grid-ink opacity-50"></div>
    <div class="relative max-w-6xl mx-auto">
      <div class="flex items-center gap-4 mb-6 sm:mb-10">
        <div class="h-px flex-1 bg-ink/20"></div>
        <span class="text-xs tracking-[0.4em] uppercase text-ink">Comment ça marche</span>
        <div class="h-px flex-1 bg-ink/20"></div>
      </div>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-5">
        {howItWorks.map(item => (
          <div class="group border border-ink/30 hover:border-amber/50 p-4 sm:p-7 transition-all">
            <div class="text-4xl font-black text-amber group-hover:text-amber transition-colors leading-none mb-3">{item.step}</div>
            <h3 class="font-semibold text-ink tracking-wide mb-1 text-sm">{item.title}</h3>
            <p class="text-ink text-sm leading-relaxed font-normal">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── SECTEURS ──────────────────────────────────────────────── -->
  <section id="secteurs" class="scroll-mt-20 py-8 sm:py-16 px-5 sm:px-8 bg-paper">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-center gap-4 mb-6 sm:mb-10">
        <div class="h-px flex-1 bg-ink/20"></div>
        <span class="text-xs tracking-[0.4em] uppercase text-ink">Secteurs disponibles</span>
        <div class="h-px flex-1 bg-ink/20"></div>
      </div>

      <p class="text-ink/40 text-sm font-normal text-center mb-10 max-w-xl mx-auto">
        Boulangeries, cafés, restaurants, coiffeurs, kebabs, pizzerias, glaciers, fleuristes, salles de sport, instituts de beauté — la carte de fidélité numérique s'adapte à chaque type de commerce.
      </p>

      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mb-10">
        {nicheTeaser.map(n => (
          <a href={`/fr/paris/1er/${n.slug}/`}
            class="group border border-ink/30 hover:border-amber hover:bg-amber/5 p-5 text-center transition-all hover:-translate-y-1">
            <div class="text-3xl mb-3 group-hover:scale-110 transition-transform">{n.emoji}</div>
            <div class="text-xs font-semibold tracking-widest uppercase text-ink group-hover:text-amber transition-colors">{n.label}</div>
          </a>
        ))}
      </div>

      <div class="text-center">
        <a href="/fr/paris/"
          class="group inline-flex items-center gap-2 border border-amber/50 hover:border-amber text-amber px-8 py-3 text-xs font-bold tracking-widest uppercase transition-all">
          Voir tous les secteurs à Paris
          <svg class="w-3 h-3 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ── TARIFS TEASER ─────────────────────────────────────────── -->
  <section class="py-8 sm:py-16 px-5 sm:px-8 bg-paper relative overflow-hidden">
    <div class="absolute inset-0 bg-grid-ink opacity-50"></div>
    <div class="relative max-w-3xl mx-auto text-center">
      <div class="flex items-center gap-4 mb-8">
        <div class="h-px flex-1 bg-ink/20"></div>
        <span class="text-xs tracking-[0.4em] uppercase text-ink">Tarifs</span>
        <div class="h-px flex-1 bg-ink/20"></div>
      </div>

      <p class="text-amber text-xs tracking-[0.4em] uppercase mb-4">Sans engagement</p>
      <h2 class="text-4xl sm:text-5xl font-normal text-ink tracking-tight mb-2">
        90 jours gratuits.
      </h2>
      <h2 class="text-4xl sm:text-5xl font-bold text-ink tracking-tight mb-8">
        Ensuite à partir de 29 €/mois.
      </h2>
      <p class="text-ink/40 text-sm font-normal mb-10 max-w-lg mx-auto">
        Cartes illimitées, notifications push, statistiques en temps réel — tout inclus. Sans frais d'installation. Résiliable chaque mois.
      </p>
      <a href="/fr/tarifs/"
        class="group inline-flex items-center gap-3 border border-amber/40 hover:border-amber text-amber px-8 py-4 text-xs font-bold tracking-widest uppercase transition-all">
        Voir les tarifs complets
        <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </section>

  <!-- ── FAQ ────────────────────────────────────────────────────── -->
  <section id="faq" class="scroll-mt-20 py-8 sm:py-16 px-5 sm:px-8 bg-paper">
    <div class="max-w-3xl mx-auto">
      <div class="flex items-center gap-4 mb-6 sm:mb-10">
        <div class="h-px flex-1 bg-ink/20"></div>
        <span class="text-xs tracking-[0.4em] uppercase text-ink">Questions fréquentes</span>
        <div class="h-px flex-1 bg-ink/20"></div>
      </div>

      <div class="space-y-4">
        {[
          {
            q: 'Les 90 jours sont vraiment gratuits ?',
            a: 'Oui, sans aucune condition. Pas de carte bancaire requise. Au bout de 90 jours, vous décidez si vous continuez — à partir de 29 €/mois, sans engagement, résiliable à tout moment.',
          },
          {
            q: 'Mes clients ont-ils besoin de télécharger une application ?',
            a: 'Non. La carte est enregistrée directement dans Apple Wallet ou Google Wallet, préinstallés sur tous les smartphones. Aucun compte, aucun téléchargement pour vos clients.',
          },
          {
            q: 'Combien de temps prend la mise en place ?',
            a: 'Vous remplissez un formulaire en 5 minutes. Nous créons votre carte avec votre logo et vos couleurs. Vous êtes opérationnel en moins de 24 heures.',
          },
          {
            q: 'Est-ce conforme au RGPD ?',
            a: 'Oui. Toutes les données sont traitées conformément au RGPD. Pas de cookies de suivi sur le téléphone de vos clients, pas de revente de données.',
          },
          {
            q: 'Ça fonctionne pour quel type de commerce ?',
            a: 'Boulangeries, cafés, restaurants, coiffeurs, kebabs, pizzerias, glaciers, fleuristes, salles de sport, instituts de beauté — et bien d\'autres. Si vous avez des clients réguliers, ça fonctionne pour vous.',
          },
          {
            q: 'Que se passe-t-il si mon client perd son téléphone ?',
            a: 'La carte est liée au compte Apple ou Google du client. Elle est automatiquement restaurée sur le nouvel appareil — les tampons et la progression sont conservés.',
          },
        ].map(faq => (
          <details class="group border border-ink/30 hover:border-amber/20 transition-colors">
            <summary class="flex items-center justify-between cursor-pointer p-5 sm:p-6">
              <span class="text-ink text-sm font-medium pr-4">{faq.q}</span>
              <svg class="w-4 h-4 text-amber flex-shrink-0 group-open:rotate-45 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
              </svg>
            </summary>
            <div class="px-5 sm:px-6 pb-5 sm:pb-6">
              <p class="text-ink text-sm leading-relaxed font-normal">{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ── FINAL CTA ─────────────────────────────────────────────── -->
  <section class="py-16 sm:py-28 px-5 sm:px-8 bg-paper border-t border-ink/30 relative overflow-hidden">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-amber rounded-full blur-[150px] opacity-5"></div>
    <div class="relative max-w-3xl mx-auto text-center">
      <p class="text-amber text-xs tracking-[0.4em] uppercase mb-6">90 jours gratuits</p>
      <h2 class="text-4xl sm:text-5xl font-normal text-ink tracking-tight mb-2">
        Prêt à fidéliser
      </h2>
      <h2 class="text-4xl sm:text-5xl font-bold text-ink tracking-tight mb-8">
        vos clients ?
      </h2>
      <p class="text-ink text-xs tracking-widest uppercase mb-10">Sans carte bancaire. Résiliable chaque mois. Zéro risque.</p>
      <a href="/fr/paris/"
        class="group inline-flex items-center gap-3 bg-amber hover:bg-amber-dark text-black px-10 py-5 text-xs font-bold tracking-[0.25em] uppercase transition-all">
        Commencer gratuitement
        <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>

      <!-- Trust row -->
      <div class="flex flex-wrap gap-6 mt-10 justify-center">
        {uiFr.trust.map(t => (
          <span class="text-[10px] tracking-widest uppercase text-ink/50">{t}</span>
        ))}
      </div>
    </div>
  </section>

  <FooterFr />
</BaseLayout>
