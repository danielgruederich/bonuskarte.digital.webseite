---
import BaseLayout from '../layouts/BaseLayout.astro'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'

// Video-URLs hier eintragen, sobald verfügbar
const VIDEO_1_URL = '' // Schritt 1: Karte aufs Smartphone laden
const VIDEO_2_URL = '' // Schritt 2: Stempel vergeben
const VIDEO_3_URL = '' // Schritt 3: Prämie einlösen

const operationsFaqs = [
  {
    q: 'Schaffen meine Mitarbeiter das an der Kasse?',
    a: 'Ja – und du musst es nicht mal selbst erklären. Wir zeigen alles in drei 90-Sekunden-Videos: Karte installieren, stempeln, Prämie einlösen. Mehr braucht dein Team nicht. Der Vorgang selbst dauert pro Gast rund 2 Sekunden: QR öffnen, ein Tipp, Punkt gebucht.',
  },
  {
    q: 'Wie wird mein Team eingearbeitet?',
    a: 'Gar kein Aufwand: Du bekommst drei kurze Schulungsvideos – jedes nur 1,5 Minuten lang. Eins zeigt, wie Kunden die Bonuskarte aufs Smartphone laden, eins, wie Stempel auf die Karte kommen, und eins, wie ihr Prämien einlöst. In Summe unter 5 Minuten, und dein Team ist startklar. Kein Handbuch, keine Schulung vor Ort.',
  },
  {
    q: 'Geht das auch in der Stoßzeit, wenn eine Schlange steht?',
    a: 'Genau dafür ist es gebaut. Ein Stempel dauert rund 2 Sekunden – schneller als eine Papierkarte rauskramen, Stempel suchen, draufdrücken. Die Karte ist immer beim Gast im Handy, es geht nichts verloren und niemand sucht.',
  },
  {
    q: 'Sind meine Gäste überhaupt technisch genug dafür?',
    a: 'Deine Gäste müssen nichts können außer einmal einen QR-Code scannen – das kennt heute jeder von der Speisekarte. Danach liegt die Karte automatisch in Apple oder Google Wallet, die auf jedem Smartphone schon installiert sind. Keine App, kein Account, kein Passwort.',
  },
  {
    q: 'Und meine älteren Stammgäste?',
    a: 'Auch die haben fast alle ein Smartphone mit Wallet drauf. Wer einmal die Karte gespeichert hat, muss nie wieder etwas tun – einfach Handy zeigen. Und für alle, die partout nicht wollen, läuft die Papierkarte einfach weiter daneben. Du verlierst niemanden.',
  },
  {
    q: 'Was, wenn ein Gast keine Wallet-Karte nutzen kann oder will?',
    a: 'Kein Problem – du zwingst niemanden. Erfahrungsgemäß steigen über 90 % freiwillig um, weil sie die Karte so nie mehr vergessen. Und für alle, bei denen es am Smartphone hakt: Wir schicken die Karte als QR-Code direkt per WhatsApp an den Kunden. So ist wirklich jeder dabei.',
  },
  {
    q: 'Wie kommen die Stempel überhaupt auf die Karte?',
    a: 'Ein Tipp auf den Stempel-Button – der Punkt landet sofort im Handy des Gastes. Wie es genau aussieht, zeigen wir in einem 90-Sekunden-Video. Einfacher als jeder Papierstempel.',
  },
  {
    q: 'Wie lösen meine Gäste ihre Prämie ein?',
    a: 'Ist das Ziel erreicht (z. B. 10 Stempel), zeigt der Gast die volle Karte, ihr bestätigt die Einlösung mit einem Tipp – fertig, die Karte setzt sich automatisch zurück. Auch das ist in einem kurzen Video erklärt.',
  },
  {
    q: 'Muss ich neue Hardware oder ein Kassensystem kaufen?',
    a: 'Nein. Es läuft auf dem Smartphone oder Tablet, das du schon hast – Browser auf, fertig. Keine Anschaffung, keine Installation, keine Verträge mit Hardware-Anbietern.',
  },
  {
    q: 'Was, wenn ein Mitarbeiter aus Versehen doppelt oder falsch stempelt?',
    a: 'Stempel lassen sich im Dashboard nachvollziehen und korrigieren. Du siehst jede Buchung – anders als bei Papier, wo ein verschenkter Stempel einfach weg ist. Mehr Kontrolle, nicht weniger.',
  },
  {
    q: 'Was passiert, wenn das Internet ausfällt?',
    a: 'Der Stempelvorgang braucht nur eine kurze Verbindung – die hat heute jedes Handy übers Mobilfunknetz, auch wenn dein WLAN streikt. Fällt mal alles aus, holst du den Stempel einfach beim nächsten Besuch nach.',
  },
]

const faqs = [
  {
    q: 'Was ist eine digitale Bonuskarte?',
    a: 'Eine digitale Bonuskarte ersetzt die Papier-Stempelkarte und landet direkt in Apple Wallet oder Google Wallet auf dem Smartphone des Kunden. Der Betreiber stempelt per QR-Code, der Kunde sieht seinen Fortschritt in Echtzeit. Kein Download, keine Registrierung, kein Papier das verloren geht.',
  },
  {
    q: 'Was ist der Unterschied zwischen einer digitalen Bonuskarte und einer digitalen Stempelkarte?',
    a: 'Beide Begriffe meinen dasselbe: eine Kundenkarte die Treue belohnt, digital statt auf Papier. "Stempelkarte" ist der geläufigere Begriff in der Gastronomie, "Bonuskarte" der übergeordnete Begriff. bonuskarte.digital bietet beides: klassische Stempelkarten, Punktekarten, Mitgliedskarten und Geschenkkarten, alle direkt in Apple Wallet oder Google Wallet.',
  },
  {
    q: 'Brauchen meine Kunden eine App?',
    a: 'Nein. Apple Wallet ist auf jedem iPhone vorinstalliert, Google Wallet auf jedem Android. Der Kunde scannt einmal einen QR-Code und speichert die Karte mit einem Klick. Kein Download, keine Passwörter, keine Registrierung.',
  },
  {
    q: 'Was kostet eine digitale Bonuskarte?',
    a: 'bonuskarte.digital bietet 90 Tage kostenlosen Test ohne Kreditkarte. Danach kostet das Solo-Paket 29 Euro pro Monat – bis zu 3 Standorte inklusive, das sind unter 1 Euro pro Tag, monatlich kündbar, keine Setup-Gebuehr. Kommt nur ein Gast pro Monat wegen der Karte einmal mehr, hat es sich schon bezahlt. Fuer Ketten mit 4 bis 10 Standorten gibt es das Ketten-Paket fuer 100 Euro pro Monat.',
  },
  {
    q: 'Wie schnell kann ich eine digitale Stempelkarte einrichten?',
    a: 'Die Einrichtung dauert unter 24 Stunden. Du fuellst ein kurzes Formular mit Firmenname, Logo und Stempelregel aus. bonuskarte.digital erstellt die Karte mit deinem Branding. Kein technisches Wissen noetig.',
  },
  {
    q: 'Gibt es eine digitale Bonuskarte fuer Doener-Imbisse?',
    a: 'Ja. bonuskarte.digital bietet eine fertige Stempelkarten-Vorlage speziell fuer Doener-Imbisse, mit anpassbarem Branding und automatischer Stempelregel. Kunden sammeln Stempel nach jedem Kauf und loesen ihre Belohnung direkt in Apple Wallet oder Google Wallet ein. Aktuell gibt es Stempelkarten fuer Cafes, Eisdielen, Doener, Pizza, Restaurants, Baeckereien, Friseursalons, Fitnessstudios, Yoga-Studios und Blumenlaeden.',
  },
  {
    q: 'Gibt es eine digitale Bonuskarte in Berlin, Hamburg oder anderen Staedten?',
    a: 'Ja. bonuskarte.digital ist in ganz Deutschland verfuegbar. Aktive Kunden gibt es in Koeln, Berlin, Hamburg, Muenchen, Frankfurt, Duesseldorf und weiteren Staedten. Das System laeuft vollstaendig digital, der Standort des Betriebs spielt keine Rolle.',
  },
  {
    q: 'Was ist der Unterschied zwischen bonuskarte.digital und Favecard oder anderen Anbieter?',
    a: 'bonuskarte.digital setzt auf Apple Wallet und Google Wallet statt einer eigenen App. Das bedeutet: keine Installations-Huerde fuer den Kunden, keine DSGVO-Probleme durch eigene App-Stores und direkter Zugang zu Push-Nachrichten ueber das Wallet-System. Der Preis beginnt bei 29 Euro pro Monat – unter 1 Euro pro Tag, ohne Setup-Gebuehr und mit 90 Tagen kostenlosem Test.',
  },
  {
    q: 'Ist eine digitale Bonuskarte DSGVO-konform?',
    a: 'Ja. Die Karte speichert keine persoenlichen Daten auf dem Geraet des Kunden. Es gibt keine Tracking-App, keine Cookies, keine E-Mail-Pflicht. Die Verarbeitung erfolgt DSGVO-konform. Kunden koennen die Karte jederzeit aus ihrem Wallet loeschen.',
  },
  {
    q: 'Kann ich Push-Nachrichten an meine Kunden senden?',
    a: 'Ja. Mit einer digitalen Bonuskarte in Apple Wallet oder Google Wallet kannst du Push-Nachrichten direkt auf das Sperrbildschirm-Display deiner Kunden senden. Zum Beispiel: Geburtstags-Glueckwunsch mit einer kostenlosen Kugel Eis, Ankuendigung einer Happy Hour oder ein Angebot wenn ein Kunde laenger nicht mehr da war. Push-Nachrichten sind in jedem Paket inklusive.',
  },
]
---

<BaseLayout
  title="FAQ: Digitale Bonuskarte & Stempelkarte erklaert – bonuskarte.digital"
  description="Alle Fragen zur digitalen Bonuskarte und Stempelkarte: Kosten, Einrichtung, Apple Wallet, DSGVO, Push-Nachrichten und mehr. Antworten in unter 2 Minuten."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [...operationsFaqs, ...faqs].map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "bonuskarte.digital", "item": "https://bonuskarte.digital/" },
      { "@type": "ListItem", "position": 2, "name": "FAQ" }
    ]
  })} />

  <Navbar ctaHref="/koeln" ctaLabel="Jetzt starten" />

  <!-- ── HEADER ──────────────────────────────────────────────────── -->
  <section class="bg-ink pt-28 pb-12 px-5 sm:px-8 border-b border-ink/30">
    <div class="max-w-2xl mx-auto">
      <nav class="flex items-center gap-1.5 text-xs text-ink/40 mb-8 tracking-wide">
        <a href="/" class="hover:text-ink/60 transition-colors">Home</a>
        <span>›</span>
        <span class="text-ink/60">FAQ</span>
      </nav>
      <div class="inline-flex items-center gap-3 border border-amber/50 px-4 py-2 mb-6">
        <span class="w-1 h-1 bg-amber animate-pulse-slow"></span>
        <span class="text-amber text-xs font-normal tracking-[0.3em] uppercase">Haeufige Fragen</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-normal text-ink tracking-tight mb-4">
        Alles ueber die digitale<br />
        <span class="font-bold text-amber">Bonuskarte.</span>
      </h1>
      <p class="text-ink/60 text-base leading-relaxed max-w-xl">
        Antworten auf die haeufigsten Fragen zu digitalen Stempelkarten, Bonuskarten und Kundenbindung fuer lokale Betriebe.
      </p>
    </div>
  </section>

  <!-- ── SCHULUNGSVIDEOS ─────────────────────────────────────────── -->
  <section class="bg-paper py-14 px-5 sm:px-8 border-b border-ink/10">
    <div class="max-w-3xl mx-auto">
      <p class="text-amber text-xs font-medium tracking-[0.3em] uppercase mb-2">In unter 5 Minuten startklar</p>
      <h2 class="text-3xl sm:text-4xl font-bold text-ink tracking-tight mb-2">So einfach geht's</h2>
      <p class="text-ink/60 text-base mb-10">Drei kurze Videos – je nur 90&nbsp;Sekunden. Mehr Handgriffe gibt es nicht.</p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        {[
          { url: VIDEO_1_URL, step: 'Schritt 1', title: 'Karte aufs Smartphone laden', len: '90 Sek. · für deine Kunden', label: 'Bonuskarte installieren' },
          { url: VIDEO_2_URL, step: 'Schritt 2', title: 'Stempel vergeben',            len: '90 Sek. · für dein Team',   label: 'Stempel vergeben' },
          { url: VIDEO_3_URL, step: 'Schritt 3', title: 'Prämie einlösen',             len: '90 Sek. · für dein Team',   label: 'Prämie einlösen' },
        ].map(v => (
          <div class="border border-ink/10 overflow-hidden">
            <div class="relative bg-ink" style="aspect-ratio:16/9">
              {v.url ? (
                <iframe
                  src={v.url}
                  title={v.label}
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                  class="absolute inset-0 w-full h-full border-0"
                />
              ) : (
                <div class="absolute inset-0 flex items-center justify-center">
                  <span class="text-ink/30 text-xs tracking-widest uppercase">Video folgt</span>
                </div>
              )}
            </div>
            <div class="p-4">
              <p class="text-amber text-xs font-bold tracking-[0.2em] uppercase mb-1">{v.step}</p>
              <h3 class="text-ink text-sm font-semibold mb-1">{v.title}</h3>
              <p class="text-ink/50 text-xs">{v.len}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── BETREIBER-FAQ ────────────────────────────────────────────── -->
  <section class="bg-paper py-14 px-5 sm:px-8 border-b border-ink/10">
    <div class="max-w-2xl mx-auto">
      <div class="flex items-center gap-4 mb-10">
        <div class="h-px flex-1 bg-ink/20"></div>
        <span class="text-xs tracking-[0.4em] uppercase text-ink">Als Inhaber</span>
        <div class="h-px flex-1 bg-ink/20"></div>
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold text-ink tracking-tight mb-8">Alles, was du dich als Inhaber fragst</h2>
      <div class="space-y-3">
        {operationsFaqs.map((faq, i) => (
          <details class="group border border-ink/10 hover:border-amber/20 transition-colors" open={i === 0}>
            <summary class="flex items-center justify-between cursor-pointer p-6">
              <span class="text-ink text-sm sm:text-base font-medium pr-4 leading-snug">{faq.q}</span>
              <svg class="w-4 h-4 text-amber flex-shrink-0 group-open:rotate-45 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
              </svg>
            </summary>
            <div class="px-6 pb-6">
              <p class="text-ink/70 text-sm leading-relaxed">{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ── ALLGEMEINE FAQ ───────────────────────────────────────────── -->
  <section class="bg-paper py-14 px-5 sm:px-8">
    <div class="max-w-2xl mx-auto">
      <div class="flex items-center gap-4 mb-10">
        <div class="h-px flex-1 bg-ink/20"></div>
        <span class="text-xs tracking-[0.4em] uppercase text-ink">Allgemeine Fragen</span>
        <div class="h-px flex-1 bg-ink/20"></div>
      </div>
      <div class="space-y-3">
      {faqs.map((faq, i) => (
        <details class="group border border-ink/10 hover:border-amber/20 transition-colors" open={i === 0}>
          <summary class="flex items-center justify-between cursor-pointer p-6">
            <h2 class="text-ink text-sm sm:text-base font-medium pr-4 leading-snug">{faq.q}</h2>
            <svg class="w-4 h-4 text-amber flex-shrink-0 group-open:rotate-45 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
          </summary>
          <div class="px-6 pb-6">
            <p class="text-ink/70 text-sm leading-relaxed">{faq.a}</p>
          </div>
        </details>
      ))}
      </div>
    </div>
  </section>

  <!-- ── CTA ────────────────────────────────────────────────────── -->
  <section class="bg-ink py-14 px-5 sm:px-8 border-t border-ink/30">
    <div class="max-w-2xl mx-auto text-center">
      <p class="text-amber text-xs tracking-[0.4em] uppercase mb-4">Kein Risiko</p>
      <h2 class="text-3xl sm:text-4xl font-normal text-ink tracking-tight mb-2">90 Tage gratis.</h2>
      <h2 class="text-3xl sm:text-4xl font-bold text-ink tracking-tight mb-8">Ueberzeugt dich selbst.</h2>
      <a href="/koeln" data-city-cta
        class="group inline-flex items-center gap-3 bg-amber hover:bg-amber-dark text-black px-10 py-5 text-sm font-bold tracking-[0.25em] uppercase transition-all">
        Jetzt kostenlos starten
        <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
      <p class="text-ink/30 text-xs mt-5">Keine Kreditkarte. Keine App. Live in 24h.</p>
    </div>
  </section>

  <Footer />
</BaseLayout>
