---
import CityNichePage from '../../../components/CityNichePage.astro'
import { stadtteile } from '../../../data/duesseldorf'
import { niches } from '../../../data/niches'

export function getStaticPaths() {
  return stadtteile.flatMap(s =>
    niches.map(n => ({
      params: { viertel: s.slug, niche: n.slug },
      props: { stadtteilData: s, nicheData: n },
    }))
  )
}

const { stadtteilData, nicheData } = Astro.props
---
<CityNichePage
  cityName="Düsseldorf"
  citySlug="duesseldorf"
  stadtteilData={stadtteilData}
  nicheData={nicheData}
/>
