---
import NicheLanding from '../../../components/NicheLanding.astro'
import { stadtteile } from '../../../data/duesseldorf'
import { niches } from '../../../data/niches'

export function getStaticPaths() {
  return stadtteile.flatMap(s =>
    niches.map(n => ({
      params: { viertel: s.slug, niche: n.slug },
      props: { stadtteilData: s, nicheData: n },
    }))
  )
}

const { stadtteilData, nicheData } = Astro.props
const fomoCount = stadtteilData.fomoCount[nicheData.fomoKey]
---
<NicheLanding
  cityName="Düsseldorf"
  citySlug="duesseldorf"
  locationName={stadtteilData.name}
  locationSlug={stadtteilData.slug}
  nicheData={nicheData}
  fomoCount={fomoCount}
/>
