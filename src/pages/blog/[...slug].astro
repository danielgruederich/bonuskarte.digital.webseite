---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Navbar from '../../components/Navbar.astro'
import Footer from '../../components/Footer.astro'

export async function getStaticPaths() {
  const posts = await getCollection('blog')
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content, headings } = await post.render()

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('de-DE', {
    day: 'numeric', month: 'long', year: 'numeric'
  }).format(date)
}

const categoryColors: Record<string, string> = {
  'Ratgeber':  'bg-gold-600/20 text-gold-400 border border-gold-600/30',
  'Strategie': 'bg-blue-900/30 text-blue-300 border border-blue-700/30',
  'How-to':    'bg-emerald-900/30 text-emerald-300 border border-emerald-700/30',
  'News':      'bg-white/10 text-white/60 border border-white/10',
}

// Related posts (same category, excluding current)
const allPosts = await getCollection('blog')
const related = allPosts
  .filter(p => p.slug !== post.slug && p.data.category === post.data.category)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3)

const h2Headings = headings.filter(h => h.depth === 2)
---

<BaseLayout
  title={`${post.data.title} – bonuskarte.digital Blog`}
  description={post.data.description}
  ogImage={post.data.heroImage}
>
  <Navbar dark={true} ctaHref="/#demo" />

  <!-- Article Header -->
  <header class="bg-black pt-28 pb-12 border-b border-white/5">
    <div class="max-w-4xl mx-auto px-5 sm:px-8">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-white/30 mb-8 tracking-wide">
        <a href="/" class="hover:text-white/60 transition-colors">Home</a>
        <span>›</span>
        <a href="/blog" class="hover:text-white/60 transition-colors">Blog</a>
        <span>›</span>
        <span class="text-white/50 truncate max-w-[200px]">{post.data.category}</span>
      </nav>

      <!-- Category + meta -->
      <div class="flex flex-wrap items-center gap-3 mb-6">
        <span class={`text-xs font-semibold tracking-wide uppercase px-2.5 py-1 rounded-sm ${categoryColors[post.data.category]}`}>
          {post.data.category}
        </span>
        <span class="text-white/25 text-xs">{post.data.readingTime} Min. Lesezeit</span>
        <span class="text-white/15 text-xs">·</span>
        <span class="text-white/25 text-xs">{formatDate(post.data.pubDate)}</span>
      </div>

      <!-- Title -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-white leading-tight tracking-tight mb-6">
        {post.data.title}
      </h1>

      <!-- Description -->
      <p class="text-white/50 text-lg leading-relaxed max-w-2xl">
        {post.data.description}
      </p>
    </div>
  </header>

  <!-- Hero Image -->
  <div class="bg-black">
    <div class="max-w-4xl mx-auto px-5 sm:px-8 pt-8">
      <div class="relative overflow-hidden aspect-[2/1]">
        <img
          src={post.data.heroImage}
          alt={post.data.title}
          class="w-full h-full object-cover"
          loading="eager"
        />
      </div>
    </div>
  </div>

  <!-- Article Body -->
  <div class="bg-white py-12 sm:py-16">
    <div class="max-w-4xl mx-auto px-5 sm:px-8">
      <div class="grid lg:grid-cols-[1fr_260px] gap-12 items-start">

        <!-- Main Content -->
        <article class="article-body min-w-0">
          <Content />
        </article>

        <!-- Sidebar: TOC + CTA -->
        <aside class="hidden lg:block">
          <div class="sticky top-24 space-y-6">

            <!-- Table of Contents -->
            {h2Headings.length > 1 && (
              <div class="border border-gray-100 p-5">
                <div class="text-xs font-bold tracking-[0.2em] uppercase text-black mb-4">Inhalt</div>
                <nav class="space-y-1">
                  {h2Headings.map(h => (
                    <a
                      href={`#${h.slug}`}
                      class="block text-sm text-gray-500 hover:text-black py-1 pl-3 border-l-2 border-transparent hover:border-gold-600 transition-all leading-snug"
                    >
                      {h.text}
                    </a>
                  ))}
                </nav>
              </div>
            )}

            <!-- Sidebar CTA -->
            <div class="bg-black p-6">
              <div class="text-xs font-bold tracking-[0.2em] uppercase text-gold-600 mb-3">Kostenlos starten</div>
              <p class="text-white/60 text-sm leading-relaxed mb-5">
                90 Tage gratis. Keine Kreditkarte. Keine App nötig.
              </p>
              <a
                href="/#demo"
                class="block text-center bg-gold-600 hover:bg-gold-500 text-black font-bold text-xs tracking-widest uppercase px-4 py-3 transition-colors"
              >
                Jetzt starten →
              </a>
            </div>

          </div>
        </aside>

      </div>
    </div>
  </div>

  <!-- Mobile CTA -->
  <div class="bg-black lg:hidden py-10 border-t border-white/5">
    <div class="max-w-4xl mx-auto px-5 sm:px-8 text-center">
      <p class="text-white/50 text-sm mb-4">90 Tage gratis – keine Kreditkarte nötig</p>
      <a href="/#demo" class="inline-flex items-center gap-2 bg-gold-600 hover:bg-gold-500 text-black font-bold text-xs tracking-widest uppercase px-6 py-3 transition-colors">
        Jetzt kostenlos starten →
      </a>
    </div>
  </div>

  <!-- Related Posts -->
  {related.length > 0 && (
    <section class="bg-black py-16 border-t border-white/5">
      <div class="max-w-4xl mx-auto px-5 sm:px-8">
        <div class="flex items-center gap-4 mb-10">
          <h2 class="text-xs font-bold tracking-[0.3em] uppercase text-white/40">Weitere Artikel</h2>
          <div class="flex-1 h-px bg-white/5"></div>
          <a href="/blog" class="text-xs text-gold-600 hover:text-gold-500 tracking-widest uppercase transition-colors">Alle →</a>
        </div>
        <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-px bg-white/5">
          {related.map(p => (
            <a href={`/blog/${p.slug}`} class="group bg-black hover:bg-ink-900 transition-colors p-6 flex flex-col">
              <div class="overflow-hidden aspect-video mb-4">
                <img src={p.data.heroImage} alt={p.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
              </div>
              <span class="text-gold-600/70 text-xs font-medium tracking-wide uppercase mb-2">{p.data.category}</span>
              <h3 class="text-sm font-semibold text-white leading-snug group-hover:text-gold-400 transition-colors">
                {p.data.title}
              </h3>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <Footer />
</BaseLayout>

<style is:global>
  /* ── Article body typography ── */
  .article-body h2 {
    font-size: 1.375rem;
    font-weight: 800;
    color: #000;
    margin-top: 2.75rem;
    margin-bottom: 0.875rem;
    padding-bottom: 0.625rem;
    border-bottom: 1px solid #f0f0f0;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .article-body h3 {
    font-size: 1.125rem;
    font-weight: 700;
    color: #111;
    margin-top: 2rem;
    margin-bottom: 0.625rem;
    line-height: 1.4;
  }
  .article-body p {
    font-size: 1rem;
    line-height: 1.8;
    color: #374151;
    margin-bottom: 1.25rem;
  }
  .article-body ul {
    margin-bottom: 1.5rem;
    padding-left: 0;
    list-style: none;
  }
  .article-body ul li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.5rem;
    line-height: 1.75;
    color: #374151;
    font-size: 1rem;
  }
  .article-body ul li::before {
    content: '→';
    color: #8B7300;
    position: absolute;
    left: 0;
    font-weight: 700;
  }
  .article-body ol {
    list-style: decimal;
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .article-body ol li {
    margin-bottom: 0.5rem;
    line-height: 1.75;
    color: #374151;
    font-size: 1rem;
  }
  .article-body blockquote {
    border-left: 3px solid #8B7300;
    padding: 1rem 1.25rem;
    margin: 1.75rem 0;
    background: #fdfbf0;
    font-style: italic;
    color: #4B5563;
  }
  .article-body blockquote p {
    margin-bottom: 0;
  }
  .article-body strong {
    font-weight: 700;
    color: #111;
  }
  .article-body a {
    color: #8B7300;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .article-body a:hover {
    color: #6e5c00;
  }
  .article-body table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.75rem 0;
    font-size: 0.875rem;
    overflow-x: auto;
    display: block;
  }
  .article-body thead th {
    background: #000;
    color: #fff;
    text-align: left;
    padding: 0.75rem 1rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    font-size: 0.8rem;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .article-body tbody tr {
    border-bottom: 1px solid #f0f0f0;
  }
  .article-body tbody tr:hover {
    background: #fafafa;
  }
  .article-body tbody td {
    padding: 0.75rem 1rem;
    color: #374151;
    vertical-align: top;
  }
  .article-body hr {
    border: none;
    border-top: 1px solid #e5e7eb;
    margin: 2.5rem 0;
  }
  .article-body code {
    background: #f3f4f6;
    padding: 0.125rem 0.375rem;
    border-radius: 3px;
    font-size: 0.875em;
    font-family: 'Fira Code', 'Consolas', monospace;
    color: #111;
  }
</style>
