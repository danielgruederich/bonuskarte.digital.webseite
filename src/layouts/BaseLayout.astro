---
interface Props {
  title: string
  description: string
  ogImage?: string
}

const { title, description, ogImage } = Astro.props
const canonicalUrl = new URL(Astro.url.pathname, 'https://bonuskarte.digital').href
const ogImageUrl   = new URL(ogImage ?? '/og-default.png', 'https://bonuskarte.digital').href
---
<!doctype html>
<html lang="de" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="bonuskarte.digital" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <style>@import '../styles/fonts.css';</style>
    <title>{title}</title>

    <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-VMZHH4WN6R"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-VMZHH4WN6R', {
        anonymize_ip: true
      });
      gtag('config', 'AW-18176373682'); // Google Ads
    </script>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "bonuskarte.digital",
      "url": "https://bonuskarte.digital",
      "telephone": "+491737130733",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Sülzburgstrasse 234",
        "addressLocality": "Köln",
        "postalCode": "50937",
        "addressCountry": "DE"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 50.9193,
        "longitude": 6.9430
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
          "opens": "09:00",
          "closes": "18:00"
        }
      ],
      "areaServed": ["Köln", "Berlin", "Düsseldorf", "Bonn", "Hürth"],
      "description": "Digitale Stempelkarten für Apple Wallet & Google Wallet. Kein App-Download, kein Aufwand."
    }
    </script>
  </head>
  <body class="bg-white text-gray-900 antialiased">
    <slot />
  </body>
</html>
