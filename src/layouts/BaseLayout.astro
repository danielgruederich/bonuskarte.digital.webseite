---
interface Props {
  title: string
  description: string
  ogImage?: string
  lang?: 'de' | 'fr'
  locale?: string                                     // 'de_DE' | 'fr_FR'
  alternates?: { hreflang: string; href: string }[]   // hreflang pairs; default empty
  noindex?: boolean                                   // when true, emit <meta robots="noindex,follow">
  showStickyCta?: boolean                             // sticky mobile CTA bar (default true)
}

import Zipchat from '../components/integrations/Zipchat.astro'

const { title, description, ogImage, lang = 'de', locale = 'de_DE', alternates = [], noindex = false, showStickyCta = true } = Astro.props
const canonicalUrl = new URL(Astro.url.pathname, 'https://bonuskarte.digital').href
const ogImageUrl   = new URL(ogImage ?? '/screens/phone-1.jpg', 'https://bonuskarte.digital').href
---
<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalUrl} />
    {alternates.map(a => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale} />
    <meta property="og:site_name" content="bonuskarte.digital" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/png/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/brand/png/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="128x128" href="/brand/png/favicon-128.png" />
    <link rel="preload" href="/fonts/GeistVF.woff2" as="font" type="font/woff2" crossorigin />
    <style>@import '../styles/fonts.css';</style>
    <title>{title}</title>

    <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-HFS45SFQ8S"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HFS45SFQ8S', {
        anonymize_ip: true
      });
      gtag('config', 'AW-18176373682'); // Google Ads
    </script>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "bonuskarte.digital",
      "url": "https://bonuskarte.digital",
      "telephone": "+491737130733",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Sülzburgstrasse 234",
        "addressLocality": "Köln",
        "postalCode": "50937",
        "addressCountry": "DE"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 50.9193,
        "longitude": 6.9430
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
          "opens": "09:00",
          "closes": "18:00"
        }
      ],
      "areaServed": ["Köln", "Berlin", "Düsseldorf", "Bonn", "Hürth"],
      "description": "Digitale Stempelkarten für Apple Wallet & Google Wallet. Kein App-Download, kein Aufwand."
    }
    </script>
  </head>
  <body class="bg-paper text-ink antialiased">
    <slot />
    <Zipchat />

    {showStickyCta && (
      <div
        id="sticky-cta"
        class="fixed bottom-0 left-0 right-0 z-40 lg:hidden bg-paper border-t border-ink/20 px-4 py-3 flex items-center gap-3 shadow-[0_-4px_20px_rgba(0,0,0,0.07)] translate-y-full transition-transform duration-300"
        aria-hidden="true"
      >
        <div class="flex-1 min-w-0">
          <p class="text-ink text-xs font-semibold leading-tight">3 Felder, 2 Minuten –</p>
          <p class="text-ink/50 text-xs leading-tight">wir machen den Rest.</p>
        </div>
        <a
          href="/koeln"
          data-city-cta
          class="flex-shrink-0 inline-flex items-center gap-2 bg-amber hover:bg-amber-dark text-black px-5 py-3 text-xs font-bold tracking-[0.15em] uppercase transition-colors"
        >
          Kostenlos testen
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    )}

    <script>
      ;(function () {
        const CITIES = ['berlin','hamburg','duesseldorf','muenchen','frankfurt','koeln','bonn','essen','hannover','dortmund','dresden','nuernberg','leipzig','stuttgart','huerth']
        const city = window.location.pathname.split('/')[1]
        if (CITIES.includes(city)) sessionStorage.setItem('bkCity', city)

        const detected = sessionStorage.getItem('bkCity') || 'koeln'
        document.querySelectorAll('[data-city-cta]').forEach(function (el) {
          el.setAttribute('href', '/' + detected)
        })

        // Sticky CTA: einblenden nach 300px Scroll
        const sticky = document.getElementById('sticky-cta')
        if (sticky) {
          sticky.setAttribute('aria-hidden', 'true')
          window.addEventListener('scroll', function () {
            if (window.scrollY > 300) {
              sticky.classList.remove('translate-y-full')
              sticky.setAttribute('aria-hidden', 'false')
            } else {
              sticky.classList.add('translate-y-full')
              sticky.setAttribute('aria-hidden', 'true')
            }
          }, { passive: true })
        }
      })()
    </script>
  </body>
</html>
