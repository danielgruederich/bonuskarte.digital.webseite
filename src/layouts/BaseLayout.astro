---
interface Props {
  title: string
  description: string
  ogImage?: string
  lang?: 'de' | 'fr'
  locale?: string                                     // 'de_DE' | 'fr_FR'
  alternates?: { hreflang: string; href: string }[]   // hreflang pairs; default empty
  noindex?: boolean                                   // when true, emit <meta robots="noindex,follow">
}

import Zipchat from '../components/integrations/Zipchat.astro'

const { title, description, ogImage, lang = 'de', locale = 'de_DE', alternates = [], noindex = false } = Astro.props
const canonicalUrl = new URL(Astro.url.pathname, 'https://bonuskarte.digital').href
const ogImageUrl   = new URL(ogImage ?? '/screens/phone-1.jpg', 'https://bonuskarte.digital').href
---
<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalUrl} />
    {alternates.map(a => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale} />
    <meta property="og:site_name" content="bonuskarte.digital" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/GeistVF.woff2" as="font" type="font/woff2" crossorigin />
    <style>@import '../styles/fonts.css';</style>
    <title>{title}</title>

    <!-- Google Analytics 4 -->
    <!-- is:inline ist PFLICHT: ohne bündelt Astro das Script als ES-Modul und
         `gtag` ist nie global — kein Funnel-Event und keine Ads-Conversion
         würde feuern (typeof gtag === 'undefined' in analytics.ts). -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HFS45SFQ8S"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', 'G-HFS45SFQ8S', {
        anonymize_ip: true
      });
      gtag('config', 'AW-18176373682'); // Google Ads
    </script>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "bonuskarte.digital",
      "url": "https://bonuskarte.digital",
      "telephone": "+491737130733",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Sülzburgstrasse 234",
        "addressLocality": "Köln",
        "postalCode": "50937",
        "addressCountry": "DE"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 50.9193,
        "longitude": 6.9430
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
          "opens": "09:00",
          "closes": "18:00"
        }
      ],
      "areaServed": ["Köln", "Berlin", "Düsseldorf", "Bonn", "Hürth"],
      "description": "Digitale Stempelkarten für Apple Wallet & Google Wallet. Kein App-Download, kein Aufwand."
    }
    </script>
  </head>
  <body class="bg-paper text-ink antialiased">
    <slot />
    <Zipchat />
  </body>
</html>
