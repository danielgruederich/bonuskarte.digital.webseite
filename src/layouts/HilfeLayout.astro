---
import BaseLayout from './BaseLayout.astro'
import Navbar from '@/components/Navbar.astro'
import NavbarFr from '@/components/NavbarFr.astro'
import NavbarEn from '@/components/NavbarEn.astro'
import Footer from '@/components/Footer.astro'
import FooterFr from '@/components/FooterFr.astro'
import FooterEn from '@/components/FooterEn.astro'
import HilfeSidebar from '@/components/hilfe/HilfeSidebar.astro'
import HilfeSidebarMobile from '@/components/hilfe/HilfeSidebarMobile.astro'
import PrevNext from '@/components/hilfe/PrevNext.astro'
import { getCategoryFromSlug, getCategoryLabel, stripLang, hilfeBase, HILFE_UI, type Lang } from '@/data/hilfe-categories'

interface Props {
  title: string
  description: string
  slug: string
  lang?: Lang
}

const { title, description, slug, lang = 'de' } = Astro.props
const categorySlug = getCategoryFromSlug(slug)
const categoryLabel = getCategoryLabel(categorySlug, lang)

const base = hilfeBase(lang)
const ui = HILFE_UI[lang]
const articleUrl = `https://bonuskarte.digital${base}/${stripLang(slug)}`

// Every help article exists in all three languages under the same slug, so the
// language pairs can be derived — one entry per language plus x-default on DE.
const pureSlug = stripLang(slug)
const alternates = [
  { hreflang: 'de', href: `https://bonuskarte.digital/hilfe/${pureSlug}/` },
  { hreflang: 'en', href: `https://bonuskarte.digital/en/help/${pureSlug}/` },
  { hreflang: 'fr', href: `https://bonuskarte.digital/fr/aide/${pureSlug}/` },
  { hreflang: 'x-default', href: `https://bonuskarte.digital/hilfe/${pureSlug}/` },
]

// Localized title suffix + html lang/locale
const titleSuffix = lang === 'fr' ? 'Aide' : lang === 'en' ? 'Help' : 'Hilfe'
const htmlLocale = lang === 'fr' ? 'fr_FR' : lang === 'en' ? 'en_US' : 'de_DE'
---

<BaseLayout
  title={`${title} — ${titleSuffix} | bonuskarte.digital`}
  description={description}
  lang={lang}
  locale={htmlLocale}
  alternates={alternates}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": title,
    "description": description,
    "url": articleUrl,
    "publisher": {
      "@type": "Organization",
      "name": "bonuskarte.digital",
      "url": "https://bonuskarte.digital"
    }
  })} />
  {lang === 'fr' ? (
    <NavbarFr ctaHref={`${base}/`} ctaLabel={ui.navLabel} />
  ) : lang === 'en' ? (
    <NavbarEn ctaHref={`${base}/`} ctaLabel={ui.navLabel} />
  ) : (
    <Navbar ctaHref={`${base}/`} ctaLabel={ui.navLabel} />
  )}

  <main class="min-h-screen bg-ink pt-24 pb-16">
    <div class="max-w-6xl mx-auto px-5 sm:px-8">

      <!-- Breadcrumb -->
      <nav class="mb-8 text-xs text-paper/40">
        <a href={`${base}/`} class="hover:text-amber transition-colors">{ui.breadcrumb}</a>
        <span class="mx-2">/</span>
        <span class="hover:text-amber transition-colors">{categoryLabel}</span>
        <span class="mx-2">/</span>
        <span class="text-paper/60">{title}</span>
      </nav>

      <div class="flex gap-12">
        <!-- Sidebar (desktop) -->
        <HilfeSidebar currentSlug={slug} lang={lang} />

        <!-- Content -->
        <article class="flex-1 min-w-0">
          <!-- Mobile sidebar -->
          <HilfeSidebarMobile currentSlug={slug} lang={lang} />

          <h1 class="text-3xl sm:text-4xl font-bold text-paper mb-8">{title}</h1>

          <div class="prose max-w-none text-paper
            prose-headings:!text-paper prose-headings:font-bold prose-headings:tracking-tight
            prose-h2:text-xl prose-h2:mt-10 prose-h2:mb-4
            prose-h3:text-lg prose-h3:mt-8 prose-h3:mb-3
            prose-p:!text-paper/90 prose-p:leading-relaxed
            prose-li:!text-paper/90
            prose-strong:!text-paper
            prose-a:!text-amber prose-a:no-underline hover:prose-a:underline
            prose-code:!text-amber prose-code:bg-white/5 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded
            prose-ol:list-decimal prose-ul:list-disc
            prose-table:text-sm prose-th:!text-paper/80 prose-td:!text-paper/90
          ">
            <slot />
          </div>

          <PrevNext currentSlug={slug} lang={lang} />
        </article>
      </div>
    </div>
  </main>

  {lang === 'fr' ? (
    <FooterFr />
  ) : lang === 'en' ? (
    <FooterEn />
  ) : (
    <Footer />
  )}
</BaseLayout>
