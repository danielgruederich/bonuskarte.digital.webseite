---
/**
 * Gemeinsames Landing-Page-Template für alle Städte außer Köln
 * (Köln hat mit /koeln/[veedel]/[niche].astro eine eigene Variante mit Veedel-Content).
 *
 * Bündelt alle Funnel-Bausteine an einem Ort:
 * Formular direkt im Hero, WhatsApp-CTA, Termin-Link, FAQ + Schema.org,
 * Offer-CTA, Sticky-Mobile-CTA.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import Navbar from './Navbar.astro'
import Footer from './Footer.astro'
import WalletMockup from './WalletMockup.astro'
import LeadForm from './LeadForm.tsx'
import LeadFormDoener from './LeadFormDoener.tsx'
import LandingFaq from './LandingFaq.astro'
import StickyMobileCta from './StickyMobileCta.astro'
import Icon from './icons/TrustIcons.astro'
import type { NicheData } from '../data/niches'
import { inStadtteil, InStadtteil } from '../lib/stadtteil-grammatik'
import { getPremiumContent } from '../data/city-content'
import { hasUniqueContent } from '../lib/indexability'

interface StadtteilLike {
  name: string
  slug: string
  fomoCount: Record<string, number>
}

interface Props {
  cityName: string
  citySlug: string
  stadtteilData: StadtteilLike
  nicheData: NicheData
}

const { cityName, citySlug, stadtteilData, nicheData } = Astro.props

const emojiToIcon: Record<string, string> = {
  '📱': 'smartphone', '🔔': 'bell', '📊': 'chart', '🔥': 'flame',
  '📣': 'megaphone', '🍕': 'pizza', '🍦': 'ice-cream', '🤝': 'handshake',
  '⚡': 'zap', '🔒': 'shield',
}

const whatsappUrl = 'https://wa.me/491705594140'
const GASTRO_NICHES = ['doener', 'pizza', 'restaurant', 'eiscafe']
const bookingType = nicheData.slug === 'cafes'
  ? 'barista'
  : GASTRO_NICHES.includes(nicheData.slug) ? 'gastro' : '15min'
const bookingUrl = `https://termin.bonuskarte.digital/${bookingType}`

// Templated Strings zur Buildzeit auflösen; SEO-Texte sind auf Köln verfasst → Stadtname tauschen.
// "in {veedelName}" wird als Ortsangabe mit korrektem Artikel aufgelöst
// ("in Nippes", aber "in der Innenstadt/Altstadt", "im Zentrum").
const r = (s: string) =>
  s.replace(/\bin \{veedelName\}/g, inStadtteil(stadtteilData.name))
   .replace(/\bIn \{veedelName\}/g, InStadtteil(stadtteilData.name))
   .replace(/\{veedelName\}/g, stadtteilData.name)
   .replace(/\{fomoCount\}/g, String(stadtteilData.fomoCount[nicheData.fomoKey]))

const fomoCount = stadtteilData.fomoCount[nicheData.fomoKey]
const showFomo  = fomoCount > 0
const pageUrl   = `https://bonuskarte.digital/${citySlug}/${stadtteilData.slug}/${nicheData.slug}`

// Premium-SEO-Content (einzigartig pro Stadt × Viertel × Nische), falls vorhanden.
// Überschreibt Meta-Title/Description und rendert Langform-Body + eigene FAQ.
const premium = getPremiumContent(citySlug, nicheData.slug, stadtteilData.slug)
const metaTitle = premium?.metaTitle ?? r(nicheData.seoTitle).replace('Köln', cityName)
const metaDescription = premium?.metaDescription ?? r(nicheData.seoDescription).replace('Köln', cityName)

// Ohne eigenen Inhalt: nicht indexieren (Regel siehe src/lib/indexability.ts).
// Die Seite bleibt für Besucher, Ads und Direktzugriffe voll funktionsfähig.
const indexable = hasUniqueContent(citySlug, stadtteilData.slug, nicheData.slug)
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  noindex={!indexable}
  showStickyCta={false}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "bonuskarte.digital", "item": "https://bonuskarte.digital/" },
      { "@type": "ListItem", "position": 2, "name": cityName, "item": `https://bonuskarte.digital/${citySlug}/` },
      { "@type": "ListItem", "position": 3, "name": stadtteilData.name, "item": `https://bonuskarte.digital/${citySlug}/${stadtteilData.slug}/` },
      { "@type": "ListItem", "position": 4, "name": `${nicheData.label} ${inStadtteil(stadtteilData.name)}` }
    ]
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": `Digitale ${nicheData.cardType} für ${nicheData.label} ${inStadtteil(stadtteilData.name)}`,
    "description": r(nicheData.seoDescription).replace('Köln', cityName),
    "url": pageUrl,
    "provider": {
      "@type": "Organization",
      "name": "bonuskarte.digital",
      "url": "https://bonuskarte.digital"
    },
    "areaServed": {
      "@type": "Place",
      "name": `${stadtteilData.name}, ${cityName}`
    },
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "EUR",
      "description": "90 Tage kostenlos testen – keine Kreditkarte, monatlich kündbar"
    }
  })} />
  <Navbar ctaHref="#demo" ctaLabel={nicheData.heroCopy.ctaLabel} />

  <!-- ── HERO ─────────────────────────────────────────────────── -->
  <section class="relative min-h-screen flex items-center bg-paper overflow-hidden">
    <div class="absolute inset-0 bg-grid-ink"></div>
    <div class="absolute top-1/2 -right-40 w-[600px] h-[600px] bg-amber rounded-full blur-[200px] opacity-5"></div>

    <div class="relative max-w-6xl mx-auto px-5 sm:px-8 pt-20 pb-12 grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-12 items-center w-full">
      <div>
        <div class="inline-flex items-center gap-3 border border-amber/50 px-4 py-2 mb-8">
          <span class="w-1 h-1 bg-amber animate-pulse-slow"></span>
          <span class="text-amber text-xs font-normal tracking-[0.3em] uppercase">
            {cityName} · {stadtteilData.name}
          </span>
        </div>

        <h1 class="text-5xl sm:text-6xl leading-[1.1] tracking-tight mb-8">
          <span class="font-normal text-ink block mb-2">{nicheData.heroCopy.headlineLight}</span>
          <span class="font-bold text-amber block">{r(nicheData.heroCopy.headlineBold)}</span>
        </h1>

        {showFomo && (
          <div class="flex items-center gap-3 border border-amber/20 bg-amber/5 px-4 py-2.5 mb-6">
            <Icon name="diamond" class="w-4 h-4 text-amber shrink-0" />
            <span class="text-amber text-xs tracking-[0.1em] font-normal">{r(nicheData.heroCopy.fomoText)}</span>
          </div>
        )}

        <p class="text-ink text-base leading-relaxed mb-6 max-w-md font-normal">
          {r(nicheData.heroCopy.bodyText)}
        </p>

        <div class="inline-flex items-center gap-3 border border-amber/50 bg-amber/5 px-4 py-2.5 mb-6">
          <Icon name="diamond" class="w-4 h-4 text-amber shrink-0" />
          <span class="text-amber text-xs tracking-[0.15em] font-normal">
            90 TAGE KOMPLETT KOSTENLOS — KEIN KNEBELVERTRAG
          </span>
        </div>

        <div class="flex flex-col sm:flex-row gap-3">
          <a href="#demo"
            class="group inline-flex items-center justify-center gap-3 bg-amber hover:bg-amber-dark text-black px-8 py-4 text-sm font-bold tracking-[0.2em] uppercase transition-all">
            {nicheData.heroCopy.ctaLabel}
            <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer"
            onclick="if(typeof gtag!=='undefined')gtag('event','whatsapp_clicked',{location:'hero'})"
            class="group inline-flex items-center justify-center gap-3 border border-ink/10 hover:border-[#25D366]/50 text-ink hover:text-ink px-8 py-4 text-xs font-medium tracking-[0.2em] uppercase transition-all">
            <svg class="w-4 h-4 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Per WhatsApp anfragen
          </a>
        </div>
        <a href={bookingUrl}
          target="_blank"
          rel="noopener noreferrer"
          onclick="if(typeof gtag!=='undefined')gtag('event','demo_booking',{source:'hero'})"
          class="mt-3 inline-flex items-center justify-center gap-3 w-full sm:w-auto border border-amber/60 bg-amber/5 hover:bg-amber/15 text-ink px-8 py-3.5 text-xs font-bold tracking-[0.2em] uppercase transition-all">
          <svg class="w-4 h-4 text-amber" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          Erst informieren? Termin buchen
        </a>

        <div class="flex flex-wrap gap-5 mt-10">
          <span class="inline-flex items-center gap-2 text-xs tracking-wider uppercase text-ink font-normal">
            <Icon name="shield" class="w-4 h-4 text-amber" /> DSGVO
          </span>
          <span class="inline-flex items-center gap-2 text-xs tracking-wider uppercase text-ink font-normal">
            <Icon name="wallet" class="w-4 h-4 text-amber" /> Apple & Google Wallet
          </span>
          <span class="inline-flex items-center gap-2 text-xs tracking-wider uppercase text-ink font-normal">
            <Icon name="zap" class="w-4 h-4 text-amber" /> Live in 24h
          </span>
          <span class="inline-flex items-center gap-2 text-xs tracking-wider uppercase text-ink font-normal">
            <Icon name="check-circle" class="w-4 h-4 text-amber" /> Kein Abo
          </span>
        </div>
      </div>

      <div class="flex flex-col gap-6 items-center md:items-end">
        {nicheData.formType === 'simple' ? (
          <WalletMockup
            businessName={nicheData.walletMockup.businessName}
            reward={nicheData.walletMockup.reward}
            stamped={nicheData.walletMockup.stamped}
            total={nicheData.walletMockup.total}
          />
        ) : (
          <>
            <div class="scale-75 origin-top hidden md:block">
              <WalletMockup
                businessName={nicheData.walletMockup.businessName}
                reward={nicheData.walletMockup.reward}
                stamped={nicheData.walletMockup.stamped}
                total={nicheData.walletMockup.total}
              />
            </div>
            <div id="demo" class="w-full border border-amber/20 bg-paper p-6 sm:p-8">
              <LeadForm
                client:load
                niche={nicheData.label}
                city={cityName}
                whatsappUrl={whatsappUrl}
                bookingUrl={bookingUrl}
                bookingType={bookingType}
              />
            </div>
          </>
        )}
      </div>
    </div>

    <div class="absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-t from-paper to-transparent"></div>
  </section>

  <!-- ── ARGUMENTS ─────────────────────────────────────────────── -->
  <section class="py-12 sm:py-16 px-5 sm:px-8 bg-paper">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-center gap-4 mb-14">
        <div class="h-px flex-1 bg-ink/20"></div>
        <span class="text-xs tracking-[0.4em] uppercase text-ink">Der Vorteil</span>
        <div class="h-px flex-1 bg-ink/20"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {nicheData.arguments.map(a => (
          <div class="group border border-ink/30 hover:border-amber/50 p-8 transition-all">
            <div class="mb-5 group-hover:scale-110 transition-transform inline-block text-amber">
              {emojiToIcon[a.icon] ? (
                <Icon name={emojiToIcon[a.icon]} class="w-8 h-8" />
              ) : (
                <span class="text-4xl">{a.icon}</span>
              )}
            </div>
            <h3 class="font-bold text-ink text-lg mb-3">{a.title}</h3>
            <p class="text-ink text-base leading-relaxed font-normal">{a.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── SEO-LANGFORM-CONTENT (Premium, einzigartig pro Ort × Nische) ─ -->
  {premium && (
    <section class="py-12 sm:py-16 px-5 sm:px-8 bg-paper border-t border-ink/10">
      <div class="max-w-3xl mx-auto">
        <div
          class="seo-prose text-ink"
          set:html={premium.bodyHtml}
        />
      </div>
    </section>
  )}

  <!-- ── OFFER ─────────────────────────────────────────────────── -->
  <section class="py-12 sm:py-16 px-5 sm:px-8 bg-paper relative overflow-hidden">
    <div class="absolute inset-0 bg-grid-ink opacity-50"></div>
    <div class="relative max-w-3xl mx-auto text-center">
      <div class="flex items-center gap-4 mb-10">
        <div class="h-px flex-1 bg-ink/20"></div>
        <span class="text-xs tracking-[0.4em] uppercase text-ink">Das Angebot</span>
        <div class="h-px flex-1 bg-ink/20"></div>
      </div>
      <h2 class="text-4xl sm:text-5xl font-normal text-ink tracking-tight mb-2">90 Tage Test.</h2>
      <h2 class="text-4xl sm:text-5xl font-bold text-amber tracking-tight mb-10">0€ Risiko.</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {[
          { n: '0€', label: 'Setup-Gebühr',  sub: 'Komplett kostenlos starten' },
          { n: '90', label: 'Tage gratis',   sub: 'Kein Risiko, kein Druck'    },
          { n: '∞',  label: 'Stammkunden',   sub: 'Die immer wiederkommen'     },
        ].map(stat => (
          <div class="border border-amber/20 p-6 text-center">
            <div class="text-4xl font-black text-amber mb-1">{stat.n}</div>
            <div class="text-ink font-semibold text-sm mb-1">{stat.label}</div>
            <div class="text-ink text-sm">{stat.sub}</div>
          </div>
        ))}
      </div>
      <div class="mt-10">
        <a href="#demo"
          class="group inline-flex items-center gap-3 bg-amber hover:bg-amber-dark text-black px-10 py-5 text-sm font-bold tracking-[0.25em] uppercase transition-all">
          Jetzt 90 Tage gratis starten
          <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ── FAQ ───────────────────────────────────────────────────── -->
  {premium && premium.faq.length > 0 ? (
    <section class="py-12 sm:py-16 px-5 sm:px-8 bg-paper border-t border-ink/10">
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": premium.faq.map(f => ({
          "@type": "Question",
          "name": f.q,
          "acceptedAnswer": { "@type": "Answer", "text": f.a }
        }))
      })} />
      <div class="max-w-3xl mx-auto">
        <div class="flex items-center gap-4 mb-12">
          <div class="h-px flex-1 bg-ink/20"></div>
          <span class="text-xs tracking-[0.4em] uppercase text-ink">Häufige Fragen</span>
          <div class="h-px flex-1 bg-ink/20"></div>
        </div>
        <div class="divide-y divide-ink/15 border-y border-ink/15">
          {premium.faq.map(f => (
            <details class="group py-5">
              <summary class="flex items-center justify-between gap-4 cursor-pointer list-none">
                <h3 class="text-ink font-bold text-base sm:text-lg pr-4">{f.q}</h3>
                <svg class="w-4 h-4 text-amber shrink-0 transition-transform group-open:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/>
                </svg>
              </summary>
              <p class="text-ink/70 text-base leading-relaxed mt-3 pr-8">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  ) : (
    <LandingFaq />
  )}

  <!-- ── LEAD FORM ─────────────────────────────────────────────── -->
  {nicheData.formType === 'simple' ? (
    <section id="demo" class="py-12 sm:py-16 px-5 sm:px-8 bg-paper relative overflow-hidden">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] bg-amber rounded-full blur-[180px] opacity-5"></div>
      <div class="relative max-w-xl mx-auto">
        <div class="text-center mb-10">
          <div class="inline-flex items-center gap-3 border border-amber/50 bg-amber/5 px-4 py-2 mb-8">
            <Icon name="diamond" class="w-4 h-4 text-amber shrink-0" />
            <span class="text-amber text-xs tracking-[0.3em] uppercase">
              Exklusiv für {nicheData.emoji} {inStadtteil(stadtteilData.name)}
            </span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-normal text-ink tracking-tight mb-2">Demo-Karte</h2>
          <h2 class="text-3xl sm:text-4xl font-bold text-ink tracking-tight mb-6">direkt ins Wallet.</h2>
          <p class="text-ink text-base font-normal leading-relaxed max-w-sm mx-auto">
            Trag dich ein – deine persönliche Demo-Karte liegt in Sekunden in deinem Wallet.
          </p>
        </div>
        <div class="relative border border-amber/20 bg-paper p-8 sm:p-10">
          <LeadFormDoener client:load whatsappUrl={whatsappUrl} niche={nicheData.slug} city={cityName} />
        </div>
        <p class="text-center text-ink text-sm mt-5">
          Nach 90 Tagen ab 29 €/Monat — unter 1 € pro Tag ·
          <a href="/preise/" class="text-amber hover:text-amber underline underline-offset-2 transition-colors">Alle Preise ansehen</a>
        </p>
      </div>
    </section>
  ) : (
    <section class="py-10 sm:py-12 px-5 sm:px-8 bg-paper border-t border-ink/30 md:hidden">
      <div class="max-w-xl mx-auto text-center">
        <p class="text-ink/50 text-sm mb-4">Noch nicht überzeugt?</p>
        <a href="#demo"
          class="group inline-flex items-center gap-3 border border-amber/40 hover:border-amber text-amber px-8 py-4 text-sm font-medium tracking-[0.15em] uppercase transition-all">
          {nicheData.heroCopy.ctaLabel}
          <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </section>
  )}

  <!-- ── FINAL CTA ─────────────────────────────────────────────── -->
  <section class="py-12 sm:py-16 px-5 sm:px-8 bg-paper border-t border-ink/30 relative overflow-hidden">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[300px] bg-amber rounded-full blur-[150px] opacity-5"></div>
    <div class="relative max-w-2xl mx-auto text-center">
      <p class="text-amber text-xs tracking-[0.4em] uppercase mb-6">Kein Risiko</p>
      <h2 class="text-4xl font-normal text-ink tracking-tight mb-2">90 Tage gratis.</h2>
      <h2 class="text-4xl font-bold text-ink tracking-tight mb-10">Überzeug dich selbst.</h2>
      <a href="#demo"
        class="group inline-flex items-center gap-3 bg-amber hover:bg-amber-dark text-black px-10 py-5 text-sm font-bold tracking-[0.25em] uppercase transition-all">
        {nicheData.heroCopy.ctaLabel}
        <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </section>

  <StickyMobileCta label={nicheData.heroCopy.ctaLabel} />
  <Footer />
</BaseLayout>

<style is:global>
  /* Styling für den per set:html injizierten Premium-Body (nicht Astro-scoped) */
  .seo-prose h2 {
    font-size: 1.5rem;
    line-height: 1.25;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 2rem 0 0.75rem;
  }
  .seo-prose h2:first-child { margin-top: 0; }
  .seo-prose h3 {
    font-size: 1.125rem;
    font-weight: 700;
    margin: 1.5rem 0 0.5rem;
  }
  .seo-prose p {
    font-size: 1.0625rem;
    line-height: 1.7;
    margin-bottom: 1rem;
    opacity: 0.9;
  }
  .seo-prose ul {
    margin: 0.5rem 0 1rem 1.25rem;
    list-style: disc;
  }
  .seo-prose li { margin-bottom: 0.375rem; line-height: 1.65; }
  .seo-prose strong { font-weight: 700; }
</style>
