---
interface Props {
  ctaHref?: string
  ctaLabel?: string
  dark?: boolean
}
const { ctaHref = '#demo', ctaLabel = '90 Tage gratis starten', dark = true } = Astro.props
---

<header id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500">
  <div class="max-w-6xl mx-auto px-5 sm:px-8">
    <div class="flex items-center justify-between h-16">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <!-- F-mark icon (inline SVG approximating the brand mark) -->
        <div class="w-8 h-8 flex-shrink-0">
          <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="32" height="32" fill="black" rx="2"/>
            <!-- Top horizontal bar -->
            <rect x="8" y="8" width="16" height="2.5" fill="#8B7300"/>
            <!-- Middle horizontal bar -->
            <rect x="8" y="15" width="14" height="2.5" fill="#8B7300"/>
            <!-- Vertical bar -->
            <rect x="8" y="15" width="2.5" height="9" fill="#8B7300"/>
          </svg>
        </div>
        <div class="leading-none">
          <div class="text-sm font-medium tracking-[0.15em] uppercase" class:list={[dark ? 'text-white' : 'text-black']}>
            bonuskarte<span class="text-gold-600">.digital</span>
          </div>
        </div>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-8">
        <a href="/#wie-es-funktioniert" class="text-xs font-medium tracking-widest uppercase transition-colors"
          class:list={[dark ? 'text-white/50 hover:text-white' : 'text-black/50 hover:text-black']}>
          Wie es funktioniert
        </a>
        <a href="/#branchen" class="text-xs font-medium tracking-widest uppercase transition-colors"
          class:list={[dark ? 'text-white/50 hover:text-white' : 'text-black/50 hover:text-black']}>
          Branchen
        </a>
        <a href="/preise" class="text-xs font-medium tracking-widest uppercase transition-colors"
          class:list={[dark ? 'text-white/50 hover:text-white' : 'text-black/50 hover:text-black']}>
          Preise
        </a>
        <a href="/koeln/blog" class="text-xs font-medium tracking-widest uppercase transition-colors"
          class:list={[dark ? 'text-white/50 hover:text-white' : 'text-black/50 hover:text-black']}>
          Blog
        </a>
        <a href="/hilfe" class="text-xs font-medium tracking-widest uppercase transition-colors"
          class:list={[dark ? 'text-white/50 hover:text-white' : 'text-black/50 hover:text-black']}>
          Hilfe
        </a>
        <a
          href={ctaHref}
          class="group inline-flex items-center gap-2 bg-gold-600 hover:bg-gold-500 text-black px-5 py-2.5 text-xs font-bold tracking-widest uppercase transition-all"
        >
          {ctaLabel}
          <svg class="w-3 h-3 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </nav>

      <!-- Mobile toggle -->
      <button id="mobile-toggle" class="md:hidden p-2 transition-colors"
        class:list={[dark ? 'text-white/60 hover:text-white' : 'text-black/60 hover:text-black']}
        aria-label="Menü öffnen" aria-expanded="false" aria-controls="mobile-menu">
        <svg id="icon-open" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="md:hidden hidden border-t border-white/10 py-6 flex flex-col gap-5 bg-black/95 backdrop-blur-md">
      <a href="/#wie-es-funktioniert" class="text-xs font-medium tracking-widest uppercase text-white/70 hover:text-white transition-colors">
        Wie es funktioniert
      </a>
      <a href="/#branchen" class="text-xs font-medium tracking-widest uppercase text-white/70 hover:text-white transition-colors">
        Branchen
      </a>
      <a href="/preise" class="text-xs font-medium tracking-widest uppercase text-white/70 hover:text-white transition-colors">
        Preise
      </a>
      <a href="/koeln/blog" class="text-xs font-medium tracking-widest uppercase text-white/70 hover:text-white transition-colors">
        Blog
      </a>
      <a href="/hilfe" class="text-xs font-medium tracking-widest uppercase text-white/70 hover:text-white transition-colors">
        Hilfe
      </a>
      <a href={ctaHref} class="block w-full bg-gold-600 text-black text-xs font-bold tracking-widest uppercase px-5 py-3 text-center">
        {ctaLabel}
      </a>
    </div>
  </div>
</header>

<script>
  const navbar  = document.getElementById('navbar')!
  const toggle  = document.getElementById('mobile-toggle')!
  const menu    = document.getElementById('mobile-menu')!
  const iconO   = document.getElementById('icon-open')!
  const iconC   = document.getElementById('icon-close')!

  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      navbar.classList.add('bg-black/95', 'backdrop-blur-md', 'border-b', 'border-white/5')
    } else {
      navbar.classList.remove('bg-black/95', 'backdrop-blur-md', 'border-b', 'border-white/5')
    }
  })

  toggle.addEventListener('click', () => {
    const isOpen = !menu.classList.contains('hidden')
    menu.classList.toggle('hidden')
    iconO.classList.toggle('hidden')
    iconC.classList.toggle('hidden')
    toggle.setAttribute('aria-expanded', String(!isOpen))
  })
</script>
