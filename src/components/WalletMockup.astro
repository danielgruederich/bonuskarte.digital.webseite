---
interface Props {
  businessName?: string
  reward?: string
  stamped?: number
  total?: number
}
const { businessName = 'Café Sonnenblume', reward = 'Gratis-Kaffee', stamped = 7, total = 10 } = Astro.props
---

<div class="relative w-72 mx-auto animate-float select-none">
  <!-- Outer glow -->
  <div class="absolute inset-0 bg-gold-600 rounded-none blur-[60px] opacity-10 scale-110"></div>

  <!-- Card -->
  <div class="relative bg-black border border-gold-600/30 p-7 shadow-2xl overflow-hidden">

    <!-- Corner accent lines -->
    <div class="absolute top-0 left-0 w-6 h-6 border-t border-l border-gold-600/60"></div>
    <div class="absolute top-0 right-0 w-6 h-6 border-t border-r border-gold-600/60"></div>
    <div class="absolute bottom-0 left-0 w-6 h-6 border-b border-l border-gold-600/60"></div>
    <div class="absolute bottom-0 right-0 w-6 h-6 border-b border-r border-gold-600/60"></div>

    <!-- Header -->
    <div class="flex justify-between items-start mb-7">
      <div>
        <p class="text-gold-600 text-[10px] font-light tracking-[0.3em] uppercase mb-1">Stempelkarte</p>
        <p class="text-white text-base font-semibold tracking-wide">{businessName}</p>
      </div>
      <div class="w-10 h-10 border border-gold-600/30 flex items-center justify-center text-xl">
        ☕
      </div>
    </div>

    <!-- Stamps grid -->
    <div class="grid grid-cols-5 gap-2 mb-6">
      {Array.from({ length: total }).map((_, i) => (
        <div class={`aspect-square flex items-center justify-center text-xs font-bold transition-all ${
          i < stamped
            ? 'bg-gold-600 text-black'
            : 'border border-white/10 text-white/20'
        }`}>
          {i < stamped ? '✓' : ''}
        </div>
      ))}
    </div>

    <!-- Progress -->
    <div class="border border-white/10 p-3">
      <div class="flex justify-between items-center mb-2">
        <p class="text-white/40 text-[10px] tracking-widest uppercase">Nächste Belohnung</p>
        <p class="text-gold-600 text-[10px] font-bold">{stamped}/{total}</p>
      </div>
      <div class="h-px bg-white/10 mb-2 relative overflow-hidden">
        <div class="absolute inset-y-0 left-0 bg-gold-600 transition-all" style={`width: ${(stamped / total) * 100}%`}></div>
      </div>
      <p class="text-white text-sm font-medium">{reward}</p>
    </div>

    <!-- Wallet badges -->
    <div class="flex gap-2 mt-5">
      <div class="flex-1 border border-white/10 py-2 flex items-center justify-center gap-1.5">
        <span class="text-white text-[10px] tracking-wider"> Apple Wallet</span>
      </div>
      <div class="flex-1 border border-white/10 py-2 flex items-center justify-center">
        <span class="text-white text-[10px] tracking-wider">Google Wallet</span>
      </div>
    </div>
  </div>
</div>
