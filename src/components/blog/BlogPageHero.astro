---
// Kopf einer Blog-Übersicht: Brotkrumen, Kicker, Überschrift (Slot), Einleitung.
interface Props {
  crumbs: { label: string; href?: string }[]
  kicker: string
  lead: string
}

const { crumbs, kicker, lead } = Astro.props
---

<header class="bg-paper pt-32 pb-10">
  <div class="max-w-6xl mx-auto px-5 sm:px-8">
    <nav class="flex items-center flex-wrap gap-2 text-[13px] text-ink-500 mb-7" aria-label="Breadcrumb">
      {crumbs.map((c, i) => (
        <>
          {i > 0 && <span aria-hidden="true">›</span>}
          {c.href
            ? <a href={c.href} class="underline decoration-ink-200 underline-offset-[3px] hover:text-ink hover:decoration-amber-text">{c.label}</a>
            : <span>{c.label}</span>}
        </>
      ))}
    </nav>
    <div class="text-amber-text text-xs font-bold tracking-[0.25em] uppercase">{kicker}</div>
    <h1 class="text-5xl sm:text-6xl lg:text-7xl font-black text-ink tracking-tighter leading-[0.98] mt-3.5 mb-5 max-w-[16ch]">
      <slot />
    </h1>
    <p class="text-lg sm:text-xl text-ink-500 leading-relaxed max-w-[56ch]">{lead}</p>
    <slot name="after" />
  </div>
</header>
