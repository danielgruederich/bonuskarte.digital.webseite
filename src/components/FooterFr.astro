---
import { uiFr } from '../data/fr/ui-fr'
---
<footer class="bg-ink border-t border-paper/10 text-paper">
  <div class="max-w-6xl mx-auto px-5 sm:px-8 py-14">
    <div class="grid grid-cols-1 md:grid-cols-5 gap-10 mb-12">

      <!-- Brand -->
      <div class="md:col-span-2">
        <div class="flex items-center gap-3 mb-5">
          <img src="/brand/lockup-horizontal-on-dark.svg"
            alt="bonuskarte.digital"
            class="h-7 w-auto"
            width="380" height="70" />
        </div>
        <p class="text-sm leading-relaxed max-w-xs">
          {uiFr.footer.tagline}
        </p>
        <address class="not-italic mt-5 text-sm space-y-1">
          <p>Sülzburgstrasse 234, 50937 Köln</p>
          <p><a href="tel:+491737130733" class="hover:text-amber transition-colors">+49 173 7130733</a></p>
          <p><a href="https://wa.me/491705594140" class="hover:text-amber transition-colors">WhatsApp →</a></p>
        </address>
      </div>

      <!-- Secteurs -->
      <div>
        <h3 class="text-paper text-xs font-bold tracking-widest uppercase mb-5">{uiFr.footer.secteurs}</h3>
        <ul class="space-y-3 text-sm">
          <li><a href="/fr/paris/" class="hover:text-amber transition-colors">Paris</a></li>
          <li><a href="/fr/paris/11e/boulangerie" class="hover:text-amber transition-colors">🥐 Boulangeries — 11e</a></li>
          <li><a href="/fr/paris/18e/cafe" class="hover:text-amber transition-colors">☕ Cafés — 18e</a></li>
          <li><a href="/fr/paris/1er/restaurant" class="hover:text-amber transition-colors">🍽️ Restaurants — 1er</a></li>
        </ul>
      </div>

      <!-- Légal -->
      <div>
        <h3 class="text-paper text-xs font-bold tracking-widest uppercase mb-5">{uiFr.footer.legal}</h3>
        <ul class="space-y-3 text-sm">
          <li><a href="/fr/fonctionnalites" class="hover:text-amber transition-colors">Fonctionnalités</a></li>
          <li><a href="/fr/tarifs" class="hover:text-amber transition-colors">{uiFr.footer.tarifs}</a></li>
          <li><a href="/fr/mentions-legales" class="hover:text-amber transition-colors">{uiFr.footer.mentions}</a></li>
          <li><a href="/fr/confidentialite" class="hover:text-amber transition-colors">{uiFr.footer.privacy}</a></li>
          <li><a href="/sitemap-index.xml" class="hover:text-amber transition-colors">Sitemap</a></li>
        </ul>
      </div>

    </div>

    <div class="border-t border-paper/10 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs">
      <span>© {new Date().getFullYear()} bonuskarte.digital by fuerte.digital</span>
      <div class="flex items-center gap-5">
        <span>🔒 Conforme RGPD</span>
        <a href="/" class="hover:text-amber transition-colors">🇩🇪 Version allemande</a>
      </div>
    </div>
  </div>
</footer>
