---
/**
 * E-Book Lead-Magnet Sektion — „Mehr Stammkunden, mehr Umsatz".
 * Gated Download: Name + Handynummer + Instagram → Lead in Salesflare (mode:ebook),
 * danach PDF-Download. Als wiederverwendbarer Bereich (z. B. auf der Startseite)
 * oder auf der Landingpage /leitfaden-koeln eingebunden.
 */
import EbookLeadForm from './EbookLeadForm.tsx'

interface Props {
  id?: string
}
const { id = 'leitfaden' } = Astro.props

const benefits = [
  'Stempelkarte, Cashback, Coupon, Rabatt, Geschenk, Multipass & VIP-Club im Vergleich',
  'Warum Stammkunden 5× günstiger sind als Neukunden — mit echten Zahlen',
  'Für jeden Kartentyp: Wie die Karte aussieht & was du deinen Gästen sagst',
  'Kein Marketingbudget nötig — alle Strategien für Kölner Cafés sofort umsetzbar',
]
---

<section id={id} class="relative bg-paper border-t border-ink/10 py-20 sm:py-28 overflow-hidden">
  <div class="absolute inset-0 bg-grid-ink opacity-60 pointer-events-none"></div>

  <div class="relative max-w-6xl mx-auto px-6">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">

      <!-- Left: Pitch + Cover -->
      <div>
        <p class="text-xs tracking-[0.3em] uppercase text-amber mb-4">Gratis E-Book · 13 Seiten</p>
        <h2 class="font-display text-3xl sm:text-4xl font-semibold tracking-tight text-ink leading-tight mb-5">
          Mehr Stammkunden,<br />mehr Umsatz.
        </h2>
        <p class="text-ink/70 text-base leading-relaxed max-w-md mb-8">
          Der digitale Leitfaden für Kölner Cafés: 7 Kartentypen, klare Zahlen, sofort umsetzbar —
          von der klassischen Stempelkarte bis zum VIP-Club für deine Stammgäste.
        </p>

        <ul class="space-y-3 mb-10">
          {benefits.map((b) => (
            <li class="flex items-start gap-3">
              <span class="mt-1.5 flex-none w-2 h-2 rounded-full bg-amber"></span>
              <span class="text-ink/85 text-sm leading-relaxed">{b}</span>
            </li>
          ))}
        </ul>

        <!-- Argument Carousel -->
        <div class="relative bg-ink border border-ink p-6 sm:p-7" id="ebook-carousel-wrap">
          <div class="relative overflow-hidden min-h-[160px] sm:min-h-[140px]">
            <div class="ebook-slide absolute inset-0 transition-all duration-500" data-slide="0">
              <p class="text-xs tracking-[0.25em] uppercase text-amber mb-3">Kartentypen</p>
              <p class="text-paper font-bold text-lg leading-snug mb-2">7 Karten — eine Entscheidung.</p>
              <p class="text-paper/65 text-sm leading-relaxed">Stempelkarte, Cashback, Coupon, Rabatt, Geschenk, Multipass & VIP-Club — alle erklärt, alle sofort umsetzbar.</p>
            </div>
            <div class="ebook-slide absolute inset-0 transition-all duration-500 opacity-0" data-slide="1">
              <p class="text-xs tracking-[0.25em] uppercase text-amber mb-3">Wirtschaftlichkeit</p>
              <p class="text-paper font-bold text-lg leading-snug mb-2">Stammkunden kosten 5× weniger.</p>
              <p class="text-paper/65 text-sm leading-relaxed">Als neue Gäste zu gewinnen — mit echten Zahlen aus der Gastronomie, nicht aus dem Lehrbuch.</p>
            </div>
            <div class="ebook-slide absolute inset-0 transition-all duration-500 opacity-0" data-slide="2">
              <p class="text-xs tracking-[0.25em] uppercase text-amber mb-3">Umsetzung</p>
              <p class="text-paper font-bold text-lg leading-snug mb-2">Kein Marketingbudget nötig.</p>
              <p class="text-paper/65 text-sm leading-relaxed">Alle Strategien funktionieren mit deinem Smartphone — speziell auf Kölner Cafés zugeschnitten.</p>
            </div>
          </div>
          <!-- Dots -->
          <div class="flex gap-2 mt-5">
            <button class="ebook-dot w-6 h-1 bg-amber transition-all" data-dot="0" aria-label="Folie 1"></button>
            <button class="ebook-dot w-2 h-1 bg-paper/20 transition-all" data-dot="1" aria-label="Folie 2"></button>
            <button class="ebook-dot w-2 h-1 bg-paper/20 transition-all" data-dot="2" aria-label="Folie 3"></button>
          </div>
        </div>
      </div>

      <!-- Right: Form Card -->

      <div class="bg-paper-dark/60 border border-ink/10 p-7 sm:p-9">
        <h3 class="font-display text-xl font-semibold tracking-tight text-ink mb-2">
          Jetzt kostenlos sichern
        </h3>
        <p class="text-ink/60 text-sm mb-7">
          Trag dich ein und lade den Leitfaden direkt herunter.
        </p>
        <EbookLeadForm client:visible />
      </div>

    </div>
  </div>
</section>

<script>
  (function () {
    const wrap = document.getElementById('ebook-carousel-wrap')
    if (!wrap) return
    const slides = wrap.querySelectorAll('.ebook-slide')
    const dots   = wrap.querySelectorAll('.ebook-dot')
    let current  = 0

    function goTo(idx) {
      slides[current].classList.add('opacity-0')
      dots[current].classList.remove('w-6', 'bg-amber')
      dots[current].classList.add('w-2', 'bg-paper/20')

      current = idx
      slides[current].classList.remove('opacity-0')
      dots[current].classList.remove('w-2', 'bg-paper/20')
      dots[current].classList.add('w-6', 'bg-amber')
    }

    dots.forEach(function (dot) {
      dot.addEventListener('click', function () {
        clearInterval(timer)
        goTo(Number(dot.dataset.dot))
        timer = setInterval(next, 3500)
      })
    })

    function next() { goTo((current + 1) % slides.length) }
    var timer = setInterval(next, 3500)
  })()
</script>
