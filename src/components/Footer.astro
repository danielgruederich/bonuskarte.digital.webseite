---
---
<footer class="bg-black border-t border-white/5 text-white/40">
  <div class="max-w-6xl mx-auto px-5 sm:px-8 py-14">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">

      <!-- Brand -->
      <div class="md:col-span-2">
        <div class="flex items-center gap-3 mb-5">
          <div class="w-8 h-8 flex-shrink-0">
            <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect width="32" height="32" fill="black" rx="2"/>
              <rect x="8" y="8" width="16" height="2.5" fill="#8B7300"/>
              <rect x="8" y="15" width="14" height="2.5" fill="#8B7300"/>
              <rect x="8" y="15" width="2.5" height="9" fill="#8B7300"/>
            </svg>
          </div>
          <div class="leading-none">
            <div class="text-xs font-light tracking-[0.25em] uppercase text-gold-600">FUERTE.DIGITAL</div>
            <div class="text-sm font-medium tracking-[0.15em] uppercase text-white">bonuskarte</div>
          </div>
        </div>
        <p class="text-sm leading-relaxed max-w-xs">
          Digitale Stempelkarten für Apple Wallet & Google Wallet. Kein App-Download, kein Aufwand.
        </p>
      </div>

      <!-- Branchen -->
      <div>
        <h3 class="text-white text-xs font-bold tracking-widest uppercase mb-5">Branchen</h3>
        <ul class="space-y-3 text-sm">
          <li><a href="/cafes-koeln" class="hover:text-gold-600 transition-colors">☕ Cafés in Köln</a></li>
          <li><span class="opacity-30">🍽️ Restaurants (bald)</span></li>
          <li><span class="opacity-30">🥐 Bäckereien (bald)</span></li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h3 class="text-white text-xs font-bold tracking-widest uppercase mb-5">Rechtliches</h3>
        <ul class="space-y-3 text-sm">
          <li><a href="/impressum" class="hover:text-gold-600 transition-colors">Impressum</a></li>
          <li><a href="/datenschutz" class="hover:text-gold-600 transition-colors">Datenschutz</a></li>
        </ul>
      </div>

    </div>

    <div class="border-t border-white/5 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs">
      <span>© {new Date().getFullYear()} bonuskarte.digital by FUERTE.DIGITAL – Alle Rechte vorbehalten</span>
      <div class="flex items-center gap-5">
        <span>🔒 DSGVO-konform</span>
        <span>🇩🇪 Hosting in Deutschland</span>
      </div>
    </div>
  </div>
</footer>
